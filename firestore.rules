rules_version = '2';

// ChildTime — family data separation.
//
// A child belongs to a HOUSEHOLD; a parent may access a child only if their uid
// is on that child's household. Reads use `resource` (the existing doc); writes
// that set/replace data use `request.resource`. Mixing them up (e.g. reading
// request.resource on a read) silently denies everything — which is the bug this
// version fixes.
//
// Deploy:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function householdHasMe(hid) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(hid))
        && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.parentUIDs;
    }

    // Founder analytics — AGGREGATE, non-PII numbers written by the
    // refreshAdminStats Cloud Function (admin SDK bypasses these rules).
    // Readable ONLY by founder emails; never writable from a client. The
    // tofyapp.com/admin dashboard reads these docs and nothing else.
    match /adminStats/{doc=**} {
      allow read: if signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['ranioph@gmail.com', 'amitgolans@gmail.com'];
      allow write: if false;
    }

    // Parent account — only the owner.
    match /parents/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Households.
    match /households/{hid} {
      // Members read their household; an email-invited co-parent may also read
      // it (that's how "משפחת X מחכה לך" finds the family before joining).
      allow read:   if signedIn() && (
        request.auth.uid in resource.data.parentUIDs ||
        (request.auth.token.email != null &&
         request.auth.token.email.lower() in resource.data.get('invitedParentEmails', []))
      );
      allow create: if signedIn() && request.auth.uid in request.resource.data.parentUIDs;
      // Members can update; a non-member may join by adding ONLY their own uid.
      // Members update freely; a NON-member may only JOIN by appending ONLY
      // their own uid while preserving every existing parent (arrayUnion). The
      // old `hasOnly` let anyone send parentUIDs=[me] and delete the real
      // parents — cross-family account takeover. `== concat([uid])` matches
      // exactly what arrayUnion produces for a genuine join.
      allow update: if signedIn() && (
        request.auth.uid in resource.data.parentUIDs ||
        request.resource.data.parentUIDs == resource.data.parentUIDs.concat([request.auth.uid])
      );
      allow delete: if signedIn() && request.auth.uid in resource.data.parentUIDs;

      // 🧹 House chores — shared family docs: parents create/approve, the
      // child's device (its uid is also on parentUIDs) marks them done.
      match /chores/{choreID} {
        allow read, write: if householdHasMe(hid);
      }

      // 🧹 Lifetime chore-earnings ledger per child (minutesTotal/coinsTotal).
      match /choreStats/{childID} {
        allow read, write: if householdHasMe(hid);
      }
    }

    // Children — gated on the household. Reads/updates/deletes use the EXISTING
    // doc's householdID; creates use the incoming data's householdID.
    match /children/{childID} {
      allow read:   if householdHasMe(resource.data.householdID);
      allow create: if householdHasMe(request.resource.data.householdID);
      allow update: if householdHasMe(resource.data.householdID)
                    && householdHasMe(request.resource.data.householdID);
      allow delete: if householdHasMe(resource.data.householdID);

      // state/current, dailyStats/*, events/* — gated on the parent child's household.
      match /{sub=**} {
        allow read, write: if signedIn() &&
          householdHasMe(get(/databases/$(database)/documents/children/$(childID)).data.householdID);
      }
    }

    // Tombstones for deleted children — a household member writes one on delete so
    // a re-upload from another device gets blocked server-side and never resurrects.
    match /deletedChildren/{childID} {
      allow read:   if householdHasMe(resource.data.householdID);
      allow create: if householdHasMe(request.resource.data.householdID);
      allow delete: if householdHasMe(resource.data.householdID);
    }

    // Child devices — which devices each child plays on. Gated on the household.
    match /childDevices/{id} {
      allow read:   if householdHasMe(resource.data.householdID);
      allow create: if householdHasMe(request.resource.data.householdID);
      allow update: if householdHasMe(resource.data.householdID)
                    && householdHasMe(request.resource.data.householdID);
      allow delete: if householdHasMe(resource.data.householdID);
    }

    // Test-push trigger — a parent writes their own uid to fire a self-test push.
    match /pushTests/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Parent-flagged "bad question" reports — any signed-in user may submit;
    // only admins (via console) read them. No client reads/edits.
    match /questionReports/{id} {
      allow create: if signedIn();
    }

    // Parent feedback / suggestions sent from the dashboard's floating button —
    // any signed-in parent may submit; only admins (via console) read them.
    match /parentFeedback/{id} {
      allow create: if signedIn();
    }

    // Legacy per-user progress path (older builds wrote here). Owner-only.
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Invites — readable by any signed-in user (to redeem by code), creatable by
    // the household owner, updatable to stamp redeemedBy.
    match /invites/{code} {
      // GET-by-code only — never LIST (listing exposed every household id and
      // was the first link in the takeover chain).
      allow get:    if signedIn();
      allow create: if signedIn() && request.auth.uid == request.resource.data.createdBy;
      // A redeemer may only stamp redeemedBy with their own uid; the target
      // householdID/createdBy are immutable (was fully open to tampering).
      allow update: if signedIn()
                    && request.resource.data.householdID == resource.data.householdID
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.redeemedBy == request.auth.uid;
    }

    // Child-link requests — a parent asks to absorb a child who registered with
    // their own email; the child approves on their device. Visible only to the
    // requesting parent and to the account whose email is targeted.
    match /childLinkRequests/{id} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.fromParentUID;
      allow read:   if signedIn() && (
        request.auth.uid == resource.data.fromParentUID ||
        request.auth.token.email.lower() == resource.data.toEmail
      );
      // Only the targeted child can change the status (approve / decline).
      allow update: if signedIn() && request.auth.token.email.lower() == resource.data.toEmail;
      // The requesting parent may delete their own requests (cleanup / resend).
      allow delete: if signedIn() && request.auth.uid == resource.data.fromParentUID;
    }

    // Weekly reports — readable by the child's household parents (written by
    // Cloud Functions with admin privileges, which bypass these rules).
    match /weeklyReports/{childID}/{rest=**} {
      allow read: if signedIn() &&
        householdHasMe(get(/databases/$(database)/documents/children/$(childID)).data.householdID);
    }

    // Friends leaderboard cards — a child's PUBLIC mini-card (first name, chosen
    // character, star count, friend code). Readable by any signed-in user so
    // friends (in other households) can see each other + look up by code/array;
    // writable only by the card owner's household (each device writes ONLY its
    // own card, so mutual friendship needs no cross-household writes).
    match /friendCards/{childID} {
      allow read:   if signedIn();
      // The owning device (it stamps its own uid) creates/updates its card; a
      // parent on the child's household may also update it (to remove a friend).
      allow create: if signedIn() && request.resource.data.ownerUID == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.ownerUID == request.auth.uid ||
        householdHasMe(get(/databases/$(database)/documents/children/$(childID)).data.householdID)
      );

      // Pending friend REQUESTS dropped into this card's inbox. Unlike a QR/code
      // add (instant, mutual-by-union — you already hold their code), a request is
      // for someone you found on a leaderboard: it waits until the card owner
      // accepts. The SENDER owns the request doc (doc id = their childID; stamps
      // their own uid), so they create + may cancel/read it. The card OWNER (the
      // device, or a parent on the child's household) reads to show the inbox and
      // deletes to accept / decline. Acceptance forms the edge via the normal
      // friendIDs union on the owner's own card — no cross-household write here.
      match /requests/{fromID} {
        function iOwnThisCard() {
          return get(/databases/$(database)/documents/friendCards/$(childID)).data.ownerUID == request.auth.uid
            || householdHasMe(get(/databases/$(database)/documents/children/$(childID)).data.householdID);
        }
        allow create: if signedIn()
          && request.resource.data.requesterUID == request.auth.uid
          && fromID == request.resource.data.fromID;
        // The sender may refresh their own pending request (e.g. updated star
        // count) / re-send idempotently — but can't hijack it to another sender.
        allow update: if signedIn()
          && resource.data.requesterUID == request.auth.uid
          && request.resource.data.requesterUID == request.auth.uid;
        allow read:   if signedIn() && (iOwnThisCard() || resource.data.requesterUID == request.auth.uid);
        allow delete: if signedIn() && (iOwnThisCard() || resource.data.requesterUID == request.auth.uid);
      }
    }

    // Live friends quiz games. Host-authoritative: the creator's device owns the
    // main doc (stamps hostOwnerUID) and is the ONLY writer of game state + scores.
    // Readable by any signed-in user (minimal, transient game data — like
    // friendCards). Players announce themselves in `players/{playerID}` (each
    // writes only their own doc) and submit answers in `answers/{id}` which are
    // create-once + immutable, so no one can change their answer after the fact.
    match /liveGames/{gameID} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.hostOwnerUID == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.hostOwnerUID == request.auth.uid;

      match /players/{playerID} {
        allow read:           if signedIn();
        allow create, update: if signedIn() && request.resource.data.ownerUID == request.auth.uid;
        allow delete:         if signedIn() && resource.data.ownerUID == request.auth.uid;
      }
      match /answers/{answerID} {
        allow read:   if signedIn();
        allow create: if signedIn() && request.resource.data.ownerUID == request.auth.uid;
        allow update, delete: if false;   // answers are final — you can't change yours
      }
      // Direct "come join" nudges the host sends to a specific friend; a Cloud
      // Function turns each into a push. Created only by the sender (the host).
      match /nudges/{nudgeID} {
        allow read:   if signedIn();
        allow create: if signedIn() && request.resource.data.ownerUID == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Parent quick-help requests — the child (a household member) creates one
    // targeting a parent; that parent answers from their notification. Gated on
    // the household; only the targeted parent may write the answer.
    match /helpRequests/{id} {
      allow create: if householdHasMe(request.resource.data.householdID);
      allow read:   if householdHasMe(resource.data.householdID);
      allow update: if signedIn() && request.auth.uid == resource.data.parentUID;
    }

    // Sibling time transfers — one child buys play-minutes from a sibling for 💎,
    // parent-approved. Any household member may create (buyer), read (all sides),
    // and update (parent approve/reject, seller settle, buyer credit/refund flags).
    // Conservation + once-only application are enforced client-side via transaction
    // flags; nothing here touches another child's wallet directly.
    match /timeTransfers/{id} {
      allow create: if householdHasMe(request.resource.data.householdID);
      allow read:   if householdHasMe(resource.data.householdID);
      allow update: if householdHasMe(resource.data.householdID)
                    && householdHasMe(request.resource.data.householdID);
      allow delete: if householdHasMe(resource.data.householdID);
    }

    // Early-access signups from the marketing site (tofyapp.com). Anyone may
    // CREATE one (no account needed), with light validation to curb junk; the
    // collection is never readable from a client — view leads in the console.
    match /waitlist/{id} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.email.size() < 200
                    && request.resource.data.size() <= 6;
      allow read, update, delete: if false;
    }
  }
}
