#!/bin/zsh
# 📊 Keep the dashboard's question coverage in step with the banks.
# When a commit touches a question bank, re-export the coverage file and add it
# to the same commit. A failed export warns but never blocks the commit.
ROOT=$(git rev-parse --show-toplevel)
if git diff --cached --name-only | grep -qE '^ChildTime/(Models/(QuestionBanks|QuestionDifficultyTags|ReadingContent|Topic|QuestionPack)|DesignSystem/Colors)'; then
  if "$ROOT/tools/coverage/export.sh" >/dev/null 2>&1; then
    git add "$ROOT/docs/admin/question-coverage.json"
    echo "📊 question-coverage.json refreshed"
  else
    echo "⚠️  coverage export failed — run tools/coverage/export.sh to see why" >&2
  fi
fi
# 🔄 Stamp the admin page so open dashboards notice a newer version and reload.
if git diff --cached --name-only | grep -q '^docs/admin/app.html$'; then
  STAMP=$(date +%Y%m%d%H%M%S)
  # Only the declaration line (starts the line, ends with ";") — never the code that reads it.
  sed -i '' "s/^const PAGE_STAMP = \"[0-9]*\";$/const PAGE_STAMP = \"$STAMP\";/" "$ROOT/docs/admin/app.html"
  git add "$ROOT/docs/admin/app.html"
fi
exit 0
