    "חצי שעה" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نصف ساعة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "30 minutes"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полчаса"
          }
        }
      }
    },
    "חצי שעה, שעה, שעתיים, בלי הגבלה — או כל מספר דקות שתקלידו" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نصف ساعة، ساعة، ساعتان، بلا حدّ — أو أي عدد دقائق تكتبونه"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Half an hour, an hour, two hours, no limit — or any number of minutes you type"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полчаса, час, два часа, без ограничения — или любое число минут, которое вы введёте"
          }
        }
      }
    },
    "חשבון הורה" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حساب وليّ الأمر"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parent account"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Родительский аккаунт"
          }
        }
      }
    },
    "חשוב: סמנו את טופי, ואת מה שחייב לעבוד תמיד — טלפון, הודעות, מצלמה ושעון. בלי טופי ברשימה הילד לא יוכל להרוויח זמן, ולכן עד שתבחרו הנעילה נשארת כמו שהייתה." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مهم: علّموا توفي، وكل ما يجب أن يعمل دائمًا — الهاتف والرسائل والكاميرا والساعة. بدون توفي في القائمة لن يستطيع طفلكم كسب وقت، ولذلك يبقى الإقفال كما كان حتى تختاروا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Important: tick Tofy, and whatever must always work — phone, messages, camera and clock. Without Tofy on the list your child could not earn time, so until you choose, the lock stays exactly as it was."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Важно: отметьте Tofy и всё, что должно работать всегда, — телефон, сообщения, камеру и часы. Без Tofy в списке ребёнок не сможет заработать время, поэтому до вашего выбора блокировка остаётся прежней."
          }
        }
      }
    },
