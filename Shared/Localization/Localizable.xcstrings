    "שאלו את %@ מה %@ היום ב%@ — סקרנות מחזקת זיכרון.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask %@ what %@ today in %@ — curiosity strengthens memory."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спросите %@, что %@ сегодня по теме %@ — любопытство укрепляет память."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسألوا %@ ماذا %@ اليوم في %@ — الفضول يقوّي الذاكرة."
          }
        }
      }
    },
    "שאלו את %@ שאלת \"למה\" על משהו בטבע.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
