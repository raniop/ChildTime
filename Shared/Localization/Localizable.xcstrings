    "רק אתה תדע אותו — הילד לא יוכל לפתוח הגדרות בלעדיו": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only you will know it — your child can't open settings without it"
          }
        },
