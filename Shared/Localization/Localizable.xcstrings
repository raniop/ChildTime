    "מְכוֹנִיּוֹת, רַכָּבוֹת, מְטוֹסִים, וְאֵיךְ זֶה עוֹבֵד": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cars, trains, planes, and how they work"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Машины, поезда, самолёты и как это работает"
          }
        }
      }
    },
    "מְכוֹנִיּוֹת, רַכָּבוֹת, מְטוֹסִים, וְאֵיךְ זֶה עוֹבֵד — בְּשָׁלוֹשׁ רָמוֹת שֶׁמִּתְאִימוֹת אֶת עַצְמָן לַיֶּלֶד, וְעַל כָּל תְּשׁוּבָה נְכוֹנָה מַרְוִיחִים דַּקּוֹת מִשְׂחָק, בְּדִיּוּק כְּמוֹ בְּכָל עוֹלָם.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cars, trains, planes, and how they work — in three levels that adapt to your child, and every correct answer earns play minutes, just like in every world."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Машины, поезда, самолёты и как это работает — на трёх уровнях, которые подстраиваются под ребёнка, и за каждый правильный ответ начисляются игровые минуты, как и в любом мире."
          }
        }
      }
    },
    "מְמֻצָּע": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Averages"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Средние значения"
          }
        }
      }
    },
    "מְנַסֶּה, טוֹעֶה וּמְתַקֵּן — כְּדַאי לְעוֹדֵד לְהַמְשִׁיךְ גַּם כְּשֶׁקָּשֶׁה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tries, makes mistakes, and fixes them — worth encouraging to keep going even when it's hard."
