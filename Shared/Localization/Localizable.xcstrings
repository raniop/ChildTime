        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "А вот и маленький подарок для вас"
          }
        }
      }
    },
    "וְיֵשׁ לְךָ %lld דַּקּוֹת מַתָּנָה 💝 שֶׁאֶפְשָׁר לִפְתּוֹחַ גַּם עַכְשָׁיו!" : {
