    "ספרו ל%@ סיפור קצר על משהו שקרה פעם." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احكوا لـ%@ قصّة قصيرة عن شيء حدث قديمًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell %@ a short story about something that happened long ago."
