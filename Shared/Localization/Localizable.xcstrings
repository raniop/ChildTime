    "אַף סִפְרָה בַּקּוֹד אֵינָהּ רִאשׁוֹנִית" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد رقم أولي في الرمز"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No digit in the code is a prime number"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ни одна цифра кода не является простым числом"
          }
        }
      }
    },
    "אַף פַּעַם לֹא נְעוּלוֹת — גַּם אִם הַקָּטֵגוֹרְיָה שֶׁלָּהֶן חֲסוּמָה. שִׁמּוּשִׁי כְּדֵי לְאַפְשֵׁר אַפְּלִיקַצְיָה חֲדָשָׁה לִצְמִיתוּת." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُقفل أبدًا — حتى لو كانت فئتها محجوبة. مفيد للسماح بتطبيق جديد بشكل دائم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never locked — even if their category is blocked. Useful for permanently allowing a new app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Никогда не блокируются — даже если их категория заблокирована. Удобно, чтобы навсегда разрешить новое приложение."
          }
        }
      }
    },
    "אַפְּלִיקַצְיָה אַחַת אוֹ כַּמָּה, לִזְמַן קָצוּב. בְּסוֹפוֹ הֵן נִנְעָלוֹת לְבַד." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيق واحد أو بضعة تطبيقات لوقت محدد. تُقفَل من تلقاء نفسها عند انتهائه."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One app or a few, for a set time. They lock again on their own when it ends."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одно или несколько приложений на заданное время. Потом они блокируются сами."
          }
        }
      }
    },
    "אַפְּלִיקַצְיָה חֲדָשָׁה" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيق جديد"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
