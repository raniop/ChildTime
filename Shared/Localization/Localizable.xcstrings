    "וְאָז מוֹחֲקִים אֶת טוֹפִי מִמָּסַךְ הַבַּיִת כָּרָגִיל" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثم احذفوا Tofy من الشاشة الرئيسية كالمعتاد"
          }
        },
        "en" : {
          "stringUnit" : {
