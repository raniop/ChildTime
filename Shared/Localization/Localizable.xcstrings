    "בְּדוֹק מָה חוֹזֵר אוֹ מִשְׁתַּנֶּה כָּל פַּעַם, וְהַמְשֵׁךְ אֶת הַסֵּדֶר." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقّق ممّا يتكرّر أو يتغيّر في كلّ مرّة، وأكمل التسلسل."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check what repeats or changes each time, and continue the pattern."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посмотри, что повторяется или меняется каждый раз, и продолжи последовательность."
          }
        }
      }
    },
    "בִּדְקוּ אֶת חִבּוּר הָאִינְטֶרְנֶט וְנַסּוּ שׁוּב." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقّقوا من اتّصال الإنترنت وحاولوا مرّة أخرى."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check your internet connection and try again."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте интернет-соединение и попробуйте снова."
          }
        }
      }
    },
    "בִּדְקוּ שֶׁיֵּשׁ אִינְטֶרְנֶט, וְשֶׁהַמַּכְשִׁיר עֲדַיִן מְקֻשָּׁר לַמִּשְׁפָּחָה בְּלוּחַ הַהוֹרִים." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقّقوا من وجود إنترنت، ومن أنّ الجهاز ما زال مرتبطًا بالعائلة في لوحة الوالدين."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
