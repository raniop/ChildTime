    },
    "בלי קוד, אפשר לכבות את טופי בהגדרות של האייפון — ואז הכל נפתח. לוקח דקה:" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون رمز يمكن إيقاف Tofy من إعدادات الآيفون — فيُفتح كل شيء. يستغرق دقيقة:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without a passcode, Tofy can be switched off in the iPhone's Settings — and everything opens. It takes a minute:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без кода Tofy можно отключить в настройках iPhone — и всё откроется. Это займёт минуту:"
          }
        }
      }
    },
    "במכשיר" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على الجهاز"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "on the device"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "на устройстве"
          }
        }
      }
    },
    "במכשיר של ההורה שכבר רשום:" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على جهاز الوالد المسجَّل بالفعل:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the device of the parent who's already signed up:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На устройстве родителя, который уже зарегистрирован:"
          }
        }
      }
    },
    "במסך ההורים יש עכשיו מדף \"שאלונים חדשים\": עולם שלם של שאלות בנושא שהילד אוהב. למנויי טופי+ הוא נפתח אוטומטית לכל הילדים; בלי מנוי בוחרים לאיזה ילד לשלוח, וברגע הבא הוא מקבל מתנה במסך הבית שלו. ילד שרוצה שאלון לוחץ \"בקש מאבא או אמא\" — בלי מחירים במכשיר של הילד" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في شاشة الوالدين يوجد الآن رفّ \"اختبارات جديدة\": عالم كامل من الأسئلة في موضوع يحبّه الطفل. لمشتركي Tofy+ يُفتح تلقائيًا لجميع الأطفال؛ وبدون اشتراك تختارون لأيّ طفل ترسلونه، وفي اللحظة التالية يصله هديةً في شاشته الرئيسية. الطفل الذي يريد اختبارًا يضغط \"اطلب من بابا أو ماما\" — بلا أسعار على جهاز الطفل"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The parent screen now has a “New quizzes” shelf: a whole world of questions on a topic your child loves. Tofy+ subscribers get it unlocked automatically for all kids; without a subscription, you choose which child to send it to, and they get a gift on their home screen right away. A child who wants a quiz taps “Ask Mom or Dad” — no prices on the child's device"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На родительском экране теперь есть полка «Новые викторины»: целый мир вопросов на тему, которую ребёнок любит. Подписчикам Tofy+ она открывается автоматически для всех детей; без подписки вы выбираете, какому ребёнку её отправить, и он сразу получает подарок на своём домашнем экране. Ребёнок, который хочет викторину, нажимает «Попроси маму или папу» — без цен на детском устройстве"
          }
        }
      }
    },
    "במסך הפתיחה הקישו “כבר יש לכם משפחה? הצטרפו”" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في شاشة الترحيب اضغطوا “هل لديكم عائلة بالفعل؟ انضمّوا”"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the welcome screen, tap “Already have a family? Join”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На стартовом экране нажмите «Уже есть семья? Присоединиться»"
          }
        }
      }
    },
    "במסכים של ילדה, טופי פונה אליה בלשון נקבה — בפרסים, ברמזים ובמשחקים" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بالعبرية، يخاطب Tofy البنت الآن بصيغة المؤنث في كل شاشاتها — في الجوائز والتلميحات والألعاب"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Hebrew, Tofy now addresses a girl in the feminine on all her screens — rewards, hints and games"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На иврите Tofy теперь обращается к девочке в женском роде на всех её экранах — в наградах, подсказках и играх"
          }
        }
      }
    },
    "במשחק הכספת כל תשובה נכונה מסובבת גלגל, ובשלושה גלגלים הכספת נפתחת" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في لعبة الخزنة كل إجابة صحيحة تدير قرصًا، وثلاثة أقراص تفتح الخزنة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the safe game every right answer turns a dial, and three dials open the safe"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В игре «Сейф» каждый правильный ответ поворачивает диск, а три диска открывают сейф"
          }
        }
      }
    },
    "בן/בת כמה?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كم العمر؟"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How old?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько лет?"
          }
        }
      }
    },
    "בנו מילה" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابنوا كلمة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build a word"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Собери слово"
          }
        }
      }
    },
    "בנסיעה, ספרו יחד גלגלים וכלי רכב ושאלו את %@ מי נוהג במה." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في أثناء السفر، عُدّوا معًا العجلات والمركبات واسألوا %@ من يقود ماذا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On a drive, count wheels and vehicles together and ask %@ who drives what."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В поездке посчитайте вместе колёса и машины и спросите %@, кто чем управляет."
          }
        }
      }
    },
    "בסדר" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حسنًا"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OK"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хорошо"
          }
        }
      }
    },
    "בסוף כל סיבוב רואים כוכבים, יהלומים וכמה זמן מסך הרווחתם — וגם סיבוב פחות מוצלח נגמר בפרס" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل جولة تنتهي بنجوم وألماسات ووقت الشاشة الذي ربحتموه — وحتى الجولة الأقل نجاحًا تنتهي بمكافأة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every round ends with stars, diamonds and the screen time you earned — even a round that did not go well ends with a reward"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый раунд заканчивается звёздами, алмазами и заработанным экранным временем — даже не самый удачный раунд приносит награду"
          }
        }
      }
    },
    "בעברית הרמה עולה חזק עם הגיל. באנגלית, שהיא שפה שנייה, היא נשארת נגישה" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في اللغة الأم يرتفع المستوى بقوة مع العمر. وفي الإنجليزية، وهي لغة ثانية، يبقى في المتناول"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the mother tongue the level climbs steeply with age. In English, a second language, it stays within reach"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В родном языке уровень заметно растёт с возрастом. В английском — втором языке — он остаётся посильным"
          }
        }
      }
    },
    "בעיות מלוליות" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مسائل كلامية"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Word problems"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текстовые задачи"
          }
        }
      }
    },
    "בעמוד הילד יש מתג חדש שמכבה את המשחקים, והילד נכנס ישר לשאלות" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتاح جديد في صفحة الطفل يوقف الألعاب، فينتقل طفلك مباشرة إلى الأسئلة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new switch on the child's page turns the games off, so your child goes straight to the questions."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новый переключатель на странице ребёнка отключает игры, и ребёнок сразу переходит к вопросам."
          }
        }
      }
    },
    "בפעם הראשונה, נקודה על כל כפתור במסך הבית — אצלכם ואצל הילד. אפשר להציג שוב מההגדרות" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في المرة الأولى، إشارة على كل زر في الشاشة الرئيسية — عندكم وعند الطفل. يمكن عرضها مجددًا من الإعدادات"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first time, a pointer on every button of the home screen — yours and your child's. You can show it again from Settings"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В первый раз — подсказка на каждой кнопке главного экрана, у вас и у ребёнка. Показать снова можно в настройках"
          }
        }
      }
    },
    "בקרו בגן חיות או צאו לטבע, ותנו ל%@ לזהות חיות ולספר מה הן אוכלות." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زوروا حديقة حيوانات أو اخرجوا إلى الطبيعة، ودعوا %@ يتعرّف على الحيوانات ويخبركم بما تأكله."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visit a zoo or go out in nature — and let %@ spot animals and tell you what they eat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сходите в зоопарк или на природу — и дайте %@ узнавать животных и рассказывать, что они едят."
          }
        }
      }
    },
    "בקרו במוזיאון טבע או צפו בסרטון על דינוזאורים, ותנו ל%@ לספר לכם על אחד." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زوروا متحف طبيعة أو شاهدوا مقطعًا عن الديناصورات، ودعوا %@ يحدّثكم عن واحد منها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visit a natural history museum or watch a video about dinosaurs, and let %@ tell you about one."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сходите в музей природы или посмотрите видео о динозаврах — и дайте %@ рассказать вам об одном из них."
          }
        }
      }
    },
