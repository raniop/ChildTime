      }
    },
    "הַשָּׂפָה מְשַׁנָּה גַּם אֶת הַשְּׁאֵלוֹת, לֹא רַק אֶת הַטֶּקְסְטִים. אִם תְּשַׁנּוּ אוֹתָהּ בַּמַּכְשִׁיר שֶׁל הַיֶּלֶד עַצְמוֹ — הַבְּחִירָה הָאַחֲרוֹנָה קוֹבַעַת." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اللغة تغيّر الأسئلة أيضًا، لا النصوص فقط. إذا غيّرتموها على جهاز الطفل نفسه، فالاختيار الأخير هو الذي يُعتمد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The language changes the questions too, not just the text. If you change it on your child's device itself, the latest choice wins."
