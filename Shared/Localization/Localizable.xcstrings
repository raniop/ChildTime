            "value": "دقائقي 🔒"
          }
        }
      }
    },
    "הַהִתְקַדְּמוּת שֶׁלְּךָ שְׁמוּרָה בֶּעָנָן — שׁוּם דָּבָר לֹא אָבַד.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your progress is saved in the cloud — nothing was lost."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой прогресс сохранён в облаке — ничего не потерялось."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدّمك محفوظ في السحابة — لم يضع أيّ شيء."
          }
        }
      }
    },
    "הַהֶקֵּף": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "circumference"
          }
        },
        "ru": {
