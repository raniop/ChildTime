        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرف الرمز؟ اكتبه! وإن لم تعرف — افتح تلميحًا آخر"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Know the code? Type it in! If not — open another clue"
