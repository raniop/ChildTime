    "בַּחֲרוּ מָה נִשְׁאָר פָּתוּחַ" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختاروا ما يبقى مفتوحًا"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose what stays open"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, что остаётся открытым"
          }
        }
      }
    },
    "בַּחֲרוּ מָה נִשְׁאָר פָּתוּחַ וְסַמְּנוּ גַּם אֶת טוֹפִי. כָּל הַשְּׁאָר יִנָּעֵל — גַּם אַפְּלִיקַצְיָה שֶׁתֻּתְקַן מָחָר." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختاروا ما يبقى مفتوحًا، وحدّدوا Tofy أيضًا. كل ما عدا ذلك سيُقفَل — حتى تطبيق يُثبَّت غدًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose what stays open, and tick Tofy too. Everything else gets locked — even an app installed tomorrow."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, что остаётся открытым, и отметьте также Tofy. Всё остальное будет заблокировано — даже приложение, установленное завтра."
          }
        }
      }
    },
    "בַּחֲרוּ נוֹשֵׂא וְהַמִּשְׂחָק מַתְחִיל!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختاروا موضوعًا ولتبدأ اللعبة!"
