            "value" : "Спросите его"
          }
        }
      }
    },
    "שאלו את %@ מה %@ היום ב%@ — סקרנות מחזקת זיכרון." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسألوا %@ ماذا %@ اليوم في %@ — الفضول يقوّي الذاكرة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask %@ what %@ today in %@ — curiosity strengthens memory."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спросите %@, что %@ сегодня по теме %@ — любопытство укрепляет память."
          }
        }
      }
    },
    "שאלו את %@ שאלת \"למה\" על משהו בטבע." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسألوا %@ سؤال «لماذا» عن شيء في الطبيعة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask %@ a “why” question about something in nature."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задайте %@ вопрос «почему» о чём-то в природе."
          }
        }
      }
    },
