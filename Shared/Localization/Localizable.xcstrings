          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح إعدادات الوالدين"
          }
        }
      }
    },
    "פתרו חידה או משחק חשיבה אחד ביחד היום.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solve a riddle or a brain game together today."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Решите сегодня вместе одну загадку или игру на мышление."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حلّوا اليوم لغزًا أو لعبة تفكير واحدة معًا."
          }
        }
      }
    },
