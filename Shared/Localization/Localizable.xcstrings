    "הַכֹּל נָעוּל" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل شيء مقفل"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything is locked"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё закрыто"
          }
        }
      }
    },
    "הַכֹּל נָעוּל עַד שֶׁמַּרְוִיחִים זְמַן — גַּם אַפְּלִיקַצְיָה שֶׁתֻּתְקַן מָחָר. טוֹפִי תָּמִיד פָּתוּחַ. רוֹצִים שֶׁעוֹד מַשֶּׁהוּ יִשָּׁאֵר פָּתוּחַ? בַּחֲרוּ אוֹתוֹ כָּאן." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل شيء مقفل حتى يُكسَب الوقت — حتى تطبيق يُثبَّت غدًا. Tofy مفتوح دائمًا. تريدون أن يبقى شيء آخر مفتوحًا؟ اختاروه هنا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything is locked until time is earned — even an app installed tomorrow. Tofy always stays open. Want something else to stay open? Choose it here."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё заблокировано, пока не заработано время, — даже приложение, установленное завтра. Tofy всегда открыт. Хотите, чтобы ещё что-то оставалось открытым? Выберите здесь."
          }
        }
      }
    },
