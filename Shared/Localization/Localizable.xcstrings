            "state": "translated",
            "value": "Add chore"
          }
        }
      }
    },
    "הזזת השעון במכשיר לא מוסיפה דקות, לא פותחת מחדש פרסים יומיים ולא משאירה אפליקציות פתוחות": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving the device clock doesn't add minutes, reopen daily rewards, or leave apps unlocked"
          }
        }
      }
    },
    "החודש": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This month"
          }
        }
      }
    },
    "החזירו": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore"
          }
        }
      }
    },
    "החשבון במכשיר לא מאפשר את זה. ודאו שמחוברים עם Apple ID של הורה (לא של ילד).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account on this device doesn't allow this. Make sure you're signed in with a parent's Apple ID (not a child's)."
