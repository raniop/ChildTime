    "צְרוּ מִשְׁפָּחָה חֲדָשָׁה וְהַתְחִילוּ לְהַגְדִּיר" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئوا عائلة جديدة وابدأوا بالإعداد"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a new family and start setting up"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте новую семью и начните настройку"
          }
        }
      }
    },
    "צְרוּ פְּרוֹפִיל לְכָל יֶלֶד/ה כָּאן. אַחַר כָּךְ כָּל יֶלֶד יְקַבֵּל קוֹד QR — סוֹרְקִים אוֹתוֹ בַּמַּכְשִׁיר שֶׁל הַיֶּלֶד, וְהוּא נִכְנָס יְשִׁירוֹת לְשַׂחֵק." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئوا هنا ملفًا شخصيًا لكل طفل. بعد ذلك سيحصل كل طفل على رمز QR — امسحوه على جهاز الطفل، وسيدخل مباشرة إلى اللعب."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a profile for each child here. Then each child gets a QR code — scan it on the child's device, and they jump right in to play."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте здесь профиль для каждого ребёнка. Потом каждый ребёнок получит QR-код — отсканируйте его на устройстве ребёнка, и он сразу зайдёт играть."
          }
        }
      }
    },
    "צְרוּ פְּרוֹפִיל רִאשׁוֹן כְּדֵי לְהַתְחִיל" : {
