    "יהלומים (חנות)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diamonds (shop)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Алмазы (магазин)"
          }
        }
      }
    },
    "יהלומים = הארנק של החנות. מרוויחים לאט יותר מכוכבים (בערך 1 לתשובה), ומוציאים אותם על דמויות ופריטים בחנות. יורדים כשקונים — זה תקין.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diamonds = the shop wallet. They're earned more slowly than stars (about 1 per answer) and spent on characters and items in the shop. They go down when buying — that's normal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Алмазы — это кошелёк магазина. Они копятся медленнее звёзд (примерно 1 за ответ) и тратятся на персонажей и вещи в магазине. При покупке их становится меньше — это нормально."
          }
        }
      }
    },
