    },
    "וְהִנֵּה מַתָּנָה קְטַנָּה בִּשְׁבִילְכֶם" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وهذه هديّة صغيرة لكم"
