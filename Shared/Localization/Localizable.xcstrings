        }
      }
    },
    "עָרִים, סְמָלִים, חַגִּים, דְּמֻיּוֹת וְטֶבַע — בְּשָׁלוֹשׁ רָמוֹת שֶׁמִּתְאִימוֹת אֶת עַצְמָן לַיֶּלֶד, וְעַל כָּל תְּשׁוּבָה נְכוֹנָה מַרְוִיחִים דַּקּוֹת מִשְׂחָק, בְּדִיּוּק כְּמוֹ בְּכָל עוֹלָם.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cities, symbols, holidays, famous people, and nature — in three levels that adapt to your child, and every correct answer earns play minutes, just like in every world."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Города, символы, праздники, личности и природа — на трёх уровнях, которые подстраиваются под ребёнка, и за каждый правильный ответ дают игровые минуты, как и в любом мире."
          }
        }
      }
    },
