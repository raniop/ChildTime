        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعلّم بالتجربة والخطأ"
          }
        }
      }
    },
    "לוֹמֵד מִכַּמָּה כִּוּוּנִים — נַמְשִׁיךְ לִלְמֹד אֵיךְ הוּא לוֹמֵד הֲכִי טוֹב.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learns in several ways — we'll keep learning how they learn best."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учится по-разному — мы продолжим узнавать, как ему учится лучше всего."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعلّم من عدّة اتجاهات — سنواصل التعرّف على الطريقة التي يتعلّم بها على أفضل نحو."
          }
        }
      }
    },
