    "כּוֹכְבֵי לֶכֶת, יָרֵחַ, אַסְטְרוֹנָאוּטִים וְשֶׁמֶשׁ" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الكواكب والقمر ورُوّاد الفضاء والشمس"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planets, the Moon, astronauts, and the Sun"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Планеты, Луна, астронавты и Солнце"
          }
        }
      }
    },
    "כּוֹכְבֵי לֶכֶת, יָרֵחַ, אַסְטְרוֹנָאוּטִים וְשֶׁמֶשׁ — בְּשָׁלוֹשׁ רָמוֹת שֶׁמִּתְאִימוֹת אֶת עַצְמָן לַיֶּלֶד, וְעַל כָּל תְּשׁוּבָה נְכוֹנָה מַרְוִיחִים דַּקּוֹת מִשְׂחָק, בְּדִיּוּק כְּמוֹ בְּכָל עוֹלָם." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الكواكب والقمر ورُوّاد الفضاء والشمس — بثلاثة مستويات تتكيّف مع الطفل، وكل إجابة صحيحة تكسب دقائق لعب، تمامًا كما في كل عالم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planets, the Moon, astronauts, and the Sun — in three levels that adapt to your child, and every correct answer earns play minutes, just like in every world."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Планеты, Луна, астронавты и Солнце — на трёх уровнях, которые сами подстраиваются под ребёнка, и за каждый правильный ответ начисляются минуты игры, как и в любом мире."
          }
        }
      }
    },
    "כּוֹכָבִים" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نجوم"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stars"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звёзды"
          }
        }
      }
    },
    "כוכבים (דירוג)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النجوم (الترتيب)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stars (rank)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звёзды (рейтинг)"
          }
        }
      }
    },
    "כוכבים = הדירוג. הם רק עולים ולעולם לא נגמרים — הם מה שקובע את הרמה של הילד/ה ואת המקום בלוח החברים. אי אפשר לבזבז אותם." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النجوم = الترتيب. ترتفع دائمًا ولا تنفد أبدًا — وهي التي تحدّد مستوى الطفل/ة ومكانه في لوحة الأصدقاء. ولا يمكن إنفاقها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stars = rank. They only go up and never run out — they set your child's level and place on the friends board. They can't be spent."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звёзды = рейтинг. Они только растут и никогда не заканчиваются — именно они определяют уровень ребёнка и место в списке друзей. Потратить их нельзя."
          }
        }
      }
    },
    "כולל כל עולם חדש שנוסיף" : {
