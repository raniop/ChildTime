            "value": "هذا الشهر"
          }
        }
      }
    },
    "החזירו": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore"
          }
        },
        "ru": {
          "stringUnit": {
