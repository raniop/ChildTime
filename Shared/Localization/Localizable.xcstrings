          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد اتصال بالإنترنت في جهازك"
          }
        }
      }
    },
    "אין חיבור לאינטרנט — בדקו את הרשת ונסו שוב": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet connection — check your network and try again"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет подключения к интернету — проверьте сеть и попробуйте снова"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد اتصال بالإنترنت — تحقّقوا من الشبكة وحاولوا مرّة أخرى"
          }
        }
      }
    },
    "אין חיבור לאינטרנט. התחברו ונסו שוב.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet connection. Connect and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет подключения к интернету. Подключитесь и попробуйте снова."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد اتصال بالإنترنت. اتصلوا وحاولوا مرّة أخرى."
          }
        }
      }
    },
    "אין כרגע": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None right now"
