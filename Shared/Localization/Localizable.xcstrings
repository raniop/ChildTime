    },
    "תשובה נכונה בטאבלט כבר לא משמיעה צליל בטלפון של אותו ילד, והזמזום מהרמקולים נעלם" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإجابة الصحيحة على الجهاز اللوحي لم تعد تُصدر صوتاً على هاتف الطفل نفسه، واختفى الطنين من السماعات"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A right answer on the tablet no longer plays a sound on the same child's phone, and the hum from the speakers is gone"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правильный ответ на планшете больше не звучит на телефоне того же ребёнка, а гул из динамиков исчез"
          }
        }
      }
    },
    "תשובה נכונה במשחק" : {
