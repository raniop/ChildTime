    "נִכְנָס לַכִּיס 💝 שֶׁל הַיֶּלֶד — %@ %@ מָתַי שֶׁ%@, מִכָּל מַכְשִׁיר. אֶפְשָׁר לָתֵת עוֹד עַד %lld דַּקּוֹת הַיּוֹם (עַד חֲצוֹת)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدخل إلى جيب 💝 الطفل — %@ %@ متى ما %@، من أيّ جهاز. يمكن منح ما يصل إلى %lld دقيقة إضافيّة اليوم (حتّى منتصف الليل)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
