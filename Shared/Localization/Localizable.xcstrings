    "האישור בוטל. נסו שוב ואשרו בחלון של אפל." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُلغي التأكيد. حاولوا مرة أخرى وأكّدوا في نافذة Apple."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approval was canceled. Try again and approve in Apple's window."
          }
