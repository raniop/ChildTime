        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сменить родительский код"
          }
        }
      }
    },
    "שָׁנָה שֶׁל סַקְרָנוּת, בִּטָּחוֹן וְהָמוֹן רְגָעִים טוֹבִים —\nטוֹפִי כְּבָר מְחַכֶּה לָהֶם עִם שְׁאֵלוֹת חֲדָשׁוֹת 💛" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سنة من الفضول والثقة والكثير من اللحظات الجميلة —\nTofy ينتظرها بالفعل بأسئلة جديدة 💛"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A year of curiosity, confidence, and lots of great moments —\nTofy is already waiting with new questions 💛"
          }
        },
        "ru" : {
