    "אוֹדוֹת וּפְרָטִיּוּת": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About & privacy"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О приложении и приватность"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حول التطبيق والخصوصية"
          }
        }
      }
    },
    "אוֹסְפִים כּוֹכָב עַל כָּל תְּשׁוּבָה נְכוֹנָה. הַכּוֹכָבִים אַף פַּעַם לֹא יוֹרְדִים — הֵם הַנִּקּוּד שֶׁלָּכֶם בְּטַבְלַת הַחֲבֵרִים!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You get a star for every correct answer. Stars never go down — they're your score on the friends leaderboard!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты получаешь звезду за каждый правильный ответ. Звёзды никогда не убавляются — это твои очки в таблице друзей!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجمعون نجمة عن كل إجابة صحيحة. والنجوم لا تنقص أبدًا — إنها نتيجتكم في جدول الأصدقاء!"
          }
        }
      }
    },
    "אוֹפְּס... אֵין קְטָעִים חֲדָשִׁים כָּרֶגַע": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oops… no new passages right now"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упс... новых текстов сейчас нет"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوبس... لا مقاطع جديدة الآن"
          }
        }
      }
    },
    "אוֹפְּס... אֵין שְׁאֵלוֹת לַנּוֹשֵׂא הַזֶּה עֲדַיִן": {
      "localizations": {
        "en": {
