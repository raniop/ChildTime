          "stringUnit": {
            "state": "translated",
            "value": "اسألوا %@ سؤال «لماذا» عن شيء في الطبيعة."
          }
        }
      }
    },
    "שאלונים חדשים לילדים — עולם הכדורגל ראשון": {
