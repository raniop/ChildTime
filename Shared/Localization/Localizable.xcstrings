          "stringUnit": {
            "state": "translated",
            "value": "Choose which apps stay locked until your child answers questions\n(YouTube, TikTok, games…)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, какие приложения останутся заблокированными, пока ребёнок не ответит на вопросы\n(YouTube, TikTok, игры…)"
          }
