          }
        }
      }
    },
    "כל משפחה מקבלת את טופי+ במתנה ל-30 יום, מהרגע שהיא נפתחת — בלי כרטיס אשראי" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل عائلة تحصل على Tofy+ هدية لمدة 30 يومًا منذ لحظة إنشائها — دون بطاقة ائتمان"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every family gets Tofy+ as a gift for 30 days from the moment it is created — no credit card"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
