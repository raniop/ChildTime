    "הַיּוֹם כָּל תְּשׁוּבָה נְכוֹנָה בְּ%@ שָׁוָה יַהֲלוֹמִים כְּפוּלִים! 💎×2" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اليوم كل إجابة صحيحة في %@ تساوي ضعف الألماسات! 💎×2"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today every correct answer in %@ is worth double diamonds! 💎×2"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня каждый правильный ответ в теме %@ даёт вдвое больше алмазов! 💎×2"
