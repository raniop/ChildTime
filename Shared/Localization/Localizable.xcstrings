    "%@ — וְעַל כָּל תְּשׁוּבָה נְכוֹנָה מַרְוִיחִים דַּקּוֹת מִשְׂחָק ⏱" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — ومع كل إجابة صحيحة تربحون دقائق لعب ⏱"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — and every correct answer earns play minutes ⏱"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — и за каждый правильный ответ начисляются минуты игры ⏱"
          }
        }
      }
    },
    "%@ — לְפִי תָּכְנִית הַלִּמּוּדִים שֶׁל הַכִּתָּה שֶׁל הַיֶּלֶד, בְּשָׁלוֹשׁ רָמוֹת שֶׁמִּתְאִימוֹת אֶת עַצְמָן. עַל כָּל תְּשׁוּבָה נְכוֹנָה מַרְוִיחִים דַּקּוֹת מִשְׂחָק." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — وفق المنهاج الدراسي لصف الطفل، بثلاثة مستويات تتكيّف من تلقاء نفسها. ومع كل إجابة صحيحة تربحون دقائق لعب."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — based on your child's grade curriculum, in three levels that adapt. Every correct answer earns play minutes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — по учебной программе класса ребёнка, на трёх уровнях, которые подстраиваются. За каждый правильный ответ начисляются минуты игры."
          }
        }
      }
