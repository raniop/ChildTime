          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصلت"
          }
        }
      }
    },
    "הדמות כבר שלך": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already own this character"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот персонаж уже твой"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الشخصية لك بالفعل"
          }
        }
      }
    },
    "הדמות שלך בגדול, עם דקות, יהלומים וכוכבים.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your character up close, with minutes, diamonds and stars."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой персонаж крупным планом, с минутами, алмазами и звёздами."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شخصيتك بحجم كبير، مع الدقائق والألماسات والنجوم."
          }
        }
      }
    },
    "ההזמנה ממתינה לאישור (Ask to Buy)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your order is waiting for approval (Ask to Buy)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заказ ждёт подтверждения (Ask to Buy)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الطلب بانتظار الموافقة (Ask to Buy)"
          }
        }
      }
    },
    "ההקראה אומרת קודם את המספר": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-aloud says the number first"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Озвучка сначала называет число"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القراءة الصوتية تقول الرقم أولًا"
          }
        }
      }
    },
    "ההתקדמות מסונכרנת בצורה מאובטחת, והקוד ההורי נשמר מוצפן במכשיר.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress syncs securely, and the parent code is stored encrypted on the device."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогресс синхронизируется безопасно, а родительский код хранится на устройстве в зашифрованном виде."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم مزامنة التقدّم بشكل آمن، ويُحفظ رمز الوالد مشفّرًا على الجهاز."
          }
        }
      }
    },
    "ההתקדמות של כל ילד נשארת שלו": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each child's progress stays their own"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогресс каждого ребёнка остаётся его собственным"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدّم كل طفل يبقى خاصًا به"
          }
        }
      }
    },
    "הוֹסִיפוּ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضيفوا"
          }
        }
      }
    },
    "הוֹסִיפוּ אֶת הֶחָבֵר הָרִאשׁוֹן וְתִרְאוּ מִי אָסַף הֲכִי הַרְבֵּה כּוֹכָבִים!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your first friend and see who collected the most stars!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавь первого друга и посмотри, кто собрал больше всего звёзд!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضيفوا الصديق الأول وانظروا من جمع أكبر عدد من النجوم!"
          }
        }
      }
    },
    "הוֹסִיפוּ הוֹרֶה לַמִּשְׁפָּחָה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a parent to the family"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте родителя в семью"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضيفوا والدًا إلى العائلة"
          }
        }
      }
    },
    "הוֹסִיפוּ חָבֵר": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
