    "רק אם תפעילו, ורק ההורים רואים" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط إذا فعّلتموه، ولا يراه إلا الوالدان"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only if you turn it on, and only parents see it"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только если вы включите, и видят только родители"
          }
        }
      }
    },
    "רק אתה תדע אותו — הילד לא יוכל לפתוח הגדרות בלעדיו" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت وحدك ستعرفه — لن يستطيع الطفل فتح الإعدادات بدونه"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only you will know it — your child can't open settings without it"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только вы будете его знать — без него ребёнок не сможет открыть настройки"
          }
        }
      }
    },
    "רק האפליקציות שתבחרו ייחסמו. כל השאר נשארות פתוחות." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُحجب فقط التطبيقات التي تختارونها. وكلّ الباقي يبقى مفتوحًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the apps you choose are blocked. Everything else stays open."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будут заблокированы только выбранные вами приложения. Все остальные останутся открытыми."
          }
        }
      }
    },
    "רק הורה" : {
