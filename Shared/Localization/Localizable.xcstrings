    "כָּל הָעוֹלָמוֹת פְּתוּחִים %@ עַד %@. בְּלִי כַּרְטִיס, לֹא מִתְחַדֵּשׁ. בֵּינְתַיִם תִּרְאוּ מָה %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All worlds are open %@ until %@. No card, no auto-renewal. Meanwhile, see what %@."
