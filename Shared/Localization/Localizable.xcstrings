    "הצלחה היום": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Success today"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Успех сегодня"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النجاح اليوم"
          }
        }
      }
    },
    "הצלילים באפליקציה רכים ומשמשים כפידבק על תשובות נכונות / שגויות. ניתן לכבות אותם לגמרי.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In-app sounds are soft and give feedback on correct / incorrect answers. You can turn them off completely."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звуки в приложении мягкие и служат откликом на верные / неверные ответы. Их можно полностью выключить."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصوات التطبيق ناعمة وتعطي تغذية راجعة على الإجابات الصحيحة / الخاطئة. ويمكن إيقافها تمامًا."
          }
        }
      }
    },
    "הקדישו 10 דקות למשחק משותף — זו דרך נהדרת לראות איך %@ %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend 10 minutes playing together — it's a great way to see how %@ %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уделите 10 минут совместной игре — это отличный способ увидеть, как %@ %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خصّصوا 10 دقائق للعب معًا — إنها طريقة رائعة لرؤية كيف %@ %@."
          }
        }
      }
    },
    "הקדישו 10 דקות לקריאת מילים באנגלית יחד.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend 10 minutes reading English words together."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уделите 10 минут чтению английских слов вместе."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خصّصوا 10 دقائق لقراءة كلمات بالإنجليزية معًا."
          }
        }
      }
    },
    "הקוד חייב להיות בדיוק 4 ספרות": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code must be exactly 4 digits"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код должен состоять ровно из 4 цифр"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يتكوّن الرمز من 4 أرقام بالضبط"
          }
        }
      }
    },
    "הקוד נשמר מוצפן (hash) במכשיר ולא בטקסט גלוי.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code is stored encrypted (hashed) on the device, never in plain text."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код хранится на устройстве в зашифрованном виде (хеш), а не открытым текстом."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ الرمز مشفّرًا (hash) على الجهاز، لا كنصّ ظاهر."
          }
        }
      }
    },
    "הקוד פג תוקף": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code has expired"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия кода истёк"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية الرمز"
          }
        }
      }
    },
    "הקוד שהילד הגדיר לפתיחת זמן משחק יימחק. הילד יוכל להגדיר קוד חדש מהמכשיר שלו. שימושי כשהקוד נשכח.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code your child set for unlocking play time will be deleted. Your child can set a new code from their device. Useful when the code is forgotten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код, который ребёнок задал для открытия игрового времени, будет удалён. Ребёнок сможет задать новый код со своего устройства. Удобно, когда код забыт."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف الرمز الذي حدّده الطفل لفتح وقت اللعب. وسيتمكّن الطفل من تحديد رمز جديد من جهازه. مفيد عند نسيان الرمز."
          }
        }
      }
    },
    "הקודים לא תואמים": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codes don't match"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
