        }
      }
    },
    "הַהַזְמָנָה נִשְׁלְחָה לְאִשּׁוּר. הִיא תִּכָּנֵס לְתֹקֶף בָּרֶגַע שֶׁתְּאֻשַּׁר." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُرسل الطلب للموافقة. وسيسري مفعوله فور الموافقة عليه."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your purchase was sent for approval. It'll take effect as soon as it's approved."
