    "כְּבָר בָּרָמָה הַגְּבוֹהָה 💪": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already at the top level 💪"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже на высоком уровне 💪"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت في المستوى الأعلى بالفعل 💪"
          }
        }
      }
    },
    "כְּבָר יֵשׁ לְךָ אֶת הַפְּרִיט הַזֶּה — קַבֵּל 15 יַהֲלוֹמִים בִּמְקוֹם 💎": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already have this item — get 15 diamonds instead 💎"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У тебя уже есть эта вещь — получи вместо неё 15 алмазов 💎"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الغرض لديك بالفعل — احصل على 15 ألماسة بدلًا منه 💎"
          }
        }
      }
    },
    "כְּבָר יֵשׁ ✓": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Has it ✓"
          }
        },
        "ru": {
