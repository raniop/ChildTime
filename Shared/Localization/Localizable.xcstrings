    },
    "ארבע רשימות הפכו לכפתור אחד: מה נשאר פתוח. ולידו פתיחה זמנית של אפליקציה לזמן קצוב" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أربع قوائم صارت زرًا واحدًا: ما يبقى مفتوحًا. وبجانبه فتح تطبيق لوقت محدد"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Four lists became one button: what stays open. Next to it, opening an app for a set time"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Четыре списка стали одной кнопкой: что остаётся открытым. Рядом — открыть приложение на время"
          }
        }
      }
    },
