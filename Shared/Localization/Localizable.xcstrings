            "value" : "Ты сохранил серию! 🔥"
          }
        }
      }
    },
    "שָׁנָה חֲדָשָׁה, הַרְפַּתְקָה חֲדָשָׁה — טוֹפִי כְּבָר הֵכִין\nשְׁאֵלוֹת חֲדָשׁוֹת בְּדִיּוּק %@! 🚀" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سنة جديدة، مغامرة جديدة — Tofy جهّز من قبلُ\nأسئلة جديدة بالضبط %@! 🚀"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New year, new adventure — Tofy already made\nnew questions just %@! 🚀"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новый год, новое приключение — Tofy уже приготовил\nновые вопросы как раз %@! 🚀"
          }
        }
      }
    },
    "שָׁנָה חֲדָשָׁה!" : {
      "localizations" : {
        "ar" : {
