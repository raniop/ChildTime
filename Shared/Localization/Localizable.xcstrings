    "בהגדרות של האייפד בוחרים \"זה המכשיר של הילד\" ומזינים את קוד המשפחה 🙂" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في إعدادات الـ iPad اختاروا «هذا جهاز الطفل» وأدخلوا رمز العائلة 🙂"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
