    },
    "הוּא חוֹזֵר": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "he goes back to"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "он возвращается к"
          }
        }
      }
    },
    "הוּא עָנָה בְּ%@ עַל %lld שְׁאֵלוֹת, בְּ%lld%% הַצְלָחָה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "He answered %2$lld questions in %1$@, with %3$lld%% correct."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По %@ он ответил на %lld вопросов, %lld%% верных."
          }
        }
      }
    },
    "הוא יפתח": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "he'll open"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "он откроет"
          }
        }
      }
    },
    "הוא למד": {
      "localizations": {
