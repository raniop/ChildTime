          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أجهزة متصلة"
          }
        }
      }
    },
    "אֵין מַצְלֵמָה בַּמַּכְשִׁיר הַזֶּה.\nהַקְלִידוּ אֶת הַקּוֹד בִּמְקוֹם זֹאת.": {
      "localizations": {
        "en": {
          "stringUnit": {
