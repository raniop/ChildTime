          }
        }
      }
    },
    "בַּקְּשׁוּ מֵאַבָּא אוֹ אִמָּא לְהוֹסִיף מַטְלוֹת —\nוְתוּכְלוּ לְהַרְוִיחַ דַּקּוֹת מִשְׂחָק אוֹ כֶּסֶף! 💪" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلبوا من بابا أو ماما إضافة مهامّ —\nوستكسبون دقائق لعب أو نقودًا! 💪"
          }
        },
        "en" : {
          "stringUnit" : {
