    "אין בקשות ממתינות · ניהול מטלות ופרסים": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No pending requests · manage chores and rewards"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет ожидающих запросов · управление делами и наградами"
          }
        }
      }
    },
    "אין חיבור אינטרנט במכשיר שלך": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your device has no internet connection"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На вашем устройстве нет подключения к интернету"
          }
        }
      }
    },
    "אין חיבור לאינטרנט — בדקו את הרשת ונסו שוב": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet connection — check your network and try again"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет подключения к интернету — проверьте сеть и попробуйте снова"
          }
        }
      }
    },
    "אין חיבור לאינטרנט. התחברו ונסו שוב.": {
      "localizations": {
        "en": {
          "stringUnit": {
