          }
        }
      }
    },
    "מתנה שנתתם — נפתחת" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الهدية التي أرسلتموها — تُفتح"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gift you sent — opens"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подарок, который вы отправили, открывается"
          }
        }
      }
    },
    "מתנה, נעילה ומטלות בלחיצה אחת למעלה, הדוח מתחת, כל המכשירים במקום אחד, וכל ההגדרות של הילד ברשימה אחת — במקום כפתור שפתח עוד כרטיס ותפריט ארוך" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الهدية والقفل والمهام بلمسة واحدة في الأعلى، والتقرير تحتها، وكل الأجهزة في مكان واحد، وكل إعدادات الطفل في قائمة واحدة — بدلًا من زر يفتح بطاقة أخرى وقائمة طويلة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gift, lock and chores one tap away at the top, the report below, all devices in one place, and all of the kid's settings in one list — instead of a button that opened another card and a long menu"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подарок, блокировка и дела — в одно нажатие сверху, отчёт ниже, все устройства в одном месте и все настройки ребёнка одним списком — вместо кнопки, открывавшей ещё одну карточку, и длинного меню"
          }
        }
      }
    },
