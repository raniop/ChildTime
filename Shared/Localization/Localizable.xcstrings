    "ניסיון 7 ימים חינם במסלול השנתי. ניתן לבטל בכל עת בהגדרות Apple ID.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "7-day free trial on the yearly plan. Cancel anytime in your Apple ID settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "7 дней бесплатно на годовом тарифе. Отменить можно в любой момент в настройках Apple ID."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجربة مجّانيّة لمدّة 7 أيّام في الخطّة السنويّة. يمكن الإلغاء في أيّ وقت من إعدادات Apple ID."
          }
        }
      }
    },
