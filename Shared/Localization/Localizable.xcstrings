    "בְּמַכְשִׁיר הַהוֹרֶה מוֹפִיעַ קוֹד QR לַיֶּלֶד.\nסִרְקוּ אוֹתוֹ כָּאן וְהַמַּכְשִׁיר יִתְחַבֵּר.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The parent device shows a QR code for the child.\nScan it here and this device will connect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На устройстве родителя появляется QR-код для ребёнка.\nОтсканируйте его здесь — и устройство подключится."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على جهاز الوالد يظهر رمز QR للطفل.\nامسحوه هنا وسيتّصل هذا الجهاز."
          }
        }
      }
    },
    "בְּמַכְשִׁיר יֶלֶד הַמְּחִיקָה חֲסוּמָה. לִמְחִיקָה אֲמִתִּית — פִּתְחוּ חַלּוֹן קָצָר וְהָסִירוּ אֶת טוֹפִי מִמָּסַךְ הַבַּיִת.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting is blocked on a child's device. To really delete Tofy, open a short window and remove it from the Home Screen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На детском устройстве удаление заблокировано. Чтобы удалить по-настоящему — откройте короткое окно и уберите Tofy с домашнего экрана."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحذف محظور على جهاز الطفل. للحذف الفعليّ — افتحوا نافذة قصيرة وأزيلوا Tofy من الشاشة الرئيسية."
          }
        }
      }
    },
    "בְּמַכְשִׁיר יֶלֶד הַמְּחִיקָה חֲסוּמָה. פִּתְחוּ חַלּוֹן קָצָר כְּדֵי לְהָסִיר אֶת טוֹפִי מִמָּסַךְ הַבַּיִת.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting is blocked on a child's device. Open a short window to remove Tofy from the Home Screen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На детском устройстве удаление заблокировано. Откройте короткое окно, чтобы убрать Tofy с домашнего экрана."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحذف محظور على جهاز الطفل. افتحوا نافذة قصيرة لإزالة Tofy من الشاشة الرئيسية."
          }
        }
      }
    },
    "בְּמָה מְשַׂחֲקִים? 🎮": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What should we play? 🎮"
          }
        },
        "ru": {
