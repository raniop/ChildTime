    "הוֹסָפַת חָבֵר": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add friend"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавление друга"
          }
        }
      }
    },
    "הוֹסָפָה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить"
          }
        }
      }
    },
    "הוֹרִידוּ קֹדֶם אֶת הַתְּשׁוּבוֹת שֶׁבֶּטַח לֹא נְכוֹנוֹת — וּבַחֲרוּ מִמַּה שֶּׁנִּשְׁאַר.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First cross out the answers that are surely wrong — then pick from what's left."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала убери ответы, которые точно неверные, — и выбери из того, что осталось."
          }
        }
      }
    },
    "הוֹרֶה": {
      "localizations": {
