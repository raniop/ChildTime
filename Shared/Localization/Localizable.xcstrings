    "הַקּוֹד שֶׁסָּרַקְתֶּם לֹא נִמְצָא אוֹ פָּג תּוֹקֶף. בַּקְּשׁוּ קוֹד חָדָשׁ וְנַסּוּ שׁוּב.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code you scanned wasn't found or has expired. Ask for a new code and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код, который вы отсканировали, не найден или устарел. Попросите новый код и попробуйте снова."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرمز الذي مسحتموه غير موجود أو انتهت صلاحيته. اطلبوا رمزًا جديدًا وحاولوا مرّة أخرى."
          }
        }
      }
    },
    "הַקּוֹדִים לֹא הָיוּ אוֹתוֹ דָּבָר — בּוֹאוּ נְנַסֶּה שׁוּב 🙂": {
