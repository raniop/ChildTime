    "שָׁנָה חֲדָשָׁה!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New year!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый год!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنة جديدة!"
          }
        }
      }
    },
    "שָׁנָה חֲדָשָׁה, הַרְפַּתְקָה חֲדָשָׁה — טוֹפִי כְּבָר הֵכִין\nשְׁאֵלוֹת חֲדָשׁוֹת בְּדִיּוּק %@! 🚀": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New year, new adventure — Tofy already made\nnew questions just %@! 🚀"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый год, новое приключение — Tofy уже приготовил\nновые вопросы как раз %@! 🚀"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنة جديدة، مغامرة جديدة — Tofy جهّز من قبلُ\nأسئلة جديدة بالضبط %@! 🚀"
          }
        }
      }
    },
    "שָׁנָה שֶׁל סַקְרָנוּת, בִּטָּחוֹן וְהָמוֹן רְגָעִים טוֹבִים —\nטוֹפִי כְּבָר מְחַכֶּה לָהֶם עִם שְׁאֵלוֹת חֲדָשׁוֹת 💛": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A year of curiosity, confidence, and lots of great moments —\nTofy is already waiting with new questions 💛"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Год любопытства, уверенности и множества хороших моментов —\nTofy уже ждёт их с новыми вопросами 💛"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنة من الفضول والثقة والكثير من اللحظات الجميلة —\nTofy ينتظرها بالفعل بأسئلة جديدة 💛"
          }
        }
      }
    },
