    "אִם אַבָּא וְאִמָּא בָּחֲרוּ, בַּשָּׁעוֹת הָאֵלֶּה טוֹפִי נָח — וְהַדַּקּוֹת שֶׁלְּךָ מְחַכּוֹת לְךָ אַחַר כָּךְ" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا اختارها أبي وأمي، يرتاح Tofy في هذه الساعات — ودقائقك تنتظرك لاحقًا"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If Mom and Dad chose them, Tofy rests during these hours — and your minutes wait for you until later"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если мама и папа выбрали эти часы, Tofy в это время отдыхает — а твои минуты ждут тебя потом"
          }
        }
      }
    },
    "אִם אַבָּא וְאִמָּא בָּחֲרוּ, בַּשָּׁעוֹת הָאֵלֶּה טוֹפִי נָח — וְהַדַּקּוֹת שֶׁלָּךְ מְחַכּוֹת לָךְ אַחַר כָּךְ" : {
