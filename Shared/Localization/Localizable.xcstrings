    "הַהוֹרֶה הַשֵּׁנִי כְּבָר הִגְדִּיר" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوالد الآخر أعدّ الأمر مسبقًا"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The other parent already set up"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Второй родитель уже всё настроил"
          }
        }
      }
    },
    "הַהוֹרֶה הַשֵּׁנִי פָּשׁוּט יִתְחַבֵּר עִם הָאִימֵיל הַזֶּה — וְהַמִּשְׁפָּחָה תְּחַכֶּה לוֹ שָׁם, בְּלִי קוֹדִים." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكفي أن يسجّل الوالد الآخر الدخول بهذا البريد — وستكون العائلة بانتظاره هناك، بلا رموز."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The other parent just signs in with this email — the family will be waiting for them there, no codes needed."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Второму родителю достаточно войти с этой почтой — семья будет ждать его там, без всяких кодов."
          }
        }
      }
    },
    "ההזמנה ממתינה לאישור (Ask to Buy)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
