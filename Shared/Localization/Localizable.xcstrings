    "🔭 %@ מגלה עניין ב%@. עודדו %@ לבחור עוד שאלות בנושא.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "🔭 %@ is discovering an interest in %@. Encourage %@ to pick more questions on it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "🔭 %@ проявляет интерес к теме %@. Предложите %@ выбрать ещё вопросы по ней."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "🔭 %@ يكتشف اهتمامًا بـ%@. شجّعوا %@ على اختيار مزيد من الأسئلة في هذا المجال."
          }
        }
      }
    },
    "🔺 מְשֻׁלָּשׁ שֶׁבָּסִיסוֹ %lld ס\"מ וְהַגֹּבַהּ אֵלָיו %lld ס\"מ. מָה הַשֶּׁטַח שֶׁלּוֹ?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "🔺 A triangle has a base of %lld cm and a height of %lld cm. What is its area?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "🔺 У треугольника основание %lld см, а высота к нему %lld см. Чему равна его площадь?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "🔺 مثلث طول قاعدته %lld سم والارتفاع إليها %lld سم. ما مساحته؟"
          }
        }
      }
    },
