    },
    "כוכבים = הדירוג. הם רק עולים ולעולם לא נגמרים — הם מה שקובע את הרמה של הילד/ה ואת המקום בלוח החברים. אי אפשר לבזבז אותם." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النجوم = الترتيب. ترتفع دائمًا ولا تنفد أبدًا — وهي التي تحدّد مستوى الطفل/ة ومكانه في لوحة الأصدقاء. ولا يمكن إنفاقها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stars = rank. They only go up and never run out — they set your child's level and place on the friends board. They can't be spent."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звёзды = рейтинг. Они только растут и никогда не заканчиваются — именно они определяют уровень ребёнка и место в списке друзей. Потратить их нельзя."
          }
        }
      }
    },
