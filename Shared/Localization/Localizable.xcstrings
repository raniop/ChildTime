          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بماذا نلعب؟ 🎮"
          }
        }
      }
    },
    "בְּמָסַךְ הַפְּתִיחָה הַקִּישׁוּ “כְּבָר יֵשׁ לָכֶם מִשְׁפָּחָה? הִצְטָרְפוּ”": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the welcome screen, tap “Already have a family? Join”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На стартовом экране нажмите «Уже есть семья? Присоединиться»"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في شاشة الترحيب اضغطوا “هل لديكم عائلة بالفعل؟ انضمّوا”"
          }
        }
      }
    },
    "בְּסֵדֶר": {
