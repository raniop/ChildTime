    "כמה זמן מסך ביום %@ יכולה להרוויח?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كم من وقت الشاشة يمكن أن تكسب %@ في اليوم؟"
          }
        },
        "en" : {
