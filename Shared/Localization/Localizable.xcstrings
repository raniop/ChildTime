    "בּוֹחֲרִים עוֹלָם, וְאָז בּוֹחֲרִים: שְׁאֵלוֹת רְגִילוֹת אוֹ מִשְׂחָק" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختاروا عالمًا، ثم اختاروا: أسئلة عادية أو لعبة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a world, then pick how: regular questions or a game"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбираем мир, а потом выбираем: обычные вопросы или игру"
          }
        }
      }
    },
    "בּוֹחֲרִים עוֹלָם, וְעוֹנִים בּוֹ עַל שְׁאֵלוֹת אוֹ מְשַׂחֲקִים. כָּל תְּשׁוּבָה נְכוֹנָה מַרְוִיחָה דַּקּוֹת." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر عالمًا، ثم أجب عن أسئلة أو العب فيه. كل إجابة صحيحة تكسب دقائق."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a world, then answer questions or play in it. Every right answer earns minutes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбери мир и отвечай на вопросы или играй. Каждый верный ответ — это минуты."
          }
        }
      }
    },
