            "value": "Сканировать код"
          }
        }
      }
    },
    "עֲדַיִן אֵין דַּקּוֹת. עֲנוּ עַל שְׁאֵלוֹת כְּדֵי לְהַרְוִיחַ דַּקּוֹת מִשְׂחָק! 🎮": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No minutes yet. Answer questions to earn play minutes! 🎮"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минут пока нет. Отвечайте на вопросы, чтобы заработать игровые минуты! 🎮"
          }
        }
      }
    },
    "עֲדַיִן אֵין חֲבֵרִים.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No friends yet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Друзей пока нет."
          }
        }
      }
    },
    "עֲדַיִן לֹא נִבְחֲרוּ אַפְּלִיקַצְיוֹת לִנְעִילָה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No apps selected to lock yet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения для блокировки ещё не выбраны."
          }
        }
      }
    },
    "עֲנֵה נָכוֹן עַל %lld שְׁאֵלוֹת הַיּוֹם וְזָכֵה בִּ-%lld 💎!\nכָּל יוֹם רָצוּף שֶׁמְּשַׂחֲקִים — הַפְּרָס גָּדֵל. 🔥": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get %lld questions right today and win %lld 💎!\nEvery day in a row you play, the prize gets bigger. 🔥"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответь правильно на %lld вопросов сегодня и получи %lld 💎!\nКаждый день подряд, когда играешь, приз растёт. 🔥"
          }
        }
      }
    },
    "עֲנָקִים! 💫 +%lld דַּקּוֹת!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amazing! 💫 +%lld minutes!"
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "one": {
