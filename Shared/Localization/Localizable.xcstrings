            "state" : "translated",
            "value" : "Добавить"
          }
        }
      }
    },
    "הוֹסִיפוּ אֶת הֶחָבֵר הָרִאשׁוֹן וְתִרְאוּ מִי אָסַף הֲכִי הַרְבֵּה כּוֹכָבִים!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضيفوا الصديق الأول وانظروا من جمع أكبر عدد من النجوم!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add your first friend and see who collected the most stars!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавь первого друга и посмотри, кто собрал больше всего звёзд!"
          }
        }
      }
    },
