    "דַּמְיֵן אֶת הַמִּגְרָשׁ: אֵיפֹה עוֹמֵד כָּל שַׂחְקָן וּמָה מֻתָּר לוֹ לַעֲשׂוֹת.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picture the field: where each player stands and what they're allowed to do."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Представь поле: где стоит каждый игрок и что ему можно делать."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخيّل الملعب: أين يقف كلّ لاعب وما المسموح له فعله."
          }
        }
      }
    },
