    },
    "שָׁלַחְנוּ בַּקָּשַׁת עֶזְרָה!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسلنا طلب مساعدة!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Help request sent!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просьба о помощи отправлена!"
          }
        }
      }
    },
    "שָׁלַחְנוּ עַכְשָׁיו הוֹדָעָה לְאַבָּא וּלְאִמָּא 💌\nהֵם רוֹאִים אֶת הַקּוֹד שֶׁלְּךָ בַּלּוּחַ שֶׁלָּהֶם,\nוְיוֹדְעִים אֵיךְ לַעֲזוֹר." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسلنا الآن رسالة إلى أبي وأمّي 💌\nهما يريان رمزك في لوحتهما،\nويعرفان كيف يساعدان."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We just sent a message to Mom and Dad 💌\nThey can see your code on their dashboard,\nand they'll know how to help."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы только что отправили сообщение маме и папе 💌\nОни видят твой код на своей панели\nи знают, как помочь."
          }
        }
      }
    },
    "שָׁלַחְנוּ עַכְשָׁיו הוֹדָעָה לְאַבָּא וּלְאִמָּא 💌\nהֵם רוֹאִים אֶת הַקּוֹד שֶׁלָּךְ בַּלּוּחַ שֶׁלָּהֶם,\nוְיוֹדְעִים אֵיךְ לַעֲזוֹר." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسلنا الآن رسالة إلى أبي وأمّي 💌\nهما يريان رمزكِ في لوحتهما،\nويعرفان كيف يساعدان."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We just sent a message to Mom and Dad 💌\nThey can see your code on their dashboard,\nand they'll know how to help."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы только что отправили сообщение маме и папе 💌\nОни видят твой код на своей панели\nи знают, как помочь."
          }
        }
      }
    },
    "שָׁלֹשׁ תְּשׁוּבוֹת נְכוֹנוֹת — וְהָאוֹצָר שֶׁלָּכֶם! 💎" : {
