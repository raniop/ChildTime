                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Огромные! 💫 +%lld минуты!"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Огромные! 💫 +%lld минут!"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Огромные! 💫 +%lld минуты!"
                }
              }
            }
          }
        }
      }
    },
    "עֲנוּ נָכוֹן וְקַבְּלוּ פִּי 3 כּוֹכָבִים!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer right to get 3× the stars!"
          }
        },
        "ru": {
