    "תשובה שגויה מעבירה הלאה" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإجابة الخاطئة تنقل للسؤال التالي"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A wrong answer moves you on"
          }
