        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيزيل أبوك أو أمّك إجابة خاطئة واحدة — وتُجيب أنت 😉"
          }
        }
      }
    },
    "אַבָּא וְאִמָּא שָׁלְחוּ לְךָ עוֹלָם חָדָשׁ! 🎉": {
      "localizations": {
