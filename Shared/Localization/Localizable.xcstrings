            "value" : "Сделаю позже"
          }
        }
      }
    },
    "אף אחד לא משחק כרגע" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا أحد يلعب الآن"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No one is playing right now"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас никто не играет"
          }
