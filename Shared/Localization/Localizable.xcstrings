    "נִגְמַר לְ%@ · לְהַמְשִׁיךְ: %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهى لدى %@ · للمتابعة: %@"
