    "תִּהְיוּ הוֹרֶה נוֹסָף בַּמִּשְׁפָּחָה וְתִרְאוּ אֶת אוֹתָם הַיְּלָדִים וְאֶת אוֹתָהּ הַהִתְקַדְּמוּת." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستكونون والدًا إضافيًا في العائلة وسترون الأطفال أنفسهم والتقدّم نفسه."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll be another parent in the family and see the same kids and the same progress."
