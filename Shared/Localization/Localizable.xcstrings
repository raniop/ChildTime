    },
    "יותר מדי ניסיונות — המתינו דקה ונסו שוב" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محاولات كثيرة جدًّا — انتظروا دقيقة وحاولوا مجدّدًا"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too many attempts — wait a minute and try again"
          }
        },
        "ru" : {
