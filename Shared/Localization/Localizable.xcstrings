        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا كاميرا في هذا الجهاز.\nاكتبوا الرمز بدلًا من ذلك."
          }
        }
      }
    },
    "אֵין עֲדַיִן פְּעִילוּת בַּתְּקוּפָה הַזּוֹ.": {
