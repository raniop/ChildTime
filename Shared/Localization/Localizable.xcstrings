          }
        }
      }
    },
    "בְּרוּכִים הַבָּאִים!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добро пожаловать!"
          }
        }
      }
    },
    "בִּדְקוּ אֶת חִבּוּר הָאִינְטֶרְנֶט וְנַסּוּ שׁוּב.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your internet connection and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте интернет-соединение и попробуйте снова."
          }
        }
      }
    },
    "בִּדְקוּ שֶׁיֵּשׁ אִינְטֶרְנֶט, וְשֶׁהַמַּכְשִׁיר עֲדַיִן מְקֻשָּׁר לַמִּשְׁפָּחָה בְּלוּחַ הַהוֹרִים.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that you're online and that the device is still linked to the family on the parent dashboard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте, что есть интернет и что устройство всё ещё привязано к семье в родительской панели."
          }
        }
      }
    },
    "בִּחֲרוּ אֵילוּ עוֹלָמוֹת פְּתוּחִים עֲבוּר %@. עוֹלָם כָּבוּי נֶעֱלָם מֵהַמָּסָךְ, וְהַיֶּלֶד לֹא מְקַבֵּל מִמֶּנּוּ שְׁאֵלוֹת. הַשִּׁנּוּי מִסְתַּנְכְרֵן אוֹטוֹמָטִית לַמַּכְשִׁיר שֶׁל הַיֶּלֶד.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which worlds are open for %@. A world that's turned off disappears from the screen, and your child won't get questions from it. Changes sync automatically to your child's device."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, какие миры открыты для %@. Выключенный мир исчезает с экрана, и ребёнок не получает из него вопросов. Изменение автоматически синхронизируется с устройством ребёнка."
          }
        }
      }
    },
    "בִּחֲרוּ כַּמָּה דַּקּוֹת מָסָךְ בְּיוֹם עֲבוּר %@. הַשִּׁנּוּי מִסְתַּנְכְרֵן אוֹטוֹמָטִית לַמַּכְשִׁיר שֶׁל הַיֶּלֶד.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how many screen minutes per day %@ gets. The change syncs automatically to your child's device."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, сколько минут экрана в день получает %@. Изменение автоматически синхронизируется с устройством ребёнка."
          }
        }
      }
    },
    "בִּחֲרוּ קוֹד בֶּן 4 סְפָרוֹת לְהָגֵן עַל הַהַגְדָּרוֹת": {
      "localizations": {
        "en": {
          "stringUnit": {
