            "state": "translated",
            "value": "Уже есть ✓"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موجود ✓"
          }
        }
      }
    },
    "כְּבָר קִבַּלְנוּ עֶזְרָה בַּשְּׁאֵלָה הַזֹּאת 💛": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We already got help on this question 💛"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы уже брали подсказку в этом вопросе 💛"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حصلنا على مساعدة في هذا السؤال من قبل 💛"
          }
        }
      }
    },
    "כְּבוּיוֹת": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключены"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مُطفأة"
          }
        }
      }
    },
    "כְּדֵי לְאַפְשֵׁר מְחִיקַת אַפְּלִיקַצְיוֹת — הַזִּינוּ קוֹד הוֹרֶה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To allow deleting apps, enter the parent code"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы разрешить удаление приложений — введите родительский код"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للسماح بحذف التطبيقات — أدخلوا رمز وليّ الأمر"
          }
        }
      }
    },
    "כְּדֵי לִנְעַל אֶת הַטֶּלֶפוֹן בְּמַצַּב יֶלֶד צָרִיךְ לְאַשֵּׁר Screen Time בִּשְׁבִיל טוֹפִי.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locking the phone in kid mode needs Screen Time permission for Tofy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы заблокировать телефон в детском режиме, нужно разрешить Tofy доступ к Screen Time."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قفل الهاتف في وضع الطفل يتطلّب السماح لـ Tofy باستخدام Screen Time."
          }
        }
      }
    },
    "כְּדֵי לִנְעוֹל אֶת הַטֶּלֶפוֹן בְּמַצַּב יֶלֶד צָרִיךְ לְאַשֵּׁר Screen Time בִּשְׁבִיל טוֹפִי.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To lock the phone in Kid Mode, allow Screen Time for Tofy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы заблокировать телефон в детском режиме, нужно разрешить Tofy доступ к Экранному времени."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقفل الهاتف في وضع الطفل، اسمحوا لـ Tofy باستخدام Screen Time."
          }
        }
      }
    },
    "כְּדֵי לִפְתּוֹחַ אֶת הַמִּנּוּי לַמִּשְׁפָּחָה — הַזִּינוּ אֶת הַקּוֹד": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To start the family subscription, enter the code"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы открыть подписку для семьи — введите код"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لبدء اشتراك العائلة — أدخلوا الرمز"
          }
        }
      }
    },
    "כְּדֵי לִקְנוֹת יַהֲלוֹמִים — בַּקְּשׁוּ מֵהוֹרֶה לְהַזִּין אֶת הַקּוֹד": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To buy diamonds, ask a parent to enter the code"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы купить алмазы — попроси родителя ввести код"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لشراء الألماس — اطلبوا من وليّ الأمر إدخال الرمز"
          }
        }
      }
    },
    "כְּדֵי לִרְכֹּשׁ אֶת הַשְּׁאֵלוֹן — הַזִּינוּ אֶת הַקּוֹד": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To buy this question pack, enter the code"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы купить набор вопросов — введите код"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لشراء حزمة الأسئلة — أدخلوا الرمز"
          }
        }
      }
    },
    "כְּדַאי לִכְלֹל אֶת טוֹפִי עַצְמָהּ, כְּדֵי שֶׁהַיֶּלֶד תָּמִיד יוּכַל לַחֲזֹר אֵלֶיהָ.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include Tofy itself, so your child can always get back to it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стоит включить и саму Tofy, чтобы ребёнок всегда мог вернуться к ней."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستحسن تضمين Tofy نفسه، كي يستطيع الطفل العودة إليه دائمًا."
          }
        }
      }
    },
    "כְּדַאי לִכְלֹל טֶלֶפוֹן, הוֹדָעוֹת וּמַצְלֵמָה — וְאֶת טוֹפִי עַצְמָהּ.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include Phone, Messages, and Camera — and Tofy itself."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стоит включить телефон, сообщения и камеру — и саму Tofy."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستحسن تضمين الهاتف والرسائل والكاميرا — و Tofy نفسه."
          }
        }
      }
    },
    "כְּלֵי נְגִינָה וְהַמִּשְׁפָּחוֹת שֶׁלָּהֶם": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instruments and their families"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Музыкальные инструменты и их семейства"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الآلات الموسيقيّة وعائلاتها"
          }
        }
      }
    },
    "כְּלֵי נְגִינָה, קֶצֶב, מַלְחִינִים וְשִׁירֵי יְלָדִים": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instruments, rhythm, composers, and children's songs"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструменты, ритм, композиторы и детские песни"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الآلات الموسيقيّة والإيقاع والملحّنون وأغاني الأطفال"
          }
        }
      }
    },
    "כְּלֵי נְגִינָה, קֶצֶב, מַלְחִינִים וְשִׁירֵי יְלָדִים — בְּשָׁלוֹשׁ רָמוֹת שֶׁמִּתְאִימוֹת אֶת עַצְמָן לַיֶּלֶד, וְעַל כָּל תְּשׁוּבָה נְכוֹנָה מַרְוִיחִים דַּקּוֹת מִשְׂחָק, בְּדִיּוּק כְּמוֹ בְּכָל עוֹלָם.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instruments, rhythm, composers, and children's songs — in three levels that adapt to your child, and every correct answer earns play minutes, just like in every world."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструменты, ритм, композиторы и детские песни — в трёх уровнях, которые подстраиваются под ребёнка, и за каждый правильный ответ начисляются игровые минуты, как и в любом мире."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الآلات الموسيقيّة والإيقاع والملحّنون وأغاني الأطفال — بثلاثة مستويات تتكيّف مع الطفل، وكل إجابة صحيحة تكسب دقائق لعب، تمامًا كما في كل عالم."
          }
        }
      }
    },
    "כְּלֵי רֶכֶב": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vehicles"
          }
        },
        "ru": {
