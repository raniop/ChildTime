        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The world is waiting on each child's home screen, marked \"New\"."
          }
        }
      }
    },
    "הָרְכִישָׁה דּוֹרֶשֶׁת אִישּׁוּר Apple ID (סִיסְמָה / Face ID). הַיַּהֲלוֹמִים מְשַׁמְּשִׁים לִקְנִיַּת דְּמוּיוֹת בְּתוֹךְ הָאַפְּלִיקַצְיָה בִּלְבַד.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchases require Apple ID approval (password / Face ID). Diamonds can only be used to buy characters inside the app."
          }
