    "נראה לאחרונה %@. המתנה תופיע ברגע שיתחבר — ואז תקבלו התראה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last seen %@. The gift will show up once the device connects — you'll get a notification then."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последний раз в сети %@. Подарок появится, как только устройство подключится — тогда вы получите уведомление."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شوهد آخر مرّة %@. ستظهر الهديّة فور اتّصال الجهاز — وعندها سيصلكم إشعار."
          }
        }
      }
    },
    "נראה לאחרונה %@. הנעילה שמורה ותחול ברגע שיתחבר — ואז תקבלו התראה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last seen %@. The lock is saved and will apply once the device connects — you'll get a notification then."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последний раз в сети %@. Блокировка сохранена и применится, как только устройство подключится — тогда вы получите уведомление."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شوهد آخر مرّة %@. القفل محفوظ وسيُطبَّق فور اتّصال الجهاز — وعندها سيصلكم إشعار."
          }
        }
      }
    },
    "נראה ש%@ מתקשה ב%@. זה תחום מצוין להתמקד בו יחד.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It looks like %@ is finding %@ tricky. It's a great area to focus on together."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, %@ пока трудно с темой «%@». Это отличная область, чтобы позаниматься вместе."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أنّ %@ يجد صعوبة في %@. إنّه مجال ممتاز للتركيز عليه معًا."
          }
        }
      }
    },
    "נשלחה בקשת בדיקה — ההתראה אמורה להגיע תוך כמה שניות": {
      "localizations": {
