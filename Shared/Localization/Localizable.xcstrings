        }
      }
    },
    "הָעוֹלָם מְחַכֶּה בַּמָּסָךְ הָרָאשִׁי שֶׁל כָּל יֶלֶד, עִם סִימוּן \"חָדָשׁ\".": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The world is waiting on each child's home screen, marked \"New\"."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мир ждёт на главном экране каждого ребёнка, с пометкой «Новое»."
          }
        }
      }
    },
    "הָרְכִישָׁה דּוֹרֶשֶׁת אִישּׁוּר Apple ID (סִיסְמָה / Face ID). הַיַּהֲלוֹמִים מְשַׁמְּשִׁים לִקְנִיַּת דְּמוּיוֹת בְּתוֹךְ הָאַפְּלִיקַצְיָה בִּלְבַד.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchases require Apple ID approval (password / Face ID). Diamonds can only be used to buy characters inside the app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка требует подтверждения Apple ID (пароль / Face ID). Алмазы используются только для покупки персонажей внутри приложения."
          }
        }
      }
    },
    "הָרְכִישָׁה לֹא הֻשְׁלְמָה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase not completed"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка не завершена"
          }
        }
      }
    },
    "הָרְצִיפוּת שָׁוָה יוֹתֵר מֵהַכַּמּוּת — גַּם 10 דַּקּוֹת בְּיוֹם שׁוֹמְרוֹת עָלֶיהָ.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistency matters more than volume — even 10 minutes a day keeps it going."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регулярность важнее количества — даже 10 минут в день её сохраняют."
          }
        }
      }
    },
    "הָרִבּוּעַ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the square"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "квадрат"
          }
        }
      }
    },
    "הֻזְמַנְתֶּם לְהִצְטָרֵף כְּהוֹרֶה — תִּרְאוּ אֶת הַיְלָדִים, הַהִתְקַדְּמוּת וְהַשְּׁלִיטָה, בְּדִיּוּק כְּמוֹ הַהוֹרֶה שֶׁהִזְמִין אֶתְכֶם.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've been invited to join as a parent — see the kids, their progress, and the controls, just like the parent who invited you."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вас пригласили присоединиться как родителя — вы увидите детей, их прогресс и управление, точно как родитель, который вас пригласил."
          }
        }
      }
    },
    "האייפד לא ייפתח עד שהאייפון באמת ננעל — ורק אז הדקות שנשארו עוברות אליו. בלי כפילויות ובלי דקות שנעלמות": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPad won't unlock until the iPhone is actually locked — only then do the remaining minutes move over. No duplicates and no disappearing minutes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad не откроется, пока iPhone действительно не заблокируется — и только тогда оставшиеся минуты перейдут к нему. Без дублей и без исчезающих минут"
          }
        }
      }
    },
    "האימייל או הסיסמה לא נכונים — נסו שוב, או הקישו \"שכחתי סיסמה\"": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorrect email or password — try again, or tap \"Forgot password\""
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверный адрес почты или пароль — попробуйте снова или нажмите «Забыли пароль»"
          }
        }
      }
    },
    "האישור בוטל. נסו שוב ואשרו בחלון של אפל.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approval was canceled. Try again and approve in Apple's window."
