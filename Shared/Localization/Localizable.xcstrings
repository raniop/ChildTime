    },
    "אֵין כָּרֶגַע מַכְשִׁיר מְחֻבָּר לְ%@ — הַחַלּוֹן יִפָּתַח בָּרֶגַע שֶׁהַמַּכְשִׁיר יִתְחַבֵּר." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
