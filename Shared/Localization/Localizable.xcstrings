          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locked there! ✅ You can play here 🎉"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Там заблокировано! ✅ Можно играть здесь 🎉"
          }
        }
      }
    },
    "נָעוּל שָׁם! ✅ הַדַּקּוֹת חָזְרוּ — אֶפְשָׁר לִפְתּוֹחַ כָּאן 🎉" : {
