          }
        }
      }
    },
    "קְרָא שׁוּב לְאַט, וּבְדֹק אֵיזֶה חֹק מַתְאִים לְכָל הָאֵיבָרִים בַּסִּדְרָה.": {
      "localizations": {
        "en": {
