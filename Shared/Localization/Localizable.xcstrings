    "אַפְּלִיקַצְיָה מְסוּיֶּמֶת פְּתוּחָה" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيق محدّد مفتوح"
          }
