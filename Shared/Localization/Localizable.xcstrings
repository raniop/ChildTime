            "value" : "Подписка"
          }
        }
      }
    },
    "מנוי אחד לכל המשפחה — נפתח מכאן, בטלפון שלכם" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشتراك واحد لكلّ العائلة — يُفعَّل من هنا، من هاتفكم"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One subscription for the whole family — unlocks from here, on your phone"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одна подписка на всю семью — открывается отсюда, с вашего телефона"
          }
        }
      }
    },
    "מְנַסֶּה, טוֹעֶה וּמְתַקֵּן — כְּדַאי לְעוֹדֵד לְהַמְשִׁיךְ גַּם כְּשֶׁקָּשֶׁה." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحاول ويخطئ ويصحّح — يستحقّ التشجيع على المواصلة حتى عندما يصعب الأمر."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tries, makes mistakes, and fixes them — worth encouraging to keep going even when it's hard."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пробует, ошибается и исправляет — стоит подбадривать продолжать, даже когда трудно."
          }
        }
      }
    },
    "מְסַדְּרִים חֶדֶר" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترتيب الغرفة"
          }
        },
        "en" : {
          "stringUnit" : {
