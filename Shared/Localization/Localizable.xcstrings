          "stringUnit" : {
            "state" : "translated",
            "value" : "أسماك القرش والحيتان والشِّعاب ومَن يعيش أين — بثلاثة مستويات تتكيّف مع الطفل، وكل إجابة صحيحة تكسب دقائق لعب، تمامًا كما في كل عالم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharks, whales, reefs and who lives where — at three levels that adapt themselves to your child, and every right answer earns play minutes, exactly like every other world."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Акулы, киты, рифы и кто где живёт — три уровня, которые подстраиваются под ребёнка, и за каждый верный ответ начисляются игровые минуты, как и в любом другом мире."
          }
        }
      }
    },
    "כְּרִישִׁים, לִוְיְתָנִים, שׁוּנִיּוֹת, וּמִי חַי אֵיפֹה — בְּשָׁלוֹשׁ רָמוֹת שֶׁמִּתְאִימוֹת אֶת עַצְמָן לַיֶּלֶד, וְעַל כָּל תְּשׁוּבָה נְכוֹנָה מַרְוִיחִים דַּקּוֹת מִשְׂחָק, בְּדִיּוּק כְּמוֹ בְּכָל עוֹלָם." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أسماك القرش، والحيتان، والشِّعاب، ومَن يعيش أين — بثلاثة مستويات تتكيّف مع الطفل، وكل إجابة صحيحة تكسب دقائق لعب، تمامًا كما في كل عالم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharks, whales, reefs, and who lives where — in three levels that adapt to your child, and every correct answer earns play minutes, just like in every world."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Акулы, киты, рифы и кто где живёт — в трёх уровнях, которые подстраиваются под ребёнка, и за каждый правильный ответ начисляются игровые минуты, как и в любом мире."
          }
        }
      }
    },
    "כְּשֶׁהַטֵּלֵפוֹן זָז, הַהוֹרִים שֶׁלְּךָ יוֹדְעִים שֶׁהִגַּעְתָּ בְּשָׁלוֹם — לְבֵית הַסֵּפֶר, הַבַּיְתָה אוֹ לַחוּג." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يتحرك الهاتف، يعرف أهلك أنك وصلت بأمان — إلى المدرسة أو البيت أو النادي."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the phone moves, your parents know you got there safely — to school, home or your club."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда телефон перемещается, родители знают, что ты благополучно добрался — до школы, домой или на кружок."
          }
        }
      }
    },
    "כְּשֶׁהַטֵּלֵפוֹן זָז, הַהוֹרִים שֶׁלָּךְ יוֹדְעִים שֶׁהִגַּעַתְּ בְּשָׁלוֹם — לְבֵית הַסֵּפֶר, הַבַּיְתָה אוֹ לַחוּג." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
