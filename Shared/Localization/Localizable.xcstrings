    "הנעילה עוד לא פועלת — פתחו שוב את ההגדרות והפעילו את טופי." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القفل لا يعمل بعد — افتحوا الإعدادات مرة أخرى وشغّلوا Tofy."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lock isn't on yet — open the settings again and turn on Tofy."
          }
        },
        "ru" : {
          "stringUnit" : {
