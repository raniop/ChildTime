            "value" : "the umbrella"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "зонтик"
          }
        }
      }
    },
    "הַמִּסְפָּר הַזֶּה לֹא יוֹרֵד כְּשֶׁמְּשַׂחֲקִים — הוּא סוֹפֵר כַּמָּה הִרְוַחְתֶּם הַיּוֹם. כַּמָּה נִשְׁאַר לְשַׂחֵק? אֶת זֶה רוֹאִים לְיַד ⏱ דַּקּ׳ לְשַׂחֵק." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الرقم لا ينقص عندما تلعب — إنه يعدّ ما ربحته اليوم. كم بقي للّعب؟ تراه بجانب ⏱ د. للّعب."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This number doesn't go down when you play — it counts what you earned today. How much is left to play? That's next to ⏱ Min to play."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это число не уменьшается, когда играешь, — оно считает, сколько ты заработал сегодня. Сколько осталось играть? Смотри рядом с ⏱ Мин. для игры."
          }
        }
      }
    },
    "הַמִּשְׁפָּחָה" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العائلة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Family"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Семья"
          }
        }
      }
    },
    "הַמִּשְׁפָּחָה כְּבָר רָכְשָׁה — יֶלֶד נוֹסָף בַּחֲצִי מְחִיר" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عائلتكم اشترت هذا من قبل — طفل إضافي بنصف السعر"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your family already bought this — another child is half price"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Семья уже купила — ещё один ребёнок за полцены"
          }
        }
      }
    },
    "הַמִּשְׁפָּחָה עָנְתָה עַל %lld שְׁאֵלוֹת הַיּוֹם 👏" : {
