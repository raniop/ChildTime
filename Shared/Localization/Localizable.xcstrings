    "האייפד הזה של %@? להפך אותו למכשיר שלו" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل هذا الـ iPad لـ %@؟ حوّلوه إلى جهازه"
          }
        },
