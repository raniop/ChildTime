    "ארבע ילדות" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أربع فتيات"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4 girls"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Четыре девочки"
          }
        }
