    "שִׂיחָה עִם צֶוֶת טוֹפִּי" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محادثة مع فريق Tofy"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chat with the Tofy team"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чат с командой Tofy"
          }
        }
      }
    },
    "שִׂימוּ אֶת הַחַיּוֹת בַּסַּל שֶׁיֵּשׁ עָלָיו כֶּלֶב וְחָתוּל, וְאֶת הָאֹכֶל בַּסַּל שֶׁיֵּשׁ עָלָיו תַּפּוּחַ וּבַנָּנָה." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضَعُوا الحَيَوانات في السَّلَّة التي عَلَيْها كَلْب وقِطّ، والطَّعام في السَّلَّة التي عَلَيْها تُفّاحَة ومَوْزَة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put the animals in the basket with the dog and the cat, and the food in the basket with the apple and the banana."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Положите животных в корзину с собакой и кошкой, а еду — в корзину с яблоком и бананом."
          }
        }
      }
    },
    "שִׂימוּ אֶת מִי שֶׁחַי בַּמַּיִם בַּסַּל שֶׁל הַגַּלִּים, וְאֶת מִי שֶׁחַי בַּיַּבָּשָׁה בַּסַּל שֶׁל הָעֵץ." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضَعُوا مَنْ يَعِيشُ في الماء في سَلَّةِ المَوْجَة، ومَنْ يَعِيشُ على اليابِسَة في سَلَّةِ الشَّجَرَة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put the ones that live in the water in the wave basket, and the ones that live on land in the tree basket."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тех, кто живёт в воде, — в корзину с волной, а тех, кто живёт на земле, — в корзину с деревом."
          }
        }
      }
    },
    "שִׂימוּ כָּל דָּבָר אָדֹם בַּסַּל הָאָדֹם, וְכָל דָּבָר כָּחֹל בַּסַּל הַכָּחֹל." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضَعُوا كُلَّ شَيْءٍ أَحْمَر في السَّلَّةِ الحَمْراء، وكُلَّ شَيْءٍ أَزْرَق في السَّلَّةِ الزَّرْقاء."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put everything red in the red basket, and everything blue in the blue basket."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё красное — в красную корзину, а всё синее — в синюю корзину."
          }
        }
      }
    },
    "שִׂימוּ כָּל דָּבָר גָּדוֹל בַּסַּל שֶׁל הַפִּיל, וְכָל דָּבָר קָטָן בַּסַּל שֶׁל הָעַכְבָּר." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضَعُوا كُلَّ شَيْءٍ كَبِيرٍ في سَلَّةِ الفِيل، وكُلَّ شَيْءٍ صَغِيرٍ في سَلَّةِ الفَأْر."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put everything big in the elephant's basket, and everything small in the mouse's basket."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё большое — в корзину слона, а всё маленькое — в корзину мышки."
          }
        }
      }
    },
