    "אֵין הַרְשָׁאָה לְמַצְלֵמָה.\nהַקְלִידוּ אֶת הַקּוֹד בִּמְקוֹם זֹאת.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No camera access.\nType the code instead."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет доступа к камере.\nВведите код вручную."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا إذن للكاميرا.\nاكتبوا الرمز بدلًا من ذلك."
          }
        }
      }
    },
    "אֵין חִבּוּר לָאִינְטֶרְנֶט. בִּדְקוּ אֶת הַחִבּוּר וְנַסּוּ שׁוּב.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet connection. Check your connection and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет подключения к интернету. Проверьте связь и попробуйте снова."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد اتصال بالإنترنت. تحقّقوا من الاتصال وحاولوا مرّة أخرى."
          }
        }
      }
    },
    "אֵין כָּרֶגַע מַכְשִׁיר מְחֻבָּר לְ%@ — הַחַלּוֹן יִפָּתַח בָּרֶגַע שֶׁהַמַּכְשִׁיר יִתְחַבֵּר.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No device is connected to %@ right now — the window will open as soon as the device connects."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас к %@ не подключено устройство — окно откроется, как только устройство подключится."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد جهاز متصل بـ%@ الآن — ستُفتح النافذة فور اتصال الجهاز."
          }
        }
      }
    },
    "אֵין לִי קוֹד — אֶצּוֹר מִשְׁפָּחָה מִשֶּׁלִּי": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I don't have a code — I'll create my own family"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У меня нет кода — создам свою семью"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس لديّ رمز — سأنشئ عائلتي الخاصة"
          }
        }
      }
    },
    "אֵין מַכְשִׁירִים מְחוּבָּרִים": {
      "localizations": {
        "en": {
          "stringUnit": {
