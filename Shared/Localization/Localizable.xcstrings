          }
        }
      }
    },
    "בבית הספר · מאז 08:02" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في المدرسة · منذ 08:02"
          }
        },
        "en" : {
