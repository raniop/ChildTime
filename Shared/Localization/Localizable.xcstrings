        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحدّي اليومي"
          }
        }
      }
    },
    "אַבָּא אוֹ אִמָּא יוֹרִידוּ תְּשׁוּבָה אַחַת לֹא נְכוֹנָה — וְאַתְּ עוֹנָה 😉": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mom or Dad will remove one wrong answer — then you pick 😉"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папа или мама уберут один неверный ответ — и ты отвечаешь 😉"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيزيل أبوكِ أو أمّكِ إجابة خاطئة واحدة — وتُجيبين أنتِ 😉"
          }
        }
      }
    },
    "אַבָּא אוֹ אִמָּא יוֹרִידוּ תְּשׁוּבָה אַחַת לֹא נְכוֹנָה — וְאַתָּה עוֹנֶה 😉": {
      "localizations": {
        "en": {
          "stringUnit": {
