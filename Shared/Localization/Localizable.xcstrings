    "צעד אחרון, בטלפון של %@:\nלאשר זמן מסך כדי שהנעילה תעבוד" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خطوة أخيرة، على هاتف %@:\nاسمحوا بـ\"مدة استخدام الجهاز\" ليعمل القفل"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One last step, on %@'s phone:\nallow Screen Time so the lock works"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последний шаг, на телефоне %@:\nразрешите «Экранное время», чтобы блокировка работала"
          }
        }
      }
    },
    "צפו יחד במשחק ובקשו מ%@ להסביר לכם חוק אחד שראיתם." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهدوا مباراة معًا واطلبوا من %@ أن يشرح لكم قاعدة واحدة رأيتموها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch a game together and ask %@ to explain one rule you saw."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посмотрите вместе матч и попросите %@ объяснить вам одно правило, которое вы увидели."
