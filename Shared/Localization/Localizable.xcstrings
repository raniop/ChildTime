    "מטעמי אבטחה, לפני מחיקת החשבון צריך להתחבר שוב." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لدواعٍ أمنية، يجب تسجيل الدخول مجددًا قبل حذف الحساب."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For your security, please sign in again before deleting the account."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В целях безопасности перед удалением аккаунта нужно войти ещё раз."
          }
        }
      }
    },
    "מי הילד?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من هو الطفل؟"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Who's the child?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кто ребёнок?"
          }
        }
      }
    },
    "מי משחק עכשיו, מטלות ממתינות, קופה — וכל הסטטים." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مَن يلعب الآن، والمهامّ المنتظِرة، والحصّالة — وكلّ الإحصاءات."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Who's playing, chores waiting, pocket money — every stat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кто играет, какие дела ждут, копилка — и вся статистика."
          }
        }
      }
    },
    "מי משחק?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من يلعب؟"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Who's playing?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кто играет?"
          }
        }
      }
    },
    "מי רואה: רק ההורים במשפחה. שום דבר לא עובר לאף גורם אחר." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من يرى: الأهل في العائلة فقط. لا يُرسل شيء لأي جهة أخرى."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Who sees it: only the parents in the family. Nothing goes to anyone else."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кто видит: только родители в семье. Никому больше ничего не передаётся."
          }
        }
      }
    },
    "מידע נוסף ←" : {
