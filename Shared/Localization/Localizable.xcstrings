    "אוֹסְלוֹ" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوسلو"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oslo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осло"
          }
        }
      }
    },
    "אוֹסְפִים כּוֹכָב עַל כָּל תְּשׁוּבָה נְכוֹנָה. הַכּוֹכָבִים אַף פַּעַם לֹא יוֹרְדִים — הֵם הַנִּקּוּד שֶׁלָּכֶם בְּטַבְלַת הַחֲבֵרִים!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجمعون نجمة عن كل إجابة صحيحة. والنجوم لا تنقص أبدًا — إنها نتيجتكم في جدول الأصدقاء!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You get a star for every correct answer. Stars never go down — they're your score on the friends leaderboard!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты получаешь звезду за каждый правильный ответ. Звёзды никогда не убавляются — это твои очки в таблице друзей!"
          }
        }
      }
    },
    "אוֹסְפִים מֵהַמַּדָּף אֶת כָּל מָה שֶׁבָּרְשִׁימָה וְהוֹלְכִים לַקֻּפָּה" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نأخذ من الرف كل ما في القائمة ثم نتوجه إلى الصندوق"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take everything on the list off the shelf, then head to the till"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Берём с полки всё из списка и идём на кассу"
          }
        }
      }
    },
    "אוֹסָקָה" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
