    "צאו בערב להסתכל על הירח והכוכבים, ושאלו את %@ מה זה כוכב לכת.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go out one evening to look at the moon and stars, and ask %@ what a planet is."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выйдите вечером посмотреть на луну и звёзды и спросите %@, что такое планета."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اخرجوا في المساء لتنظروا إلى القمر والنجوم، واسألوا %@ ما هو الكوكب."
          }
        }
      }
    },
    "צאו לטיול קצר בשכונה או בעיר, ודברו על סמלים, חגים ומקומות בישראל.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a short walk around your neighborhood or town — and talk about symbols, holidays, and places in America."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сходите на короткую прогулку по району или городу и поговорите о символах, праздниках и местах в Израиле."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اخرجوا في نزهة قصيرة في الحيّ أو في المدينة، وتحدّثوا عن الرموز والأعياد والأماكن في إسرائيل."
