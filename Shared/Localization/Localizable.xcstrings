      }
    },
    "💰 %@ קָנָה %lld מַחְבָּרוֹת בְּ־%lld שְׁקָלִים כָּל אַחַת, וְשִׁלֵּם בְּ־%lld שְׁקָלִים. כַּמָּה עֹדֶף מַגִּיעַ?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "💰 %@ bought %lld notebooks for %lld dollars each and paid with %lld dollars. How much change should they get?"
