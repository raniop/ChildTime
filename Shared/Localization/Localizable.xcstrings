      }
    },
    "סַדֵּר אֶת הַדְּבָרִים לְפִי הַזְּמַן — מָה הָיָה רִאשׁוֹן וּמָה אַחֲרָיו.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put things in time order — what came first and what came next."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расставь события по времени — что было первым, а что потом."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رتّب الأشياء حسب الزمن — ما الذي جاء أوّلًا وما الذي جاء بعده."
          }
        }
      }
    },
