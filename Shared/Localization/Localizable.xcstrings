        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Specific app unlocked"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отдельное приложение открыто"
          }
        }
      }
    },
    "אַפְּלִיקַצְיָה שֶׁנִּמְצֵאת שָׁם, טוֹפִי לֹא יָכוֹל לִנְעֹל." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التطبيق الموجود هناك لا يستطيع Tofy قفله."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An app on that list is one Tofy cannot lock."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение из этого списка Tofy заблокировать не может."
          }
        }
      }
    },
    "אַפְּלִיקַצְיוֹת בַּמַּכְשִׁיר" : {
