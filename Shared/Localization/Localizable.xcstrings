        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نتعلّم، نلعب، نربح وقت شاشة"
          }
        }
      }
    },
    "לוֹמְדִים, מַרְוִיחִים זְמַן מָסָךְ —\nוְהַהוֹרִים תָּמִיד בַּתְּמוּנָה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn, earn screen time —\nand parents are always in the loop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учимся, зарабатываем экранное время —\nа родители всегда в курсе."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نتعلّم ونربح وقت شاشة —\nوالوالدان دائمًا في الصورة."
          }
        }
      }
    },
