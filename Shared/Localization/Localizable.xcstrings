        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О приложении и приватность"
          }
        }
      }
    },
    "אוֹסְפִים כּוֹכָב עַל כָּל תְּשׁוּבָה נְכוֹנָה. הַכּוֹכָבִים אַף פַּעַם לֹא יוֹרְדִים — הֵם הַנִּקּוּד שֶׁלָּכֶם בְּטַבְלַת הַחֲבֵרִים!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You get a star for every correct answer. Stars never go down — they're your score on the friends leaderboard!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты получаешь звезду за каждый правильный ответ. Звёзды никогда не убавляются — это твои очки в таблице друзей!"
          }
        }
      }
    },
    "אוֹפְּס... אֵין קְטָעִים חֲדָשִׁים כָּרֶגַע": {
      "localizations": {
