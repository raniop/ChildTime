        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New year!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новый год!"
          }
        }
      }
    },
    "שָׁנָה חֲדָשָׁה, הַרְפַּתְקָה חֲדָשָׁה — טוֹפִי כְּבָר הֵכִין\nשְׁאֵלוֹת חֲדָשׁוֹת בְּדִיּוּק %@! 🚀" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سنة جديدة، مغامرة جديدة — Tofy جهّز من قبلُ\nأسئلة جديدة بالضبط %@! 🚀"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New year, new adventure — Tofy already made\nnew questions just %@! 🚀"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новый год, новое приключение — Tofy уже приготовил\nновые вопросы как раз %@! 🚀"
          }
        }
      }
    },
    "שָׁנָה שֶׁל סַקְרָנוּת, בִּטָּחוֹן וְהָמוֹן רְגָעִים טוֹבִים —\nטוֹפִי כְּבָר מְחַכֶּה לָהֶם עִם שְׁאֵלוֹת חֲדָשׁוֹת 💛" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سنة من الفضول والثقة والكثير من اللحظات الجميلة —\nTofy ينتظرها بالفعل بأسئلة جديدة 💛"
