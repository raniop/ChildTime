    "הִגַּעְתָּ לְכָל הַדַּקּוֹת שֶׁל הַיּוֹם.\nנִתְרָאֶה מָחָר בַּבֹּקֶר": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've used all of today's minutes.\nSee you tomorrow morning"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты использовал все минуты на сегодня.\nУвидимся завтра утром"
          }
        }
      }
    },
    "הִגַּעְתָּ לְמַקְסִימוּם זְמַן הַמָּסָךְ הַיּוֹמִי 🌙 — %lld דַּקּוֹת שְׁמוּרוֹת לְמָחָר": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've reached today's max screen time 🌙 — %lld minutes saved for tomorrow"
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ты достиг дневного максимума экранного времени 🌙 — %lld минута сохранена на завтра"
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ты достиг дневного максимума экранного времени 🌙 — %lld минуты сохранены на завтра"
                }
