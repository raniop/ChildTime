    },
    "כָּל הָעוֹלָמוֹת — כּוֹלֵל כָּל עוֹלָם חָדָשׁ שֶׁנּוֹסִיף — הַמִּשְׂחָקִים וְהַמַּטְלוֹת, לְכָל הַיְלָדִים, בְּכָל הַמַּכְשִׁירִים. קוֹנִים פַּעַם אַחַת, כָּאן.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All worlds — including every new world we add — plus games and chores, for all your kids, on all devices. Buy once, here."
