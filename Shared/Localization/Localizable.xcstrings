        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعدادات الوالدين"
          }
        }
      }
    },
    "הַדִּיּוּק שֶׁל %@ בְּ%@ יָרַד בְּ-%lld נְקֻדּוֹת לְעֻמַּת הַתְּקוּפָה הַקּוֹדֶמֶת. לִפְעָמִים זֶה פָּשׁוּט חֹמֶר חָדָשׁ שֶׁנִּכְנַס.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'s accuracy in %@ dropped by %lld points compared to the previous period. Sometimes it's just new material coming in."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точность %1$@ по теме %2$@ упала на %#@count@ по сравнению с прошлым периодом. Иногда это просто новый материал."
          },
          "substitutions": {
            "count": {
              "argNum": 3,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg пункт"
                    }
                  },
                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg пункта"
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg пунктов"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg пункта"
                    }
                  }
                }
              }
            }
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انخفضت دقّة %@ في %@ بمقدار %lld نقاط مقارنةً بالفترة السابقة. أحيانًا يكون السبب ببساطة مادة جديدة بدأت للتوّ."
          }
        }
      }
    },
    "הַדֵּרוּג שֶׁלָּכֶם": {
