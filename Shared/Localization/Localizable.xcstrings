      }
    },
    "אפוס התקדמות" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعادة تعيين التقدّم"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reset progress"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сбросить прогресс"
          }
        }
      }
    },
    "אפל לא אישרה את ההרשאה (%@)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تمنح Apple الإذن (%@)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple didn't approve the permission (%@)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple не подтвердила разрешение (%@)."
          }
        }
      }
    },
    "אפליקציה אחרת במכשיר כבר משתמשת ב-Screen Time (אפל מאפשרת אחת בלבד). הסירו אותה מ״הגדרות ← זמן מסך ← אפליקציות עם גישה״, ונסו שוב." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيق آخر على الجهاز يستخدم Screen Time بالفعل (تسمح Apple بواحد فقط). أزيلوه من «الإعدادات ← وقت الشاشة ← التطبيقات ذات الوصول»، ثم حاولوا مرّة أخرى."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another app on this device is already using Screen Time (Apple allows only one). Remove it in Settings → Screen Time → Apps with Access, then try again."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другое приложение на устройстве уже использует Screen Time (Apple разрешает только одно). Удалите его в «Настройки → Экранное время → Приложения с доступом» и попробуйте снова."
          }
        }
      }
    },
    "אפליקציה אחת או כמה, לזמן קצוב. בסופו הן ננעלות לבד." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيق واحد أو بضعة تطبيقات لوقت محدد. تُقفَل من تلقاء نفسها عند انتهائه."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One app or a few, for a set time. They lock again on their own when it ends."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одно или несколько приложений на заданное время. Потом они блокируются сами."
          }
        }
      }
    },
    "אפליקציה חדשה" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيق جديد"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new app"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новое приложение"
          }
        }
      }
    },
    "אפליקציה חדשה שהילד מתקין לא נעולה במכשיר הזה. פתחו בו את טופי ← ⚙️ ← ״לנעול גם אפליקציות חדשות״ ובחרו מה נשאר פתוח." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التطبيق الجديد الذي يُنزّله طفلكم غير مقفل على هذا الجهاز. افتحوا توفي عليه ← ⚙️ ← «اقفلوا التطبيقات الجديدة أيضًا» واختاروا ما يبقى مفتوحًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new app your child installs is not locked on this device. Open Tofy on it ← ⚙️ ← “Lock new apps too” and choose what stays open."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новое приложение, установленное ребёнком, не блокируется на этом устройстве. Откройте на нём Tofy → ⚙️ → «Блокировать и новые приложения» и выберите, что остаётся открытым."
          }
        }
      }
    },
    "אפליקציה מסוימת פתוחה" : {
