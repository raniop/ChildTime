        }
      }
    },
    "אֵין לַמִּשְׁפָּחָה מַכְשִׁיר הוֹרֶה נוֹסָף. קֹדֶם הַתְקִינוּ טוֹפִי בָּאַיְפוֹן וְהִתְחַבְּרוּ עִם אוֹתוֹ חֶשְׁבּוֹן, אַחֶרֶת לֹא תּוּכְלוּ לְנַהֵל." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد للعائلة جهاز والد آخر. ثبّتوا Tofy أولًا على الـ iPhone وسجّلوا الدخول بالحساب نفسه، وإلا فلن تتمكنوا من الإدارة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your family has no other parent device. First install Tofy on your iPhone and sign in with the same account — otherwise you won't be able to manage the family."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
