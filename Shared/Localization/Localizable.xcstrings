          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ результаты на %lld%% за эту неделю. Молодец!"
          }
        }
      }
    },
    "%@ %@ ב%@ — אתגרו %@ בשאלה קשה יותר ותראו את הביטחון.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ in %@ — challenge %@ with a harder question and watch the confidence grow."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ в %@ — предложите %@ вопрос потруднее и увидите, как растёт уверенность."
          }
        }
      }
    },
    "%@ %@ ב%@. תחומים שכיף לחגוג בהם.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ in %@. Worth celebrating!"
