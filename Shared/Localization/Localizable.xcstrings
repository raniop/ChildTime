          }
        }
      }
    },
    "אֵיפֹה %@?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where is %@?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где %@?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أين %@؟"
          }
        }
      }
    },
    "אֵלֶּה יִנָּעֲלוּ עַד שֶׁהַיֶּלֶד יַרְוִיחַ דַּקּוֹת מִשְׂחָק.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These stay locked until your child earns play minutes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они будут заблокированы, пока ребёнок не заработает минуты игры."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى هذه مقفلة حتى يربح الطفل دقائق لعب."
          }
        }
      }
    },
    "אֵלֶּה לֹא יִנָּעֲלוּ אַף פַּעַם — גַּם אִם הַקָּטֵגוֹרְיָה שֶׁלָּהֶם חֲסוּמָה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These never lock — even if their category is blocked."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они не блокируются никогда — даже если их категория заблокирована."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه لا تُقفل أبدًا — حتى لو كانت فئتها محجوبة."
          }
        }
      }
    },
    "אֶבְחַר אַחַר כָּךְ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll choose later"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберу позже"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سأختار لاحقًا"
          }
        }
      }
    },
    "אֶפְשָׁר לְדַלֵּג וּלְחַבֵּר אֶת הַמַּכְשִׁיר אַחַר כָּךְ — מֵהַמָּסָךְ הָרָאשִׁי.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can skip this and connect the device later — from the home screen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно пропустить и подключить устройство позже — с главного экрана."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن التخطّي وربط الجهاز لاحقًا — من الشاشة الرئيسية."
          }
        }
      }
    },
    "אֶפְשָׁר לְשַׁנּוֹת מְאוּחָר יוֹתֵר בְּהַגְדָּרוֹת.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can change this later in Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это можно изменить позже в настройках."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن تغيير ذلك لاحقًا في الإعدادات."
          }
        }
      }
    },
    "אֶפְשָׁר לִבְחֹר קָטֵגוֹרְיָה שְׁלֵמָה (מִשְׂחָקִים, רְשָׁתוֹת חֶבְרָתִיּוֹת) אוֹ אַפְּלִיקַצְיוֹת מְסֻיָּמוֹת. תָּמִיד אֶפְשָׁר לְשַׁנּוֹת.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can pick a whole category (games, social media) or specific apps. You can always change this."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно выбрать целую категорию (игры, соцсети) или отдельные приложения. Изменить можно в любой момент."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن اختيار فئة كاملة (ألعاب، شبكات اجتماعية) أو تطبيقات محدّدة. ويمكن التغيير دائمًا."
          }
        }
      }
    },
    "אֶפְשָׁר לִסְפּוֹר עַל הָאֶצְבָּעוֹת אוֹ לְצַיֵּר נְקוּדּוֹת וְאָז לִסְפּוֹר אֶת הַכֹּל.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can count on your fingers or draw dots, then count them all."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно посчитать на пальцах или нарисовать точки, а потом сосчитать всё."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن العدّ على الأصابع أو رسم نقاط ثم عدّ الجميع."
          }
        }
      }
    },
    "אֶפְשָׁר לִפְתּוֹחַ עַכְשָׁיו %lld דַּקּוֹת מִשְׂחָק! 🎮": {
      "localizations": {
