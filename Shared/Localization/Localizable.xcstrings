          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نتمكّن من الحصول على الإذن (%@)."
          }
        }
      }
    },
    "לא הצלחנו לשלוח את העדכון למכשיר של הילד/ה. בדקו את החיבור לאינטרנט ונסו שוב.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't send the update to your child's device. Check your internet connection and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отправить обновление на устройство ребёнка. Проверьте подключение к интернету и попробуйте ещё раз."
          }
        },
        "ar": {
