    },
    "בלי זה לא נוכל לחסום אפליקציות": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without this, we can't block apps"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без этого мы не сможем блокировать приложения"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون ذلك لن نتمكّن من حجب التطبيقات"
          }
        }
      }
    },
    "במסך ההורים יש עכשיו מדף \"שאלונים חדשים\": עולם שלם של שאלות בנושא שהילד אוהב. למנויי טופי+ הוא נפתח אוטומטית לכל הילדים; בלי מנוי בוחרים לאיזה ילד לשלוח, וברגע הבא הוא מקבל מתנה במסך הבית שלו. ילד שרוצה שאלון לוחץ \"בקש מאבא או אמא\" — בלי מחירים במכשיר של הילד": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The parent screen now has a “New quizzes” shelf: a whole world of questions on a topic your child loves. Tofy+ subscribers get it unlocked automatically for all kids; without a subscription, you choose which child to send it to, and they get a gift on their home screen right away. A child who wants a quiz taps “Ask Mom or Dad” — no prices on the child's device"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На родительском экране теперь есть полка «Новые викторины»: целый мир вопросов на тему, которую ребёнок любит. Подписчикам Tofy+ она открывается автоматически для всех детей; без подписки вы выбираете, какому ребёнку её отправить, и он сразу получает подарок на своём домашнем экране. Ребёнок, который хочет викторину, нажимает «Попроси маму или папу» — без цен на детском устройстве"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في شاشة الوالدين يوجد الآن رفّ \"اختبارات جديدة\": عالم كامل من الأسئلة في موضوع يحبّه الطفل. لمشتركي Tofy+ يُفتح تلقائيًا لجميع الأطفال؛ وبدون اشتراك تختارون لأيّ طفل ترسلونه، وفي اللحظة التالية يصله هديةً في شاشته الرئيسية. الطفل الذي يريد اختبارًا يضغط \"اطلب من بابا أو ماما\" — بلا أسعار على جهاز الطفل"
          }
        }
      }
    },
    "בנסיעה, ספרו יחד גלגלים וכלי רכב ושאלו את %@ מי נוהג במה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a drive, count wheels and vehicles together and ask %@ who drives what."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В поездке посчитайте вместе колёса и машины и спросите %@, кто чем управляет."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في أثناء السفر، عُدّوا معًا العجلات والمركبات واسألوا %@ من يقود ماذا."
          }
        }
      }
    },
    "בקרו בגן חיות או צאו לטבע, ותנו ל%@ לזהות חיות ולספר מה הן אוכלות.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visit a zoo or go out in nature — and let %@ spot animals and tell you what they eat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сходите в зоопарк или на природу — и дайте %@ узнавать животных и рассказывать, что они едят."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زوروا حديقة حيوانات أو اخرجوا إلى الطبيعة، ودعوا %@ يتعرّف على الحيوانات ويخبركم بما تأكله."
          }
        }
      }
    },
    "בקרו במוזיאון טבע או צפו בסרטון על דינוזאורים, ותנו ל%@ לספר לכם על אחד.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visit a natural history museum or watch a video about dinosaurs, and let %@ tell you about one."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сходите в музей природы или посмотрите видео о динозаврах — и дайте %@ рассказать вам об одном из них."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زوروا متحف طبيعة أو شاهدوا مقطعًا عن الديناصورات، ودعوا %@ يحدّثكم عن واحد منها."
          }
        }
      }
    },
    "בקש": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попросить"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب"
          }
        }
      }
    },
    "בשלו יחד מתכון פשוט ותנו ל%@ למדוד ולהכפיל כמויות.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cook a simple recipe together and let %@ measure and double the amounts."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приготовьте вместе простое блюдо и дайте %@ отмерять и удваивать количества."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطبخوا معًا وصفة بسيطة ودعوا %@ يقيس الكمّيات ويضاعفها."
          }
        }
      }
    },
    "בשליטתכם": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're in control"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Под вашим контролем"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحت سيطرتكم"
          }
        }
      }
    },
    "בתום הניסיון: %@ / שנה — ניתן לבטל בכל עת בהגדרות Apple ID": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the trial: %@ / year — cancel anytime in your Apple ID settings"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После пробного периода: %@ / год — отменить можно в любой момент в настройках Apple ID"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد انتهاء التجربة: %@ / سنة — يمكن الإلغاء في أيّ وقت من إعدادات Apple ID"
          }
        }
      }
    },
    "בתקופת המתנה %@ שם על %lld שאלות ב־%lld%%. ההתקדמות %@ שמורה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "During the gift period, %@ %lld questions there with %lld%% accuracy — %@ progress is saved."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За время подарка %1$@ там на %#@count@ с точностью %3$lld%%. %4$@ прогресс сохранён."
          },
          "substitutions": {
            "count": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg вопрос"
                    }
                  },
                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg вопроса"
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg вопросов"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg вопроса"
                    }
                  }
                }
              }
            }
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في فترة الهدية %@ هناك على %lld سؤالًا بدقّة %lld%%. تقدّم%@ محفوظ."
          }
        }
      }
    },
