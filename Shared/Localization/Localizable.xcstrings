    "הָרְכִישָׁה דּוֹרֶשֶׁת אִישּׁוּר Apple ID (סִיסְמָה / Face ID). הַיַּהֲלוֹמִים מְשַׁמְּשִׁים לִקְנִיַּת דְּמוּיוֹת בְּתוֹךְ הָאַפְּלִיקַצְיָה בִּלְבַד." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلّب عملية الشراء تأكيد Apple ID (كلمة السر / Face ID). تُستخدم الألماسات لشراء الشخصيات داخل التطبيق فقط."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purchases require Apple ID approval (password / Face ID). Diamonds can only be used to buy characters inside the app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покупка требует подтверждения Apple ID (пароль / Face ID). Алмазы используются только для покупки персонажей внутри приложения."
          }
        }
      }
    },
    "הָרְכִישָׁה דּוֹרֶשֶׁת אִישּׁוּר בְּחֶשְׁבּוֹן Google Play. הַיַּהֲלוֹמִים מְשַׁמְּשִׁים לִקְנִיַּת דְּמוּיוֹת בְּתוֹךְ הָאַפְּלִיקַצְיָה בִּלְבַד." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلّب عملية الشراء تأكيدًا في حساب Google Play. تُستخدم الألماسات لشراء الشخصيات داخل التطبيق فقط."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purchases require approval in your Google Play account. Diamonds can only be used to buy characters inside the app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покупка требует подтверждения в аккаунте Google Play. Алмазы используются только для покупки персонажей внутри приложения."
          }
        }
      }
    },
    "הָרְכִישָׁה הִצְלִיחָה, וַאֲנַחְנוּ עוֹד מְאַמְּתִים אוֹתָהּ מוּל Google Play. הִיא תִּכָּנֵס לְתֹקֶף מֵעַצְמָהּ בְּעוֹד כַּמָּה רְגָעִים." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
