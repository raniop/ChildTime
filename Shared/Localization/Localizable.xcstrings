    "צֵא מִמַּצַּב יֶלֶד" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اخرج من وضع الطفل"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exit Kid Mode"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
