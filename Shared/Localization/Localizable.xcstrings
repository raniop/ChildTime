    "בחר אילו אפליקציות יהיו נעולות עד שהילד יענה על שאלות\n(YouTube, TikTok, משחקים…)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which apps stay locked until your child answers questions\n(YouTube, TikTok, games…)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, какие приложения останутся заблокированными, пока ребёнок не ответит на вопросы\n(YouTube, TikTok, игры…)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر أيّ التطبيقات تبقى مقفلة حتى يجيب الطفل على الأسئلة\n(YouTube، TikTok، ألعاب…)"
          }
        }
      }
