    "עזרו לילד שלכם להכיר שחקנים, קבוצות, תחרויות ועובדות מעניינות מעולם הכדורגל בישראל ובעולם.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help your child get to know players, teams, tournaments, and fun facts from the world of soccer, in the US and around the globe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помогите ребёнку познакомиться с игроками, командами, турнирами и интересными фактами из мира футбола в Израиле и во всём мире."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعدوا طفلكم على التعرّف على لاعبين وفرق وبطولات وحقائق مثيرة من عالم كرة القدم في إسرائيل وفي العالم."
          }
        }
      }
