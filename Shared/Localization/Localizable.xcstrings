    "נָסִיר אֶת הַשְּׁאֵלָה הַזּוֹ וְלֹא נַצִּיג אוֹתָהּ שׁוּב, וְנִשְׁלַח עָלֶיהָ דִּוּוּחַ כְּדֵי שֶׁנְּשַׁפֵּר.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll remove this question, won't show it again, and send a report so we can improve it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы уберём этот вопрос и больше его не покажем, а ещё отправим отчёт, чтобы всё исправить."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنزيل هذا السؤال ولن نعرضه مرّة أخرى، وسنرسل عنه تقريرًا كي نتحسّن."
          }
        }
      }
    },
    "נָעוּל שָׁם! ✅ אֶפְשָׁר לְשַׂחֵק כָּאן 🎉": {
