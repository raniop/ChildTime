            "value" : "В школе · с 08:02"
          }
        }
      }
    },
    "בגן המשחקים הם תמונות, צבעים וכמויות — וההוראה נאמרת בקול, לא נכתבת" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في الروضة الألعاب صور وألوان وكمّيات — والتعليمات تُقال بصوت، لا تُكتب"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In kindergarten the games are pictures, colours and quantities — and the rule is spoken aloud, not written"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В детском саду игры — это картинки, цвета и количества, а правило проговаривается вслух, а не пишется"
          }
        }
