        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّلوا الدخول بحسابكم — ثم أدخلوا رمز العائلة الذي وصلكم."
          }
        }
      }
    },
    "הִתְחַבְּרוּ, וְסִרְקוּ אֶת הַקּוֹד שֶׁכָּאן (אוֹ הַקְלִידוּ אוֹתוֹ)": {
