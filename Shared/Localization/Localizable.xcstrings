    "כפתור 'עשיתי!' בצבע של הילד/ה, כתר וברכת 'אלוף/אלופה', וקטגוריה נפרדת של 'בוצעו היום'. הפרס תמיד דקות משחק" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زر «فعلتها!» بلون الطفل/ة، وتاج وتهنئة «بطل/بطلة»، وفئة منفصلة باسم «أُنجزت اليوم». والمكافأة دائمًا دقائق لعب"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An 'I did it!' button in your child's color, a crown and a 'Champion!' cheer, and a separate 'Done today' section. The reward is always play minutes"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка «Я сделал!» в цвете ребёнка, корона и поздравление «Чемпион!», а также отдельная категория «Сделано сегодня». Награда — всегда минуты игры"
          }
        }
      }
    },
    "כפתורים מיושרים" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أزرار مصطفّة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aligned buttons"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ровные кнопки"
          }
        }
      }
    },
    "כרגע נעולות רק האפליקציות שבחרתם ברשימה למטה. אפליקציה חדשה שהילד מתקין נשארת פתוחה — בחרו מה נשאר פתוח כדי לסגור את הפרצה." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حاليًا تُقفل فقط التطبيقات التي اخترتموها في القائمة أدناه. أي تطبيق جديد يُنزّله طفلكم يبقى مفتوحًا — اختاروا ما يبقى مفتوحًا لإغلاق هذه الثغرة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right now only the apps you picked in the list below are locked. A new app your child installs stays open — choose what stays open to close that gap."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас заблокированы только приложения из списка ниже. Новое приложение, установленное ребёнком, остаётся открытым — выберите, что остаётся открытым, чтобы закрыть эту брешь."
          }
        }
      }
    },
    "כרטיס הילד" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
