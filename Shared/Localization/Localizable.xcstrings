            "value" : "So arrival and departure alerts work even when Tofy is closed: in the settings that open, choose Permissions → Location → Allow all the time."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы уведомления о приходе и уходе работали, даже когда Tofy закрыт: в открывшихся настройках выберите Разрешения → Местоположение → Разрешить в любом режиме."
          }
        }
      }
    },
    "כוכבים (דירוג)" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النجوم (الترتيب)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stars (rank)"
          }
