          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى الوقت 🔒"
          }
        }
      }
    },
    "הַזְּמַן שֶׁלְּךָ בַּדֶּרֶךְ!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your time is on its way!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоё время уже в пути!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتك في الطريق!"
          }
        }
      }
    },
    "הַזְּמַן שֶׁלְּךָ כְּבָר פָּתוּחַ %@ — עוֹד %lld דַּקּוֹת 🎮": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your time is already open %@ — %lld minutes left 🎮"
          }
        },
        "ru": {
