          }
        }
      }
    },
    "חֲשִׁיבָה, סְדָרוֹת, הֶקֵּשִׁים וּתְפִיסָה מֶרְחָבִית": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thinking, sequences, inference, and spatial reasoning"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мышление, последовательности, выводы и пространственное восприятие"
          }
        }
      }
    },
    "חֲשִׁיבָה, סְדָרוֹת, הֶקֵּשִׁים וּתְפִיסָה מֶרְחָבִית — בְּשָׁלוֹשׁ רָמוֹת שֶׁמִּתְאִימוֹת אֶת עַצְמָן לַיֶּלֶד, וְעַל כָּל תְּשׁוּבָה נְכוֹנָה מַרְוִיחִים דַּקּוֹת מִשְׂחָק, בְּדִיּוּק כְּמוֹ בְּכָל עוֹלָם.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thinking, sequences, inference, and spatial reasoning — in three levels that adapt to your child, and every correct answer earns play minutes, just like in every world."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мышление, последовательности, выводы и пространственное восприятие — в трёх уровнях, которые подстраиваются под ребёнка, и за каждый правильный ответ вы зарабатываете игровые минуты, как и в любом мире."
          }
        }
      }
    },
    "חֲשׁוֹב אֵיךְ הַמִּלָּה נִשְׁמַעַת, וְחַפֵּשׂ אֶת הָאוֹתִיּוֹת שֶׁעוֹשׂוֹת אֶת הַצְּלִיל.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Think about how the word sounds, and look for the letters that make that sound."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подумай, как звучит слово, и найди буквы, которые дают этот звук."
          }
        }
      }
    },
    "חֲשׁוֹב כַּמָּה זֶה עוֹלֶה 💰": {
      "localizations": {
