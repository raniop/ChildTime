          "stringUnit" : {
            "state" : "translated",
            "value" : "Только Tofy — нажмите, чтобы выбрать ещё"
          }
        }
      }
    },
    "רק מה שבאמת חדש בשבילכם" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط ما هو جديد بالنسبة لكم فعلًا"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only what's actually new to you"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только то, что действительно ново для вас"
          }
        }
      }
    },
    "רַק מָה שֶׁתִּבְחֲרוּ יִשָּׁאֵר פָּתוּחַ בַּמַּכְשִׁיר שֶׁלָּכֶם. כָּל הַשְּׁאָר נִנְעָל." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيبقى مفتوحًا على جهازكم ما تختارونه فقط. وكلّ الباقي يُقفل."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only what you choose stays open on your device. Everything else is locked."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открытым на вашем устройстве останется только то, что вы выберете. Всё остальное закроется."
          }
        }
      }
    },
    "רַק מִי שֶׁיּוֹדֵעַ אֶת הַקּוֹד יָכוֹל לִפְתּוֹחַ אֶת דַּקּוֹת הַמִּשְׂחָק שֶׁלְּךָ." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من يعرف الرمز وحده يستطيع فتح دقائق اللعب الخاصّة بك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only someone who knows the code can unlock your play minutes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только тот, кто знает код, может открыть твои игровые минуты."
          }
        }
      }
    },
    "רַק שְׁאֵלָה אַחַת כְּדֵי שֶׁנֵּדַע לְאָן לְהַמְשִׁיךְ:" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سؤال واحد فقط لنعرف إلى أين نتابع:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just one question so we know where to go next:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всего один вопрос, чтобы понять, куда двигаться дальше:"
          }
        }
      }
    },
    "רַק שְׁאֵלוֹת עֲנָק — קָשׁוֹת בִּמְיוּחָד, מִכָּל הַנּוֹשְׂאִים!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أسئلة عملاقة فقط — صعبة بشكل خاصّ، من كلّ المواضيع!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only giant questions — extra hard, from every topic!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только гигантские вопросы — самые сложные, из всех тем!"
          }
        }
      }
    },
    "שְׁאֵלָה %lld/%lld" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سؤال %lld/%lld"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Question %lld/%lld"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вопрос %lld/%lld"
          }
        }
      }
    },
    "שְׁאֵלָה קָשָׁה בִּמְיוּחָד — עֲנוּ נָכוֹן וְקַבְּלוּ אֶת כָּל הַדַּקּוֹת!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سؤال صعب بشكل خاصّ — أجيبوا بشكل صحيح واحصلوا على كلّ الدقائق!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An extra-hard question — get it right and win all the minutes!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Особенно сложный вопрос — ответь правильно и получи все минуты!"
          }
