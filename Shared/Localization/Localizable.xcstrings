    "עוד אין מקומות. הוסיפו את הבית ואת בית הספר, ותקבלו התראה כשהילדים מגיעים ויוצאים." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد أماكن بعد. أضيفوا البيت والمدرسة، وستصلكم تنبيهات عندما يصل الأطفال ويغادرون."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No places yet. Add home and school, and you'll be notified when the kids arrive and leave."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мест пока нет. Добавьте дом и школу — и вы будете получать уведомления, когда дети приходят и уходят."
          }
        }
      }
    },
    "עוד אין פעילות להראות. ברגע שהילדים יתחילו לשחק, הכל יופיע כאן." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
