            "value" : "Family"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Семья"
          }
        }
      }
    },
    "משפחה חדשה נשאלת איך לקרוא לה, עם הצעה מוכנה משם החשבון — במקום להישאר \"תנו שם למשפחה\" במסך הראשי" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العائلة الجديدة تُسأل كيف نسمّيها، مع اقتراح جاهز من اسم الحساب — بدل أن تبقى الشاشة الرئيسية على «سمّوا العائلة»"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New families are asked what to call themselves, with a suggestion based on the account name — instead of the main screen staying on “Name your family”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новую семью спрашивают, как её назвать, с готовым предложением из имени аккаунта — вместо надписи «Дайте семье имя» на главном экране"
          }
        }
      }
    },
    "משפחה ללא שם" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عائلة بلا اسم"
