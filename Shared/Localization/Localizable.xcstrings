    "גם אם המכשיר כבוי עכשיו — המתנה מחכה בענן." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حتى لو كان الجهاز مُطفأً الآن — الهدية تنتظر في السحابة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even if the device is off right now — the gift is waiting in the cloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже если устройство сейчас выключено — подарок ждёт в облаке."
          }
        }
      }
    },
    "גם אם המכשיר של הילד כבוי או תקוע, 'נעל עכשיו (מרחוק)' סוגר את זמן המשחק — והילד יכול לפתוח מיד במכשיר השני" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حتى لو كان جهاز الطفل مُطفأً أو عالقًا، 'أقفل الآن (عن بُعد)' ينهي وقت اللعب — ويمكن للطفل أن يفتح فورًا على الجهاز الآخر"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even if your child's device is off or stuck, 'Lock now (remote)' ends play time — and your child can start right away on the other device"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже если устройство ребёнка выключено или зависло, «Заблокировать сейчас (удалённо)» завершает игровое время — и ребёнок может сразу начать на другом устройстве"
          }
        }
      }
    },
    "גם במשחקים מרוויחים דקות" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الألعاب تكسب دقائق أيضًا"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Games earn minutes too"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В играх тоже зарабатывают минуты"
          }
        }
      }
    },
    "גם שארית של פחות מדקה שנתתם במתנה נפתחת עכשיו, במקום להיתקע" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الهدية التي تقل عن دقيقة تُفتح الآن بدل أن تعلق"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gift of less than a minute now opens instead of getting stuck"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подарок меньше минуты теперь открывается, а не застревает"
          }
        }
      }
    },
    "גם תשובות נכונות בסיבוב ההפתעה מוסיפות זמן משחק, ומסך הסיום מראה כמה" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإجابات الصحيحة في الجولة المفاجئة تضيف وقت لعب أيضًا، وشاشة النهاية تعرض كم"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right answers in a surprise round add play time too, and the end screen shows how much"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правильные ответы в раунде-сюрпризе тоже добавляют игровое время, а финальный экран показывает сколько"
          }
        }
      }
    },
