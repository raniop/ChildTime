        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each mistake takes off %lld min (half the reward for a correct answer) — but your child can win it right back: a clean correct answer on the next question returns all the lost time. Your child never sees \"wrong\" or \"you lost.\""
          }
        },
        "ru" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Каждая ошибка снимает %lld минуты (половина награды за правильный ответ) — но ребёнок может сразу вернуть время: чистый правильный ответ на следующий вопрос возвращает всё, что ушло. Ребёнку никогда не показывают «ты ошибся» или «ты проиграл»."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Каждая ошибка снимает %lld минут (половина награды за правильный ответ) — но ребёнок может сразу вернуть время: чистый правильный ответ на следующий вопрос возвращает всё, что ушло. Ребёнку никогда не показывают «ты ошибся» или «ты проиграл»."
                }
