    "המתנה הגיעה למכשיר של %@ ✓": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gift reached %@'s device ✓"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подарок дошёл до устройства %@ ✓"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصلت الهدية إلى جهاز %@ ✓"
          }
        }
      }
    },
    "המתנה לא נשלחה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gift wasn't sent"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подарок не отправлен"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُرسل الهدية"
          }
        }
      }
    },
    "המתנה נשלחה ונשמרה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gift sent and saved"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подарок отправлен и сохранён"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُرسلت الهدية وحُفظت"
          }
        }
      }
    },
    "המתנה שמורה ותישלח אוטומטית ברגע שיחזור החיבור — אין צורך ללחוץ שוב.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gift is saved and will send automatically once you're back online — no need to tap again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подарок сохранён и отправится автоматически, как только связь вернётся, — нажимать снова не нужно."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الهدية محفوظة وسترسَل تلقائيًا فور عودة الاتصال — لا حاجة للضغط مرة أخرى."
          }
        }
      }
    },
    "המתנה תופיע ברגע שמכשיר יתחבר.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gift will show up as soon as a device connects."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подарок появится, как только устройство подключится."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر الهدية فور اتصال أحد الأجهزة."
          }
        }
      }
    },
    "הנה מה שהוספנו בעדכון האחרון": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here's what we added in the latest update"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вот что мы добавили в последнем обновлении"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إليكم ما أضفناه في التحديث الأخير"
          }
        }
      }
    },
    "הנעילה תחול ברגע שמכשיר יתחבר לילד.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lock will apply as soon as a device connects for your child."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировка вступит в силу, как только устройство ребёнка подключится."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيسري القفل فور اتصال جهاز بالطفل."
          }
        }
      }
    },
    "הנתונים נשארים אצלכם": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data stays with you"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши данные остаются у вас"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بياناتكم تبقى لديكم"
          }
        }
      }
    },
    "הנתונים של כל משפחה מבודדים. אף משפחה אחרת לא יכולה לראות את הילד שלכם.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each family's data is kept separate. No other family can see your child."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные каждой семьи изолированы. Никакая другая семья не может увидеть вашего ребёнка."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات كل عائلة معزولة. لا يمكن لأي عائلة أخرى رؤية طفلكم."
          }
        }
      }
    },
    "הסיסמה קצרה מדי — לפחות 6 תווים": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password is too short — at least 6 characters"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пароль слишком короткий — минимум 6 символов"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمة السر قصيرة جدًا — 6 أحرف على الأقل"
          }
        }
      }
    },
    "הסנכרון אופציונלי. אפשר להמשיך לעבוד מקומית בלי להתחבר.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync is optional. You can keep working locally without signing in."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация необязательна. Можно продолжать работать локально, не входя в аккаунт."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المزامنة اختيارية. يمكنكم متابعة العمل محليًا دون تسجيل الدخول."
          }
        }
      }
    },
    "הסר מכשיר": {
      "localizations": {
