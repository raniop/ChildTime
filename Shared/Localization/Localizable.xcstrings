        }
      }
    },
    "ספרו ל%@ על חג שאתם אוהבים במשפחה — מה אוכלים בו, ומה הסיפור מאחוריו." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احكوا لـ%@ عن عيد تحبّونه في العائلة: ماذا تأكلون فيه، وما القصّة وراءه."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell %@ about a holiday your family loves — what you eat, and the story behind it."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
