    "הוֹרִידוּ קֹדֶם אֶת הַתְּשׁוּבוֹת שֶׁבֶּטַח לֹא נְכוֹנוֹת — וּבַחֲרוּ מִמַּה שֶּׁנִּשְׁאַר." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استبعدوا أولًا الإجابات التي بالتأكيد غير صحيحة — ثم اختاروا من الباقي."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First cross out the answers that are surely wrong — then pick from what's left."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала убери ответы, которые точно неверные, — и выбери из того, что осталось."
          }
        }
      }
    },
    "הזזת השעון במכשיר לא מוסיפה דקות, לא פותחת מחדש פרסים יומיים ולא משאירה אפליקציות פתוחות" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيير ساعة الجهاز لا يضيف دقائق، ولا يعيد فتح الجوائز اليومية، ولا يترك التطبيقات مفتوحة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moving the device clock doesn't add minutes, reopen daily rewards, or leave apps unlocked"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевод часов на устройстве не добавляет минут, не открывает заново ежедневные призы и не оставляет приложения открытыми"
          }
        }
      }
    },
