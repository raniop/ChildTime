            "value": "حدث ما منع الإرسال. حاولوا مرّة أخرى بعد قليل."
          }
        }
      }
    },
    "משימה: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mission: %@"
          }
