          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكواب وملاعق وغرامات ولترات"
          }
        }
      }
    },
    "כבוי": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطفأ"
          }
        }
      }
    },
    "כבוי. הילד לא יאבד זמן גם אם יטעה הרבה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off. Your child won't lose time, even after lots of mistakes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено. Ребёнок не потеряет время, даже если ошибётся много раз."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطفأ. لن يخسر الطفل وقتًا حتى لو أخطأ كثيرًا."
          }
        }
      }
    },
    "כבר יש לך את הפריט הזה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already have this item"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У тебя уже есть этот предмет"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا العنصر موجود لديك بالفعل"
          }
        }
      }
    },
    "כבר קיים חשבון עם האימייל הזה — עברו ללשונית \"כניסה\"": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account with this email already exists — switch to the \"Sign in\" tab"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт с этой почтой уже есть — перейдите на вкладку «Вход»"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد حساب بهذا البريد الإلكتروني — انتقلوا إلى تبويب «تسجيل الدخول»"
          }
        }
      }
    },
    "כדאי לחזק": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs practice"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стоит подтянуть"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج إلى تقوية"
          }
        }
      }
    },
    "כדאי לחזק:": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs practice:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стоит подтянуть:"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج إلى تقوية:"
          }
        }
      }
    },
    "כדי למחוק את החשבון לצמיתות יש להתחבר מחדש ואז לנסות שוב. שאר הנתונים כבר נמחקו.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To permanently delete your account, sign in again and try once more. The rest of your data has already been deleted."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы удалить аккаунт навсегда, войдите заново и попробуйте ещё раз. Остальные данные уже удалены."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لحذف الحساب نهائيًا عليكم تسجيل الدخول من جديد ثم المحاولة مرة أخرى. أما بقية البيانات فقد حُذفت بالفعل."
          }
        }
      }
    },
    "כוכבים (דירוג)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stars (rank)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звёзды (рейтинг)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النجوم (الترتيب)"
          }
        }
      }
    },
    "כוכבים = הדירוג. הם רק עולים ולעולם לא נגמרים — הם מה שקובע את הרמה של הילד/ה ואת המקום בלוח החברים. אי אפשר לבזבז אותם.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stars = rank. They only go up and never run out — they set your child's level and place on the friends board. They can't be spent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звёзды = рейтинг. Они только растут и никогда не заканчиваются — именно они определяют уровень ребёнка и место в списке друзей. Потратить их нельзя."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النجوم = الترتيب. ترتفع دائمًا ولا تنفد أبدًا — وهي التي تحدّد مستوى الطفل/ة ومكانه في لوحة الأصدقاء. ولا يمكن إنفاقها."
          }
        }
      }
    },
    "כולל כל עולם חדש שנוסיף": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Including every new world we add"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включая каждый новый мир, который мы добавим"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بما في ذلك كل عالم جديد نضيفه"
          }
        }
      }
    },
    "כולל ניסיון 7 ימים חינם": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes a 7-day free trial"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включая 7 дней бесплатно"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشمل تجربة مجانية لمدة 7 أيام"
          }
        }
      }
    },
    "כיתה לא הוגדרה — הגדירו": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grade not set — set it"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Класс не задан — задайте"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُحدَّد الصف — حدّدوه"
          }
        }
      }
    },
    "כל %lld תשובות נכונות = %lld דקות משחק": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every %lld correct answers = %lld play minutes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@ = %2$lld мин. игры"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
