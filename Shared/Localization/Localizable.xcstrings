    "הַסֻּכָּה, אַרְבַּעַת הַמִּינִים וְהַהַקָּפוֹת" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السوكاه والأنواع الأربعة والهكافوت"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sukkah, the Four Species, and hakafot"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сукка, четыре вида растений и акафот"
          }
        }
      }
    },
    "הַסְּמָלִים, הַמַּאֲכָלִים וְהַמִּנְהָגִים שֶׁל חַגֵּי תִּשְׁרֵי — בְּשָׁלוֹשׁ רָמוֹת שֶׁמִּתְאִימוֹת אֶת עַצְמָן לַיֶּלֶד, וְעַל כָּל תְּשׁוּבָה נְכוֹנָה מַרְוִיחִים דַּקּוֹת מִשְׂחָק, בְּדִיּוּק כְּמוֹ בְּכָל עוֹלָם." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رموز أعياد تشري وأطعمتها وعاداتها — بثلاثة مستويات تتكيّف مع الطفل، وعن كل إجابة صحيحة يربح دقائق لعب، تمامًا كما في كل عالم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The symbols, foods, and customs of the fall Jewish holidays — in three levels that adapt to your child, and every correct answer earns play minutes, just like in every world."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Символы, блюда и обычаи осенних еврейских праздников — на трёх уровнях, которые подстраиваются под ребёнка, и за каждый правильный ответ начисляются минуты игры, как и в любом мире."
          }
        }
      }
    },
    "הסנכרון אופציונלי. אפשר להמשיך לעבוד מקומית בלי להתחבר." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المزامنة اختيارية. يمكنكم متابعة العمل محليًا دون تسجيل الدخول."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync is optional. You can keep working locally without signing in."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация необязательна. Можно продолжать работать локально, не входя в аккаунт."
          }
        }
      }
    },
