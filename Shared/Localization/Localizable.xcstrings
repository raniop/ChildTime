          }
        }
      }
    },
    "נִשְׂמַח לִשְׁמוֹעַ מָה דַּעְתְּכֶם — מָה לְשַׁפֵּר, מָה חָסֵר, אוֹ כָּל רַעְיוֹן שֶׁיֵּשׁ לָכֶם. כָּל מִלָּה עוֹזֶרֶת לָנוּ לְשַׁפֵּר אֶת טוֹפִי לַיְּלָדִים.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'd love to hear what you think — what to improve, what's missing, or any idea you have. Every word helps us make Tofy better for kids."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будем рады узнать ваше мнение — что улучшить, чего не хватает или любая ваша идея. Каждое слово помогает нам сделать Tofy лучше для детей."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسعدنا أن نسمع رأيكم — ما الذي نحسّنه، وما الناقص، أو أيّ فكرة لديكم. كلّ كلمة تساعدنا على تحسين Tofy للأطفال."
          }
        }
      }
    },
