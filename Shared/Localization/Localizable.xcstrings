            "state": "translated",
            "value": "периметр"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحيط"
          }
        }
      }
    },
    "הַהַזְמָנָה מַמְתִּינָה לְאִשּׁוּר (Ask to Buy)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order waiting for approval (Ask to Buy)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заказ ожидает подтверждения (Ask to Buy)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الطلب بانتظار الموافقة (Ask to Buy)"
          }
        }
      }
    },
    "הַהַזְמָנָה נִשְׁלְחָה לְאִשּׁוּר. הִיא תִּכָּנֵס לְתֹקֶף בָּרֶגַע שֶׁתְּאֻשַּׁר.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your purchase was sent for approval. It'll take effect as soon as it's approved."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка отправлена на подтверждение. Она вступит в силу, как только её одобрят."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُرسل الطلب للموافقة. وسيسري مفعوله فور الموافقة عليه."
          }
        }
      }
    },
    "הַהַזְמָנָה נִשְׁמְרָה! אֶפְשָׁר לְהַזְמִין עוֹד אִימֵיל": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite saved! You can invite another email"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приглашение сохранено! Можно пригласить ещё один адрес"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُفظت الدعوة! يمكنكم دعوة بريد إلكتروني آخر"
          }
        }
      }
    },
    "הַהַתְרָאוֹת כָּבוּיוֹת": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления выключены"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التنبيهات مُطفأة"
          }
        }
      }
    },
    "הַהוֹדָעָה שֶׁלָּכֶם": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше сообщение"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رسالتكم"
          }
        }
      }
    },
    "הַהוֹרֶה הַשֵּׁנִי כְּבָר הִגְדִּיר": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other parent already set up"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Второй родитель уже всё настроил"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوالد الآخر أعدّ الأمر مسبقًا"
          }
        }
      }
    },
    "הַהוֹרֶה הַשֵּׁנִי פָּשׁוּט יִתְחַבֵּר עִם הָאִימֵיל הַזֶּה — וְהַמִּשְׁפָּחָה תְּחַכֶּה לוֹ שָׁם, בְּלִי קוֹדִים.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other parent just signs in with this email — the family will be waiting for them there, no codes needed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Второму родителю достаточно войти с этой почтой — семья будет ждать его там, без всяких кодов."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكفي أن يسجّل الوالد الآخر الدخول بهذا البريد — وستكون العائلة بانتظاره هناك، بلا رموز."
          }
        }
      }
    },
    "הַזְּמַן הַזֶּה שֶׁלְּךָ — רַק אַתָּה פּוֹתֵחַ אוֹתוֹ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This time is yours — only you can unlock it"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это время твоё — открыть его можешь только ты"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الوقت وقتك — أنت وحدك تفتحه"
          }
        }
      }
    },
    "הַזְּמַן נִגְמַר": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time's up"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время вышло"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى الوقت"
          }
        }
      }
    },
    "הַזְּמַן נִגְמַר 🔒": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time's up 🔒"
          }
        },
        "ru": {
