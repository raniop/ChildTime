    "%lld%% מֵהַתְּשׁוּבוֹת שֶׁל %@ נִתְּנוּ אַחֲרֵי שֶׁהַדַּקּוֹת שֶׁל הַיּוֹם כְּבָר נִגְמְרוּ — כְּלוֹמַר סְתָם כִּי %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%% of %@'s answers came after today's minutes had already run out — simply because %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@: %1$lld%% ответов даны уже после того, как минуты на сегодня закончились — просто потому, что %3$@."
          }
        }
      }
    },
