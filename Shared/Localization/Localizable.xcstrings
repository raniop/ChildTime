    "כָּל הַנּוֹשְׂאִים · דַּקּוֹת כְּפוּלוֹת": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All topics · double minutes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все темы · двойные минуты"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل المواضيع · دقائق مضاعفة"
          }
        }
      }
    },
    "כָּל הַשְּׁאָר נִשְׁאָר נָעוּל. בְּתֹם הַזְּמַן הֵן נִנְעָלוֹת בַּחֲזָרָה לְבַד.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything else stays locked. When time's up, they lock again automatically."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё остальное останется закрытым. Когда время выйдет, приложения закроются сами."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وكل ما تبقّى يظل مقفلًا. وعند انتهاء الوقت تُقفل من جديد وحدها."
          }
        }
      }
    },
    "כָּל הַשַּׂחְקָנִים": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All players"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все игроки"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل اللاعبين"
          }
        }
      }
    },
    "כָּל הָעוֹלָמוֹת פְּתוּחִים %@ עַד %@. בְּלִי כַּרְטִיס, לֹא מִתְחַדֵּשׁ. בֵּינְתַיִם תִּרְאוּ מָה %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All worlds are open %@ until %@. No card, no auto-renewal. Meanwhile, see what %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все миры открыты %@ до %@. Без карты, без автопродления. А пока посмотрите, что %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل العوالم مفتوحة %@ حتى %@. بلا بطاقة، وبلا تجديد. في هذه الأثناء شاهدوا ما %@."
          }
        }
      }
    },
    "כָּל הָעוֹלָמוֹת — בְּלִי גְּבוּלוֹת": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every world — no limits"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все миры — без ограничений"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل العوالم — بلا حدود"
          }
        }
      }
    },
    "כָּל הָעוֹלָמוֹת — כּוֹלֵל כָּל עוֹלָם חָדָשׁ שֶׁנּוֹסִיף — הַמִּשְׂחָקִים וְהַמַּטְלוֹת, לְכָל הַיְלָדִים, בְּכָל הַמַּכְשִׁירִים. קוֹנִים פַּעַם אַחַת, כָּאן.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All worlds — including every new world we add — plus games and chores, for all your kids, on all devices. Buy once, here."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все миры — включая каждый новый мир, который мы добавим, — игры и задания, для всех ваших детей, на всех устройствах. Покупка один раз, здесь."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل العوالم — بما فيها كل عالم جديد نضيفه — والألعاب والمهام، لكل الأطفال، على كل الأجهزة. شراء لمرة واحدة، من هنا."
          }
        }
      }
    },
    "כָּל כּוֹכָב מְקַדֵּם אוֹתְךָ לְמַעְלָה! ⭐": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every star moves you up! ⭐"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая звезда поднимает тебя выше! ⭐"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل نجمة ترفعك إلى الأعلى! ⭐"
          }
        }
      }
    },
    "כָּל מַה שֶּׁאַתֶּם לוֹמְדִים מְטַפֵּס בַּדֵּרוּג 🏆": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you learn helps you climb 🏆"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что ты учишь, поднимает тебя в рейтинге 🏆"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما تتعلّمونه يرفعكم في الترتيب 🏆"
          }
        }
      }
    },
    "כָּל מַה שֶּׁתַּרְוִיחַ עַכְשָׁיו נִשְׁמָר לְמָחָר.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you earn now is saved for tomorrow."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что ты заработаешь сейчас, сохранится на завтра."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما تكسبه الآن محفوظ لغدٍ."
          }
        }
      }
    },
    "כָּל שְׁאָר הָאַפְּלִיקַצְיוֹת בַּטֶּלֶפוֹן יִנָּעֲלוּ. הַיֶּלֶד יִלְמַד וִישַׂחֵק בְּטוֹפִי, וְיוּכַל לִפְתּוֹחַ אֶת הָאַפְּלִיקַצְיוֹת הַמּוּתָּרוֹת. לִיצִיאָה — קוֹד הוֹרֶה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All other apps on the phone will be locked. Your child will learn and play in Tofy and can open the allowed apps. Exiting requires the parent code."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все остальные приложения на телефоне будут заблокированы. Ребёнок будет учиться и играть в Tofy и сможет открывать разрешённые приложения. Для выхода нужен родительский код."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُقفل بقية التطبيقات في الهاتف. سيتعلّم الطفل ويلعب في Tofy، ويمكنه فتح التطبيقات المسموح بها. وللخروج — رمز الوالد."
          }
        }
      }
    },
    "כָּל תְּשׁוּבָה נְכוֹנָה בְּטוֹפִי = %@ מִשְׂחָק": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every correct answer in Tofy = %@ of play"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый правильный ответ в Tofy = %@ игры"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل إجابة صحيحة في Tofy = %@ لعب"
          }
        }
      }
    },
    "כָּל תְּשׁוּבָה נְכוֹנָה נוֹתֶנֶת נְקוּדּוֹת. כְּשֶׁהַפַּס מִתְמַלֵּא עוֹלִים רָמָה — וּמְקַבְּלִים 💎 בּוֹנוּס לַחֲנוּת (10 עַל כָּל רָמָה). מֵרָמָה 5 הָאַוָּטָאר מְקַבֵּל מִסְגֶּרֶת בְּרוֹנְזָה, מֵ־10 כֶּסֶף, וּמֵ־20 זָהָב!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every correct answer gives you points. When the bar fills up, you level up — and get bonus 💎 for the shop (10 for every level). At level 5 your avatar gets a bronze frame, at 10 silver, and at 20 gold!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый правильный ответ даёт очки. Когда полоса заполняется, ты переходишь на новый уровень — и получаешь бонусные 💎 для магазина (10 за каждый уровень). С 5-го уровня у аватара бронзовая рамка, с 10-го — серебряная, а с 20-го — золотая!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل إجابة صحيحة تمنح نقاطًا. وعندما يمتلئ الشريط ترتقي مستوى — وتحصل على 💎 إضافية للمتجر (10 عن كل مستوى). ومن المستوى 5 تحصل الشخصية على إطار برونزي، ومن 10 فضي، ومن 20 ذهبي!"
          }
        }
      }
    },
