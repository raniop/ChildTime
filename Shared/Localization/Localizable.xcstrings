      }
    },
    "עדכונים קצרים ואישיים על כל ילד — במה השתפר, איפה התקשה ומה לתרגל.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short, personal updates about each child — where they improved, where they struggled, and what to practice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткие личные обновления о каждом ребёнке — в чём он продвинулся, где было трудно и что стоит потренировать."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديثات قصيرة وشخصية عن كل طفل — في ماذا تحسّن، أين واجه صعوبة وما الذي يستحق التدريب."
          }
        }
      }
    },
