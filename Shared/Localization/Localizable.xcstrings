    "שְׁאֵלוֹת מַתְאִימוֹת לְגִיל — חֶשְׁבּוֹן, עִבְרִית, אַנְגְּלִית, מַדָּע וְעוֹד.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Age-appropriate questions — math, reading, English, science, and more."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вопросы по возрасту — математика, иврит, английский, наука и не только."
