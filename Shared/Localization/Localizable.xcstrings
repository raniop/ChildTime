    "בַּכִּתָּה %lld בָּנִים וְ־%lld בָּנוֹת. מָה הַיַּחַס בֵּין בָּנִים לְבָנוֹת בְּצוּרָה מְצֻמְצֶמֶת?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A class has %lld boys and %lld girls. What is the ratio of boys to girls in simplest form?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В классе %#@count@, а девочек — %2$lld. Каково отношение мальчиков к девочкам в сокращённом виде?"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg мальчик"
                    }
                  },
                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg мальчика"
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg мальчиков"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg мальчика"
                    }
                  }
                }
              }
            }
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الصفّ %lld ولدًا و%lld بنتًا. ما النسبة بين الأولاد والبنات بأبسط صورة؟"
          }
        }
      }
    },
