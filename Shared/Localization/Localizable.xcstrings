    "הפקודה נשלחה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command sent"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда отправлена"
          }
        }
      }
    },
    "הפקודה שמורה ותישלח אוטומטית ברגע שיחזור החיבור — אין צורך ללחוץ שוב.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The command is saved and will send automatically once you're back online — no need to tap again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда сохранена и отправится автоматически, как только связь вернётся, — нажимать снова не нужно."
          }
        }
      }
    },
    "הפרדה מלאה בין משפחות": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full separation between families"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полное разделение между семьями"
          }
        }
      }
    },
    "הפרטיות של הילד שלכם — קודם כול": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your child's privacy comes first"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватность вашего ребёнка — прежде всего"
          }
        }
      }
    },
    "הצג סיסמה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show password"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать пароль"
          }
        }
      }
    },
    "הצלחה היום": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Success today"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Успех сегодня"
          }
        }
      }
    },
    "הצלילים באפליקציה רכים ומשמשים כפידבק על תשובות נכונות / שגויות. ניתן לכבות אותם לגמרי.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In-app sounds are soft and give feedback on correct / incorrect answers. You can turn them off completely."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звуки в приложении мягкие и служат откликом на верные / неверные ответы. Их можно полностью выключить."
          }
        }
      }
    },
    "הקדישו 10 דקות למשחק משותף — זו דרך נהדרת לראות איך %@ %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend 10 minutes playing together — it's a great way to see how %@ %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уделите 10 минут совместной игре — это отличный способ увидеть, как %@ %@."
          }
        }
      }
    },
    "הקדישו 10 דקות לקריאת מילים באנגלית יחד.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend 10 minutes reading English words together."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уделите 10 минут чтению английских слов вместе."
          }
        }
      }
    },
    "הקוד חייב להיות בדיוק 4 ספרות": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code must be exactly 4 digits"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код должен состоять ровно из 4 цифр"
          }
        }
      }
    },
    "הקוד נשמר מוצפן (hash) במכשיר ולא בטקסט גלוי.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code is stored encrypted (hashed) on the device, never in plain text."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код хранится на устройстве в зашифрованном виде (хеш), а не открытым текстом."
          }
        }
      }
    },
    "הקוד פג תוקף": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code has expired"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия кода истёк"
          }
        }
      }
    },
    "הקוד שהילד הגדיר לפתיחת זמן משחק יימחק. הילד יוכל להגדיר קוד חדש מהמכשיר שלו. שימושי כשהקוד נשכח.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code your child set for unlocking play time will be deleted. Your child can set a new code from their device. Useful when the code is forgotten."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код, который ребёнок задал для открытия игрового времени, будет удалён. Ребёнок сможет задать новый код со своего устройства. Удобно, когда код забыт."
          }
        }
      }
    },
    "הקודים לא תואמים": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codes don't match"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коды не совпадают"
          }
        }
      }
    },
    "הקלד קוד בן 4 ספרות": {
