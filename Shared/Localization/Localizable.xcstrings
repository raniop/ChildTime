    "טופי חוזרת לכאן לבד" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توفي يعيدك إلى هنا تلقائيًا"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tofy brings you back here by itself"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тофи сама вернёт вас сюда"
          }
        }
      }
    },
    "טופי טיים והזמן ש%@ מרוויח נשארים חינם תמיד. מה שנסגר: העולמות, המשחקים, הזירה והמטלות." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tofy Time والدقائق التي يكسبها %@ تبقى مجّانيّة دائمًا. ما يُقفَل: العوالم والألعاب والحلبة والمهامّ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tofy Time and the minutes %@ earns stay free forever. What locks: the worlds, games, arena, and chores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tofy Time и минуты, которые %@ зарабатывает, навсегда остаются бесплатными. Закрывается вот что: миры, игры, арена и дела по дому."
          }
        }
      }
    },
