    "בַּחֲרוּ אֶת הַפְּרוֹפִיל שֶׁלָּכֶם" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختاروا ملفّكم الشخصي"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose your profile"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите свой профиль"
          }
        }
      }
    },
    "בַּחֲרוּ אֶת הָאַפְּלִיקַצְיוֹת שֶׁיִּהְיוּ נְעוּלוֹת בַּמַּכְשִׁיר הַזֶּה — עַד שֶׁהַיֶּלֶד מַרְוִיחַ זְמַן מָסָךְ בְּטוֹפִי. אֶפְשָׁר לְשַׁנּוֹת בְּכָל עֵת בְּהַגְדָּרוֹת הוֹרֶה." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختاروا التطبيقات التي ستكون مقفلة على هذا الجهاز — حتى يكسب الطفل وقت شاشة في Tofy. يمكن تغيير ذلك في أيّ وقت من إعدادات الوالد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the apps that will be locked on this device — until your child earns screen time in Tofy. You can change this anytime in parent settings."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите приложения, которые будут заблокированы на этом устройстве — пока ребёнок не заработает экранное время в Tofy. Изменить можно в любой момент в родительских настройках."
          }
        }
      }
    },
    "בַּחֲרוּ אֶת הָאַפְלִיקַצְיוֹת שֶׁיִּפָּתְחוּ עַכְשָׁו, וְאַחַר כָּךְ אֶת מֶשֶׁךְ הַזְּמַן." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختاروا التطبيقات التي ستُفتح الآن، ثمّ مدّة الوقت."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the apps to unlock now, then the duration."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите приложения, которые откроются сейчас, а затем — длительность."
          }
        }
      }
    },
