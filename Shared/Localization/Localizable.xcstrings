          "stringUnit": {
            "state": "translated",
            "value": "Что-то пошло не так при входе — попробуйте ещё раз через минуту"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ ما في تسجيل الدخول — حاولوا مرّة أخرى بعد قليل"
          }
        }
      }
    },
    "משהו חסם את השליחה. נסו שוב עוד רגע.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something blocked sending. Try again in a moment."
