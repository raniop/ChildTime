          }
        }
      }
    },
    "אשר Family Controls": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve Family Controls"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердить Family Controls"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموافقة على Family Controls"
          }
        }
      }
    },
    "א׳": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1-й"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأول"
          }
        }
      }
    },
    "ב\"טופי טיים\" המערכת בונה לכל ילד פיד אישי: 80%% מהנושאים שהוא אוהב ו-20%% תחומים חדשים לגילוי. הפיד משתפר אחרי כל שאלה. כל %lld שאלות הילד מרוויח סיבוב חינם בגלגל המזל.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In \"Tofy Time\", the app builds a personal feed for each child: 80%% topics they love and 20%% new areas to discover. The feed gets better after every question. Every %lld questions, your child earns a free spin on the lucky wheel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Tofy Time» система строит каждому ребёнку личную ленту: 80%% тем, которые он любит, и 20%% новых областей для открытий. Лента улучшается после каждого вопроса. За %#@count@ ребёнок получает бесплатное вращение колеса удачи."
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "каждый %arg вопрос"
                    }
                  },
                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "каждые %arg вопроса"
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "каждые %arg вопросов"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "каждые %arg вопроса"
                    }
                  }
                }
              }
            }
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في «Tofy Time» يبني النظام لكل طفل خلاصة شخصية: 80%% من المواضيع التي يحبّها و20%% مجالات جديدة لاكتشافها. وتتحسّن الخلاصة بعد كل سؤال. وكل %lld أسئلة يربح الطفل دورة مجانية في عجلة الحظ."
          }
        }
      }
    },
    "ב%@ המערכת הורידה מעט את הקושי כדי לבנות ביטחון והצלחה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@, the system eased the difficulty a bit to build confidence and success."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В %@ система немного снизила сложность, чтобы дать уверенность и успех."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في %@ خفّض النظام الصعوبة قليلًا لبناء الثقة والنجاح."
          }
        }
      }
    },
    "בְּאֵיזֶה גַּן?": {
      "localizations": {
        "en": {
