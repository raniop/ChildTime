    "כָּל שְׁאָר הָאַפְּלִיקַצְיוֹת בַּטֶּלֶפוֹן יִנָּעֲלוּ. הַיֶּלֶד יִלְמַד וִישַׂחֵק בְּטוֹפִי, וְיוּכַל לִפְתּוֹחַ אֶת הָאַפְּלִיקַצְיוֹת הַמּוּתָּרוֹת. לִיצִיאָה — קוֹד הוֹרֶה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All other apps on the phone will be locked. Your child will learn and play in Tofy and can open the allowed apps. Exiting requires the parent code."
          }
        }
      }
    },
    "כָּל תְּשׁוּבָה נְכוֹנָה בְּטוֹפִי = %@ מִשְׂחָק": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every correct answer in Tofy = %@ of play"
          }
        }
      }
    },
    "כָּל תְּשׁוּבָה נְכוֹנָה נוֹתֶנֶת נְקוּדּוֹת. כְּשֶׁהַפַּס מִתְמַלֵּא עוֹלִים רָמָה — וּמְקַבְּלִים 💎 בּוֹנוּס לַחֲנוּת (10 עַל כָּל רָמָה). מֵרָמָה 5 הָאַוָּטָאר מְקַבֵּל מִסְגֶּרֶת בְּרוֹנְזָה, מֵ־10 כֶּסֶף, וּמֵ־20 זָהָב!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every correct answer gives you points. When the bar fills up, you level up — and get bonus 💎 for the shop (10 for every level). At level 5 your avatar gets a bronze frame, at 10 silver, and at 20 gold!"
          }
        }
      }
    },
