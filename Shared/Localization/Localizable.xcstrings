    "מֵאַיִן מַגִּיעִים חָלָב, לֶחֶם, דְּבַשׁ וְשׁוֹקוֹלָד": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where milk, bread, honey, and chocolate come from"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откуда берутся молоко, хлеб, мёд и шоколад"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من أين يأتي الحليب والخبز والعسل والشوكولاتة"
          }
        }
      }
    },
    "מֵאַיִן מַגִּיעַ אֹכֶל, מְדִידוֹת וּמַתְכּוֹנִים בְּחֶשְׁבּוֹן": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where food comes from, measuring, and recipe math"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откуда берётся еда, измерения и рецепты в математике"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من أين يأتي الطعام، والقياسات، وحساب الوصفات"
          }
        }
      }
    },
    "מֵאַיִן מַגִּיעַ אֹכֶל, מְדִידוֹת וּמַתְכּוֹנִים בְּחֶשְׁבּוֹן — בְּשָׁלוֹשׁ רָמוֹת שֶׁמִּתְאִימוֹת אֶת עַצְמָן לַיֶּלֶד, וְעַל כָּל תְּשׁוּבָה נְכוֹנָה מַרְוִיחִים דַּקּוֹת מִשְׂחָק, בְּדִיּוּק כְּמוֹ בְּכָל עוֹלָם.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where food comes from, measuring, and recipe math — in three levels that adapt to your child, and every correct answer earns play minutes, just like in every world."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откуда берётся еда, измерения и рецепты в математике — на трёх уровнях, которые подстраиваются под ребёнка, и за каждый правильный ответ начисляются игровые минуты, как и в любом мире."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من أين يأتي الطعام، والقياسات، وحساب الوصفات — بثلاثة مستويات تتكيّف مع الطفل، وعن كل إجابة صحيحة تُربَح دقائق لعب، تمامًا كما في كل عالم."
          }
        }
      }
    },
    "מֵידָע נוֹסָף ←": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More info →"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подробнее →"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مزيد من المعلومات ←"
          }
        }
      }
    },
    "מֵעַכְשָׁיו %@ יְקַבֵּל שְׁאֵלוֹת בְּרָמָה %@ יוֹתֵר בְּ%@. תָּמִיד אֶפְשָׁר לְשַׁנּוֹת בַּהַגְדָּרוֹת.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From now on, %@ will get questions at the %@ level in %@. You can always change this in Settings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь %@ будет получать вопросы на %@ уровне в %@. Это всегда можно изменить в настройках."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من الآن فصاعدًا سيحصل %@ على أسئلة بمستوى %@ في %@. يمكن تغيير ذلك دائمًا من الإعدادات."
          }
        }
      }
    },
    "מֵעַכְשָׁיו שְׁנֵיכֶם רוֹאִים אֶת אוֹתָם הַיְּלָדִים.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You now both see the same kids."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь вы оба видите одних и тех же детей."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من الآن يرى كلاكما الأطفال أنفسهم."
          }
        }
      }
    },
