    "שְׁאָר הַהַגְדָּרוֹת — פְּרָסִים, דּוּחוֹת, רָמַת קוֹשִׁי וְהַתְרָאוֹת — מְנוּהֲלוֹת בְּמַכְשִׁיר הַהוֹרֶה." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بقيّة الإعدادات — الجوائز والتقارير ومستوى الصعوبة والإشعارات — تُدار من جهاز الوالد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All other settings — rewards, reports, difficulty, and notifications — are managed on the parent device."
