          }
        }
      }
    },
    "ילד שהאפליקציה שלו ברוסית מקבל את ההתראות ברוסית, וההורה בעברית — באותה משפחה, על אותו אירוע" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الطفل الذي تطبيقه بالروسية يتلقّى الإشعارات بالروسية، والوالد بالعبرية — في العائلة نفسها وعن الحدث نفسه"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A child whose app is in Russian gets Russian notifications, and the parent gets Hebrew — same family, same event"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ребёнок, у которого приложение на русском, получает уведомления на русском, а родитель — на иврите. Одна семья, одно событие"
          }
        }
      }
    },
