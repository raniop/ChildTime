    "הִגַּעְתָּ לְכָל הַדַּקּוֹת שֶׁל הַיּוֹם.\nנִתְרָאֶה מָחָר בַּבֹּקֶר" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصلتَ إلى كل دقائق اليوم.\nنلتقي غدًا صباحًا"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've used all of today's minutes.\nSee you tomorrow morning"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты использовал все минуты на сегодня.\nУвидимся завтра утром"
          }
        }
      }
    },
    "הִגַּעַתְּ לְכָל הַדַּקּוֹת שֶׁל הַיּוֹם.\nנִתְרָאֶה מָחָר בַּבֹּקֶר" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصلتِ إلى كل دقائق اليوم.\nنلتقي غدًا صباحًا"
