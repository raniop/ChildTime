    "טוֹפִי טַיים" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tofy Time"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tofy Time"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tofy Time"
          }
        }
      }
    },
    "טוֹפִי טַיים וְהַזְּמַן שֶׁ%@ מַרְוִיחַ נִשְׁאָרִים חִנָּם תָּמִיד. מָה שֶׁנִּסְגָּר: הָעוֹלָמוֹת, הַמִּשְׂחָקִים, הַזִּירָה וְהַמַּטְלוֹת." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tofy Time والدقائق التي يكسبها %@ تبقى مجّانيّة دائمًا. ما يُقفَل: العوالم والألعاب والحلبة والمهامّ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tofy Time and the minutes %@ earns stay free forever. What locks: the worlds, games, arena, and chores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tofy Time и минуты, которые %@ зарабатывает, навсегда остаются бесплатными. Закрывается вот что: миры, игры, арена и дела по дому."
          }
        }
      }
    },
    "טוֹפִי טַיים וְהַזְּמַן שֶׁ%@ מַרְוִיחָה נִשְׁאָרִים חִנָּם תָּמִיד. מָה שֶׁנִּסְגָּר: הָעוֹלָמוֹת, הַמִּשְׂחָקִים, הַזִּירָה וְהַמַּטְלוֹת." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tofy Time والدقائق التي تكسبها %@ تبقى مجّانيّة دائمًا. ما يُقفَل: العوالم والألعاب والحلبة والمهامّ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tofy Time and the minutes %@ earns stay free forever. What locks: the worlds, games, arena, and chores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tofy Time и минуты, которые %@ зарабатывает, навсегда остаются бесплатными. Закрывается вот что: миры, игры, арена и дела по дому."
          }
        }
      }
    },
    "טוֹפִי טַיים — קָדִימָה! 🧠" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tofy Time — هيّا بنا! 🧠"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tofy Time — let's go! 🧠"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tofy Time — вперёд! 🧠"
          }
        }
      }
    },
    "טוֹפִי מְנַהֵל עַכְשָׁו אֶת הַנְּעִילָה. כְּדֵי שֶׁשּׁוּם דָּבָר לֹא יִתְנַגֵּשׁ, בְּ\"הגדרות\" ← \"זמן מסך\":" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tofy يدير القفل الآن. كي لا يتعارض شيء، في «الإعدادات» ← «مدة استخدام الجهاز»:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tofy runs the lock now. So nothing clashes, in \"Settings\" → \"Screen Time\":"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теперь блокировкой управляет Tofy. Чтобы ничего не конфликтовало, в «Настройки» → «Экранное время»:"
          }
        }
      }
    },
    "טוֹפִי מְנַהֵל עַכְשָׁו אֶת הַנְּעִילָה. כְּדֵי שֶׁשּׁוּם דָּבָר לֹא יִתְנַגֵּשׁ, בְּהַגְדָּרוֹת ← זְמַן מָסָךְ:" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tofy يدير القفل الآن. كي لا يتعارض شيء، في الإعدادات ← مدة استخدام الجهاز:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tofy runs the lock now. So nothing clashes, in Settings → Screen Time:"
