      }
    },
    "יַבָּשׁוֹת, חַיּוֹת בְּסַכָּנָה וְשִׂיאִים — בְּשָׁלוֹשׁ רָמוֹת שֶׁמִּתְאִימוֹת אֶת עַצְמָן לַיֶּלֶד, וְעַל כָּל תְּשׁוּבָה נְכוֹנָה מַרְוִיחִים דַּקּוֹת מִשְׂחָק, בְּדִיּוּק כְּמוֹ בְּכָל עוֹלָם." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القارّات والحيوانات المهدّدة بالانقراض والأرقام القياسيّة — بثلاثة مستويات تتكيّف مع الطفل، وكل إجابة صحيحة تكسب دقائق لعب، تمامًا كما في كل عالم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continents, endangered animals, and record-breakers — in three levels that adapt to your child, and every correct answer earns play minutes, just like in every world."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Континенты, животные под угрозой и рекордсмены — в трёх уровнях, которые подстраиваются под ребёнка, и за каждый правильный ответ начисляются игровые минуты, как и в любом мире."
          }
        }
      }
    },
    "יַהֲלוֹמִים" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ألماس"
          }
        },
        "en" : {
