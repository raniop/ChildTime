          }
        }
      }
    },
    "🔺 מְשֻׁלָּשׁ שֶׁבָּסִיסוֹ %lld ס\"מ וְהַגֹּבַהּ אֵלָיו %lld ס\"מ. מָה הַשֶּׁטַח שֶׁלּוֹ?": {
      "localizations": {
        "en": {
