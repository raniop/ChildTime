    "בטלפון של %@ יופיע אישור מיקום, והוא ידע שהמיקום שלו גלוי לכם." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيظهر على هاتف %@ طلب إذن الموقع، وسيعرف أنكم ترون موقعه."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
