      }
    },
    "ברוכים הבאים, %@! 👋\nאיך קוראים למשפחה?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أهلًا بكم، %@! 👋\nما اسم العائلة؟"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome, %@! 👋\nWhat's the family called?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добро пожаловать, %@! 👋\nКак называется семья?"
          }
        }
      }
    },
    "בריכה" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المسبح"
          }
        },
        "en" : {
