    "אפשר לדלג ולחבר את המכשיר אחר כך — מהמסך הראשי." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن التخطّي وربط الجهاز لاحقًا — من الشاشة الرئيسية."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can skip this and connect the device later — from the home screen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно пропустить и подключить устройство позже — с главного экрана."
          }
        }
      }
    },
    "אפשר להשאיר את כל העולמות פתוחים" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنكم إبقاء كل العوالم مفتوحة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can keep every world open"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все миры можно оставить открытыми"
          }
        }
      }
    },
    "אפשר לייצא את כל הנתונים או למחוק אותם לחלוטין בכל רגע, מתוך הגדרות ההורה." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن تصدير كل البيانات أو حذفها نهائيًا في أي لحظة، من إعدادات الوالد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can export all data or delete it completely at any time from parent settings."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все данные можно экспортировать или полностью удалить в любой момент в настройках родителя."
          }
        }
      }
    },
    "אפשר לכבות את זה בכל רגע בהגדרות ← נגישות ← טופי. הגדרות המכשיר נפתחות לילד רק עם קוד ההורה." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن إيقاف ذلك في أي وقت من الإعدادات ← إمكانية الوصول ← Tofy. على جهاز الطفل تُفتح الإعدادات برمز الوالدين فقط."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can turn this off at any time in Settings → Accessibility → Tofy. On the child's device, Settings opens only with the parent code."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это можно выключить в любой момент: Настройки → Специальные возможности → Tofy. На устройстве ребёнка настройки открываются только с родительским кодом."
          }
        }
      }
    },
    "אפשר לכבות בכל רגע, והמיקום השמור נמחק מיד." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن إيقافه في أي لحظة، ويُحذف الموقع المحفوظ فورًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can turn it off anytime, and the saved location is deleted right away."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно выключить в любой момент, и сохранённое местоположение сразу удалится."
          }
        }
      }
    },
    "אפשר לסגור — אם האישור יגיע אחר כך, תקבלו התראה ברגע שהמכשיר יינעל." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن الإغلاق — إذا وصل التأكيد لاحقًا، فسيصلكم إشعار فور قفل الجهاز."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can close this — if the confirmation comes later, you'll get a notification as soon as the device locks."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно закрыть — если подтверждение придёт позже, вы получите уведомление, как только устройство заблокируется."
          }
        }
      }
    },
    "אפשר לסגור — המתנה שמורה בענן, ו%@ אותה מכל מכשיר, מתי שירצו." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن الإغلاق — الهدية محفوظة في السحابة، و%@ من أي جهاز، متى شاؤوا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can close this — the gift is saved in the cloud, and %@ it from any device, whenever they like."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно закрыть — подарок сохранён в облаке, и %@ его с любого устройства, когда захочет."
          }
        }
      }
    },
    "אפשר לראות את זה שוב בכל רגע: הגדרות ← מה חדש" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنكم مشاهدة هذا مجددًا في أي وقت: الإعدادات ← ما الجديد"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can watch this again any time: Settings → What's new"
