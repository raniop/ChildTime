    "עֲנֵה נָכוֹן עַל %lld שְׁאֵלוֹת הַיּוֹם וְזָכֵה בִּ-%lld 💎!\nכָּל יוֹם רָצוּף שֶׁמְּשַׂחֲקִים — הַפְּרָס גָּדֵל. 🔥" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أجب إجابة صحيحة عن %lld أسئلة اليوم واربح %lld 💎!\nكلّ يوم متتالٍ تلعب فيه — تكبر الجائزة. 🔥"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get %lld questions right today and win %lld 💎!\nEvery day in a row you play, the prize gets bigger. 🔥"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответь правильно на %#@count@ сегодня и получи %2$lld 💎!\nКаждый день подряд, когда играешь, приз растёт. 🔥"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
