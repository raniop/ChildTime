    "הַיֶּלֶד לוֹמֵד וּמְשַׂחֵק" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طفلك يتعلّم ويلعب"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your child learns and plays"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ребёнок учится и играет"
          }
        }
      }
    },
    "הילד מזין אותו כדי לפתוח את הדקות שצבר" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُدخله الطفل ليفتح الدقائق التي جمعها"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your child enters it to unlock the minutes they've earned"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ребёнок вводит его, чтобы открыть накопленные минуты"
          }
        }
      }
    },
    "הַיֶּלֶד מַכִּיר אֶת הַמִּשְׂחָק הַכִּי אָהוּב בָּעוֹלָם: קְבוּצוֹת וְשַׂחְקָנִים מִיִּשְׂרָאֵל וּמֵהָעוֹלָם, מְדִינוֹת וְתַחֲרֻיּוֹת, חֻקִּים, הִיסְטוֹרְיָה וּקְצָת חֶשְׁבּוֹן שֶׁל תּוֹצָאוֹת — וְעַל כָּל תְּשׁוּבָה נְכוֹנָה מַרְוִיחִים דַּקּוֹת מִשְׂחָק, בְּדִיּוּק כְּמוֹ בְּכָל עוֹלָם." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعرّف طفلك على اللعبة الأحبّ في العالم: فرق ولاعبون من إسرائيل ومن العالم، ودول وبطولات، وقوانين وتاريخ وقليل من حساب النتائج — وعن كل إجابة صحيحة يربح دقائق لعب، تمامًا كما في كل عالم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your child explores the world's favorite game: teams and players from the US and around the world, countries and tournaments, rules, history, and a little score math — and every correct answer earns play minutes, just like in every world."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ребёнок знакомится с самой любимой игрой в мире: команды и игроки из Израиля и со всего мира, страны и турниры, правила, история и немного счёта очков — и за каждый правильный ответ начисляются минуты игры, как и в любом мире."
          }
        }
      }
    },
    "הילד מרוויח %lld דקות משחק על כל %lld תשובות נכונות. אפשר לשנות את שני המספרים. ברירת המחדל: 10 תשובות = 4 דקות." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكسب الطفل %lld دقيقة لعب مقابل كل %lld إجابة صحيحة. يمكنكم تغيير الرقمين. الافتراضي: 10 إجابات = 4 دقائق."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your child earns %lld play minutes for every %lld correct answers. You can change both numbers. Default: 10 answers = 4 minutes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ребёнок получает %1$lld мин. игры за %#@count@. Оба числа можно изменить. По умолчанию: 10 ответов = 4 минуты."
          },
          "substitutions" : {
            "count" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "few" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "каждые %arg правильных ответа"
                    }
                  },
                  "many" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "каждые %arg правильных ответов"
                    }
                  },
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "каждый %arg правильный ответ"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "каждые %arg правильных ответа"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "הַיֶּלֶד מַרְוִיחַ זְמַן כְּדֵי לִפְתּוֹחַ" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طفلك يربح وقتًا ليفتح"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your child earns time to unlock"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ребёнок зарабатывает время, чтобы открыть"
          }
        }
      }
    },
    "הַיֶּלֶד מַרְוִיחַ עַד הַתִּקְרָה הַזּוֹ בִּלְמִידָה. בּוֹנוּסִים מֵהַגַּלְגַּל/קוּפְסָה נִשְׁמָרִים לְמָחָר כְּשֶׁמַּגִּיעִים לַתִּקְרָה." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستطيع طفلك أن يربح حتى هذا الحدّ بالتعلّم. وتُحفظ مكافآت العجلة/الصندوق للغد عند بلوغ الحدّ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your child can earn up to this cap by learning. Wheel/box bonuses are saved for tomorrow once the cap is reached."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ребёнок зарабатывает учёбой до этого потолка. Бонусы с колеса и коробки сохраняются на завтра, когда потолок достигнут."
          }
        }
      }
    },
    "הילד שלי" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طفلي"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My child"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мой ребёнок"
          }
        }
      }
    },
    "הילד/ה והנתונים שלו יימחקו מהמשפחה לצמיתות. תוכלו ליצור אותו מחדש בכל עת. מכשיר שמחובר לילד הזה יתנתק." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُحذف الطفل وبياناته من العائلة نهائيًا. يمكنكم إنشاؤه من جديد في أي وقت. وسيُفصل أي جهاز مرتبط بهذا الطفل."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This child and their data will be permanently deleted from the family. You can create them again anytime. Any device linked to this child will be disconnected."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ребёнок и его данные будут навсегда удалены из семьи. Вы сможете создать его заново в любой момент. Устройство, привязанное к этому ребёнку, отключится."
          }
        }
      }
    },
    "הַיְּלָדִים וְהַהִתְקַדְּמוּת יוֹפִיעוּ תּוֹךְ כַּמָּה שְׁנִיּוֹת." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيظهر الأطفال وتقدّمهم خلال ثوانٍ قليلة."
