            "value" : "Ты достиг дневного максимума"
          }
        }
      }
    },
    "הִגַּעְתָּ לַמַּקְסִימוּם הַיּוֹמִי! %lld דַּקּוֹת נִשְׁמְרוּ לְמָחָר 🎁 (%lld/%lld)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصلتَ إلى الحدّ الأقصى اليومي! حُفظت %lld دقيقة للغد 🎁 (%lld/%lld)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You hit today's max! %lld minutes saved for tomorrow 🎁 (%lld/%lld)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты достиг дневного максимума! %#@count@ на завтра 🎁 (%2$lld/%3$lld)"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
