    "הַמִּשְׂחָקִים, הַזִּירָה, הַמַּטְלוֹת וְכָל הָעוֹלָמוֹת נִפְתָּחִים לְכָל הַמִּשְׁפָּחָה — וְאַבָּא אוֹ אִמָּא פּוֹתְחִים אֶת זֶה מֵהַטֶּלֶפוֹן שֶׁלָּהֶם.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Games, the Arena, chores, and every world open up for the whole family — Mom or Dad unlocks it from their phone."
          }
        }
      }
    },
    "הַמַּכְשִׁיר הַזֶּה הוּא מַכְשִׁיר שֶׁל יֶלֶד. כְּדֵי לְחַבֵּר אוֹתוֹ לַמִּשְׁפָּחָה — בַּקְּשׁוּ מֵהַהוֹרֶה קוֹד יֶלֶד מֵהַדַּשְׁבּוֹרְד.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is a child's device. To connect it to the family, ask the parent for a child code from the dashboard."
          }
        }
      }
    },
    "הַמַּכְשִׁיר הַזֶּה יֵהָפֵךְ לְמַכְשִׁיר הַמִּשְׂחָק שֶׁל הַיֶּלֶד וְיִתְחַבֵּר לַמִּשְׁפָּחָה. אֶפְשָׁר תָּמִיד לְשַׁנּוֹת בַּהַגְדָּרוֹת.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device will become the child's play device and join the family. You can always change this in Settings."
          }
        }
      }
    },
    "הַמַּכְשִׁיר יִנָּעֵל עַכְשָׁיו, וְכָל הַדַּקּוֹת שֶׁנְּתַתֶּם (💝 מַתָּנָה, ❄️ שְׁמוּרוֹת, וְחַלּוֹן פָּתוּחַ שֶׁל מַתָּנָה) יִמָּחֲקוּ. הַדַּקּוֹת שֶׁ%@ מִלְּמִידָה לֹא נִפְגָּעוֹת.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device will lock now, and all the minutes you gave (💝 gift, ❄️ saved, and any open gift window) will be erased. The minutes %@ from learning aren't affected."
          }
        }
      }
    },
    "הַמַּכְשִׁיר יִתְנַתֵּק מֵהַיֶּלֶד וְיַחֲזוֹר לְמַצָּב הַתְחָלָתִי (כְּאִלּוּ הוּתְקַן מֵחָדָשׁ). הַהִתְקַדְּמוּת בֶּעָנָן נִשְׁמֶרֶת — אֶפְשָׁר תָּמִיד לְחַבֵּר שׁוּב בִּסְרִיקַת הַקּוֹד.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device will disconnect from the child and return to its initial state (as if newly installed). Progress stays saved in the cloud — you can always reconnect by scanning the code."
          }
        }
      }
    },
    "הַמַּכְשִׁיר יַחֲזֹר לְמָסַךְ בְּחִירַת הַתַּפְקִיד. הַנְּתוּנִים בֶּעָנָן נִשְׁמָרִים — אֶפְשָׁר לִבְחֹר יֶלֶד וְלִסְרֹק שׁוּב, אוֹ לְהִשָּׁאֵר הוֹרֶה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device will return to the role selection screen. Your data in the cloud is kept — you can pick a child and scan again, or stay a parent."
          }
        }
      }
    },
    "הַמַּכְשִׁיר יַחֲזֹר לְמָסַךְ הַפְּתִיחָה וְיִשְׁאַל שׁוּב מִי מִשְׁתַּמֵּשׁ בּוֹ. הַמִּשְׁפָּחָה וְהַהִתְקַדְּמוּת בֶּעָנָן נִשְׁמָרוֹת.": {
      "localizations": {
        "en": {
          "stringUnit": {
