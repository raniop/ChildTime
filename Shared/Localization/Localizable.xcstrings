    "שחקו יחד במשחקי חשיבה קצרים (סדרות, חידות) — 5 דקות ביום מספיקות.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play short thinking games together (patterns, riddles) — 5 minutes a day is enough."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Играйте вместе в короткие игры на мышление (последовательности, загадки) — 5 минут в день достаточно."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العبوا معًا ألعاب تفكير قصيرة (متسلسلات، ألغاز) — 5 دقائق يوميًّا تكفي."
          }
        }
      }
    },
    "שחקנים, קבוצות, תחרויות ועובדות מפתיעות — בקש מאבא או אמא": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Players, teams, tournaments, and surprising facts — ask Mom or Dad"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игроки, команды, турниры и удивительные факты — попроси маму или папу"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لاعبون، فرق، بطولات وحقائق مفاجئة — اطلب من أبي أو أمّي"
          }
        }
      }
    },
    "שימו שיר ובקשו מ%@ לזהות כלי נגינה או למחוא כפיים בקצב.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
