    "הגדירו לכל ילד כמה זמן הוא יכול להרוויח ביום" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدّدوا لكل طفل كم من الوقت يمكنه أن يكسب في اليوم"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set how much time each child can earn a day"
          }
        },
        "ru" : {
