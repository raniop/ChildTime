    "הילד": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your child"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ребёнок"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الطفل"
          }
        }
      }
    },
    "הילד מזין אותו כדי לפתוח את הדקות שצבר": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your child enters it to unlock the minutes they've earned"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ребёнок вводит его, чтобы открыть накопленные минуты"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُدخله الطفل ليفتح الدقائق التي جمعها"
          }
        }
      }
    },
    "הילד מרוויח %lld דקות משחק על כל %lld תשובות נכונות. אפשר לשנות את שני המספרים. ברירת המחדל: 10 תשובות = 4 דקות.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your child earns %lld play minutes for every %lld correct answers. You can change both numbers. Default: 10 answers = 4 minutes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ребёнок получает %1$lld мин. игры за %#@count@. Оба числа можно изменить. По умолчанию: 10 ответов = 4 минуты."
          },
          "substitutions": {
            "count": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "каждый %arg правильный ответ"
                    }
                  },
                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "каждые %arg правильных ответа"
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "каждые %arg правильных ответов"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "каждые %arg правильных ответа"
                    }
                  }
                }
              }
            }
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكسب الطفل %lld دقيقة لعب مقابل كل %lld إجابة صحيحة. يمكنكم تغيير الرقمين. الافتراضي: 10 إجابات = 4 دقائق."
          }
        }
      }
    },
    "הילד שלי": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My child"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мой ребёнок"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طفلي"
          }
        }
      }
    },
    "הילד/ה והנתונים שלו יימחקו מהמשפחה לצמיתות. תוכלו ליצור אותו מחדש בכל עת. מכשיר שמחובר לילד הזה יתנתק.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This child and their data will be permanently deleted from the family. You can create them again anytime. Any device linked to this child will be disconnected."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ребёнок и его данные будут навсегда удалены из семьи. Вы сможете создать его заново в любой момент. Устройство, привязанное к этому ребёнку, отключится."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف الطفل وبياناته من العائلة نهائيًا. يمكنكم إنشاؤه من جديد في أي وقت. وسيُفصل أي جهاز مرتبط بهذا الطفل."
          }
        }
      }
    },
    "הכי בוער 🔥": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On fire 🔥"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ударе 🔥"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأكثر اشتعالًا 🔥"
          }
        }
      }
    },
    "הכינו יחד את שולחן החג ותנו ל%@ להסביר מה מסמל כל מאכל.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the holiday table together and let %@ explain what each food stands for."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Накройте вместе праздничный стол и дайте %@ объяснить, что символизирует каждое блюдо."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حضّروا معًا مائدة العيد ودعوا %@ يشرح ماذا يرمز كل طبق."
          }
        }
      }
    },
    "המון שיפורים שקטים לשמירה על ההתקדמות, הפרטיות והפרסים של הילדים בכל המכשירים": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lots of behind-the-scenes improvements that protect kids' progress, privacy, and rewards on every device"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Множество тихих улучшений, которые берегут прогресс, приватность и призы детей на всех устройствах"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكثير من التحسينات الهادئة التي تحافظ على تقدّم الأطفال وخصوصيتهم وجوائزهم على كل الأجهزة"
          }
        }
      }
    },
    "המחיקה לא נשלחה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removal wasn't sent"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление не отправлено"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُرسل الحذف"
          }
        }
      }
    },
    "המטלות של %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'s chores"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задания %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مهام %@"
          }
        }
      }
    },
    "המכשיר אישר את הנעילה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device confirmed the lock."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство подтвердило блокировку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكّد الجهاز القفل."
          }
        }
      }
    },
    "המכשיר יחזור למצב התחלתי לגמרי — בלי חשבון, בלי קוד הורה, בלי נתונים מקומיים (כאילו הותקן מחדש). המשפחה וההתקדמות בענן נשמרות — התחברות מחדש תשחזר אותן.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device will go back to a completely fresh state — no account, no parent code, no local data (as if reinstalled). Your family and progress in the cloud are kept — signing in again restores them."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство вернётся в полностью исходное состояние — без аккаунта, без родительского кода, без локальных данных (как после переустановки). Семья и прогресс в облаке сохраняются — повторный вход их восстановит."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيعود الجهاز إلى حالته الأولى تمامًا — بلا حساب، وبلا رمز والد، وبلا بيانات محلية (كأنه ثُبّت من جديد). تبقى العائلة والتقدّم محفوظين في السحابة — وتسجيل الدخول من جديد يستعيدهما."
          }
        }
      }
    },
    "המכשיר יחזור למצב התחלתי: מנותק, בלי קוד הורה, בלי נתונים מקומיים. המשפחה וההתקדמות בענן יישמרו — אפשר להתחבר מחדש בכל עת.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device will return to its initial state: signed out, no parent code, no local data. Your family and progress in the cloud are kept — you can sign in again anytime."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство вернётся в исходное состояние: отключено, без родительского кода, без локальных данных. Семья и прогресс в облаке сохранятся — войти снова можно в любой момент."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيعود الجهاز إلى حالته الأولى: غير متصل، بلا رمز والد، بلا بيانات محلية. تبقى العائلة والتقدّم محفوظين في السحابة — ويمكن تسجيل الدخول من جديد في أي وقت."
          }
        }
      }
    },
    "המכשיר יתנתק אוטומטית מהילד ויחזור למצב התחלתי (כאילו הותקן מחדש). ההתקדמות בענן נשמרת — כדי לחבר אותו שוב (או לילד אחר), סרקו בו מחדש את ה-QR של הילד הנכון.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device will automatically disconnect from the child and return to its initial state (as if reinstalled). Progress in the cloud is saved — to connect it again (or to another child), scan the right child's QR code on it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство автоматически отвяжется от ребёнка и вернётся в исходное состояние (как после переустановки). Прогресс в облаке сохраняется — чтобы привязать его снова (или к другому ребёнку), отсканируйте на нём QR-код нужного ребёнка."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُفصل الجهاز تلقائيًا عن الطفل ويعود إلى حالته الأولى (كأنه ثُبّت من جديد). يبقى التقدّم محفوظًا في السحابة — ولربطه من جديد (أو بطفل آخر)، امسحوا عليه رمز QR الخاص بالطفل الصحيح."
          }
        }
      }
    },
    "המכשיר מוגבל (זמן מסך / ניהול ארגוני). בטלו את ההגבלה ונסו שוב.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is restricted (Screen Time / organization management). Remove the restriction and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство ограничено (Экранное время / корпоративное управление). Снимите ограничение и попробуйте снова."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجهاز مقيَّد (وقت الشاشة / إدارة مؤسسية). ألغوا التقييد وحاولوا مرة أخرى."
          }
        }
      }
    },
    "המכשיר של %@ אישר את המחיקה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'s device confirmed the removal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство %@ подтвердило удаление."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكّد جهاز %@ الحذف."
          }
        }
      }
    },
    "המכשיר של %@ לא מחובר כרגע": {
