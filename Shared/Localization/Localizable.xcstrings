          }
        }
      }
    },
    "מַרְוִיחִים יַהֲלוֹמִים עַל תְּשׁוּבוֹת נְכוֹנוֹת, מִמַּתָּנוֹת וּמִגַּלְגַּל הַמַּזָּל — וְקוֹנִים בָּהֶם בַּחֲנוּת.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You earn diamonds for correct answers, gifts, and the lucky wheel — and spend them in the shop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Алмазы можно заработать за правильные ответы, из подарков и на колесе удачи — и потратить их в магазине."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُربَح الألماسات عن الإجابات الصحيحة ومن الهدايا ومن عجلة الحظّ — وتُنفَق في المتجر."
          }
        }
      }
    },
    "מַרְוִיחַ זְמַן מָסָךְ אֲמִתִּי דֶּרֶךְ לְמִידָה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earns real screen time by learning."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарабатывает настоящее экранное время учёбой."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يربح وقت شاشة حقيقيًّا عبر التعلّم."
          }
        }
      }
    },
    "מַתְאִים לִשְׁעוֹן מְעוֹרֵר, מַצְלֵמָה, טֶלֶפוֹן אוֹ אַפְּלִיקַצְיָה לִמּוּדִית שֶׁתָּמִיד מֻתֶּרֶת.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good for an alarm clock, camera, phone, or a learning app that's always allowed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подходит для будильника, камеры, телефона или учебного приложения, которое всегда разрешено."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مناسب لمنبّه أو كاميرا أو هاتف أو تطبيق تعليمي مسموح دائمًا."
          }
        }
      }
    },
