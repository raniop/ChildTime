      }
    },
    "כדי למחוק את החשבון לצמיתות יש להתחבר מחדש ואז לנסות שוב. שאר הנתונים כבר נמחקו." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لحذف الحساب نهائيًا عليكم تسجيل الدخول من جديد ثم المحاولة مرة أخرى. أما بقية البيانات فقد حُذفت بالفعل."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To permanently delete your account, sign in again and try once more. The rest of your data has already been deleted."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы удалить аккаунт навсегда, войдите заново и попробуйте ещё раз. Остальные данные уже удалены."
          }
        }
      }
    },
    "כְּדֵי לִנְעוֹל אֶת הַטֶּלֶפוֹן בְּמַצַּב יֶלֶד צָרִיךְ לְאַשֵּׁר Screen Time בִּשְׁבִיל טוֹפִי." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقفل الهاتف في وضع الطفل، اسمحوا لـ Tofy باستخدام Screen Time."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
