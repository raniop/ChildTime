    "פתחו מפת עולם או גלובוס, ומצאו יחד מדינות ודגלים.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a world map or a globe, and find countries and flags together."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте карту мира или глобус и найдите вместе страны и флаги."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتحوا خريطة العالم أو مجسّمًا أرضيًا، وابحثوا معًا عن الدول والأعلام."
          }
        }
      }
    },
    "פתיחת הגדרות הורה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
