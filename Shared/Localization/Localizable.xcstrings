    "באפל ווטש: מתנת דקות, נעילה וצפצוף לטלפון של כל ילד, ישר מהיד" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على Apple Watch: دقائق هدية وقفل ورنين هاتف كل طفل، مباشرة من معصمك"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On Apple Watch: gift minutes, lock and ring each child's phone, right from your wrist"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На Apple Watch: подарить минуты, заблокировать и позвонить на телефон ребёнка — прямо с руки"
          }
        }
      }
    },
    "בבית" : {
      "localizations" : {
        "ar" : {
