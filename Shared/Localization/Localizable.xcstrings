    },
    "היא תפתח" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هي ستفتح"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "she'll open"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "она откроет"
          }
        }
      }
    },
    "היא תשחק בטלפון שלכם במצב ילד, ותראו בדיוק איך זה נראה אצלה. כדי לצאת — הקוד שלכם." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستلعب على هاتفكم في وضع الطفل، وسترون بالضبط ما تراه. للخروج — رمزكم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She'll play on your phone in Kid Mode, and you'll see exactly what she sees. To leave — your code."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Она поиграет на вашем телефоне в детском режиме, и вы увидите всё, как у неё. Чтобы выйти — ваш код."
          }
        }
      }
    },
    "היום" : {
