    "קֹדֶם הַקּוֹד הַנּוֹכְחִי": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current code first"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала текущий код"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرمز الحاليّ أوّلًا"
          }
        }
      }
    },
    "קבלו עדכון כשהילד מתחיל ומסיים לשחק, פותח רצף, זוכה בגלגל מזל או מגלה תחום חדש — וגם דוח שבועי. ההתראות נשלחות בין המכשירים בבית. \"שלח התראת בדיקה\" שולח התראה אליכם עכשיו כדי לוודא שהכול עובד.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get an update when your child starts and finishes playing, starts a streak, wins on the lucky wheel, or discovers a new area — plus a weekly report. Notifications are sent between the devices at home. \"Send test notification\" sends one to you right now to make sure everything works."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получайте уведомление, когда ребёнок начинает и заканчивает играть, открывает серию, выигрывает в колесе удачи или находит новую тему — а также еженедельный отчёт. Уведомления передаются между устройствами дома. «Отправить тестовое уведомление» пришлёт вам уведомление прямо сейчас, чтобы убедиться, что всё работает."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصلوا على تحديث عندما يبدأ الطفل اللعب وينهيه، أو يفتح سلسلة، أو يفوز في عجلة الحظّ، أو يكتشف مجالًا جديدًا — وكذلك تقرير أسبوعيّ. تُرسَل الإشعارات بين أجهزة البيت. «إرسال إشعار تجريبيّ» يرسل إليكم إشعارًا الآن للتأكّد من أنّ كلّ شيء يعمل."
          }
        }
      }
    },
    "קוֹאָלָה": {
