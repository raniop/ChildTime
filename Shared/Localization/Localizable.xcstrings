            "state": "translated",
            "value": "Расскажите %@ короткую историю о чём-то, что случилось когда-то давно."
          }
        }
      }
    },
    "סריקת קוד": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan code"
          }
        },
        "ru": {
