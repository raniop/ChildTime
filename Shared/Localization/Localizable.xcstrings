      }
    },
    "הִגַּעְתָּ לַמַּקְסִימוּם הַיּוֹמִי" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصلتَ إلى الحدّ الأقصى اليومي"
