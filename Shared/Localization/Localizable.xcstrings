    "חֲשִׁיבָה" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفكير"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thinking"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мышление"
          }
        }
      }
    },
    "חֲשִׁיבָה, סְדָרוֹת, הֶקֵּשִׁים וּתְפִיסָה מֶרְחָבִית" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفكير وتسلسلات واستنتاج وإدراك مكانيّ"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thinking, sequences, inference, and spatial reasoning"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мышление, последовательности, выводы и пространственное восприятие"
          }
        }
      }
    },
    "חֲשִׁיבָה, סְדָרוֹת, הֶקֵּשִׁים וּתְפִיסָה מֶרְחָבִית — בְּשָׁלוֹשׁ רָמוֹת שֶׁמִּתְאִימוֹת אֶת עַצְמָן לַיֶּלֶד, וְעַל כָּל תְּשׁוּבָה נְכוֹנָה מַרְוִיחִים דַּקּוֹת מִשְׂחָק, בְּדִיּוּק כְּמוֹ בְּכָל עוֹלָם." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفكير وتسلسلات واستنتاج وإدراك مكانيّ — بثلاثة مستويات تتكيّف مع الطفل، وكل إجابة صحيحة تكسب دقائق لعب، تمامًا كما في كل عالم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thinking, sequences, inference, and spatial reasoning — in three levels that adapt to your child, and every correct answer earns play minutes, just like in every world."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мышление, последовательности, выводы и пространственное восприятие — в трёх уровнях, которые подстраиваются под ребёнка, и за каждый правильный ответ начисляются игровые минуты, как и в любом мире."
          }
        }
      }
    },
