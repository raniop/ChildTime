        }
      }
    },
    "עֲצָמוֹת, לֵב, נְשִׁימָה וּבְרִיאוּת": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bones, heart, breathing, and health"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кости, сердце, дыхание и здоровье"
          }
        }
      }
    },
    "עֲצָמוֹת, לֵב, נְשִׁימָה וּבְרִיאוּת — בְּשָׁלוֹשׁ רָמוֹת שֶׁמִּתְאִימוֹת אֶת עַצְמָן לַיֶּלֶד, וְעַל כָּל תְּשׁוּבָה נְכוֹנָה מַרְוִיחִים דַּקּוֹת מִשְׂחָק, בְּדִיּוּק כְּמוֹ בְּכָל עוֹלָם.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bones, heart, breathing, and health — in three levels that adapt to your child, and every correct answer earns play minutes, just like in every world."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кости, сердце, дыхание и здоровье — на трёх уровнях, которые подстраиваются под ребёнка, и за каждый правильный ответ начисляются игровые минуты, как и в любом мире."
          }
        }
      }
    },
    "עֲצָמוֹת, שְׁרִירִים וּמִפְרָקִים": {
