          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ в %@. Это стоит отпраздновать."
          }
        }
      }
    },
    "%@ %@ ב-%lld מתוך 7 הימים האחרונים — עקביות יפה!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ on %lld of the last 7 days — nice consistency!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ в %lld из последних 7 дней — отличная регулярность!"
          }
        }
      }
    },
    "%@ %@ בְּ%@ בְּ-%lld נְקֻדּוֹת לְעֻמַּת הַתְּקוּפָה הַקּוֹדֶמֶת.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ in %@ by %lld points compared to the previous period."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ в %@ на %lld пунктов по сравнению с предыдущим периодом."
          }
        }
      }
    },
    "%@ %@ בְּ-%lld יָמִים %@, %lld שְׁאֵלוֹת בְּסַךְ הַכֹּל בְּ-%@ הַצְלָחָה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%4$@, %1$@ %2$@ on %3$lld days — %5$lld questions in total, %6$@ correct."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ в течение %lld дней %@ — всего %lld вопросов, %@ правильных."
