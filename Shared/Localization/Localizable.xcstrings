                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Нужно ещё %lld алмазов. Учись дальше и заработай — или родитель может купить."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Нужно ещё %lld алмаза. Учись дальше и заработай — или родитель может купить."
                }
              }
            }
          }
        },
        "ar": {
          "variations": {
            "plural": {
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تحتاج إلى %lld ألماسة إضافية. واصِل التعلُّم لتربحها — أو يمكن للوالد أن يشتريها."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "تحتاج إلى %lld ألماسة إضافية. واصِل التعلُّم لتربحها — أو يمكن للوالد أن يشتريها."
                }
              },
              "two": {
                "stringUnit": {
