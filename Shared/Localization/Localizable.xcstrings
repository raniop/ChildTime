    },
    "מַרְוִיחִים יַהֲלוֹמִים עַל תְּשׁוּבוֹת נְכוֹנוֹת, מִמַּתָּנוֹת וּמִגַּלְגַּל הַמַּזָּל — וְקוֹנִים בָּהֶם בַּחֲנוּת." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُربَح الألماسات عن الإجابات الصحيحة ومن الهدايا ومن عجلة الحظّ — وتُنفَق في المتجر."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You earn diamonds for correct answers, gifts, and the lucky wheel — and spend them in the shop."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Алмазы можно заработать за правильные ответы, из подарков и на колесе удачи — и потратить их в магазине."
          }
        }
      }
    },
