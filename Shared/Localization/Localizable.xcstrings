    },
    "אַתָּה הַמַּנְהִיג — הַמִּשְׂחָק יִסְתַּיֵּם לְכָל הַחֲבֵרִים.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're the host — the game will end for all your friends."
