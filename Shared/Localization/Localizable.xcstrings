    "הִשְׁלַמְתָּ אֶת הָאֶתְגָּר הַיּוֹם — כָּל הַכָּבוֹד! 🎉\nאֶפְשָׁר לְהַמְשִׁיךְ לְשַׂחֵק וְלִצְבֹּר עוֹד." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنهيتَ تحدّي اليوم — أحسنتَ! 🎉\nيمكنك متابعة اللعب وجمع المزيد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You finished today's challenge — great job! 🎉\nYou can keep playing and earn more."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты прошёл сегодняшнее задание — молодец! 🎉\nМожно играть дальше и копить ещё."
          }
        }
      }
    },
    "הַשֵּׁם מוֹפִיעַ בַּמָּסָךְ הָרָאשִׁי וּבַהוֹדָעוֹת — לְכָל הַהוֹרִים בַּמִּשְׁפָּחָה." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر الاسم في الشاشة الرئيسية وفي الإشعارات — لكل الوالدين في العائلة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The name appears on the home screen and in notifications — for every parent in the family."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя появляется на главном экране и в уведомлениях — для всех родителей в семье."
          }
        }
      }
    },
    "הַשָּׂפָה מְשַׁנָּה גַּם אֶת הַשְּׁאֵלוֹת, לֹא רַק אֶת הַטֶּקְסְטִים. אִם תְּשַׁנּוּ אוֹתָהּ בַּמַּכְשִׁיר שֶׁל הַיֶּלֶד עַצְמוֹ — הַבְּחִירָה הָאַחֲרוֹנָה קוֹבַעַת." : {

    },
    "הַשָּׂפָה מִשְׁתַּנָּה מִיָּד בְּכָל הָאַפְּלִיקַצְיָה: טֶקְסְטִים, כִּוּוּן, הַקְרָאָה וּשְׁאֵלוֹת." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتغيّر اللغة فورًا في التطبيق كلّه: النصوص والاتّجاه والقراءة الصوتية والأسئلة."
          }
