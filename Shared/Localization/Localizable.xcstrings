            "state" : "translated",
            "value" : "Pick a topic and the game begins!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбери тему — и игра начинается!"
          }
        }
      }
    },
    "בַּחֲרוּ קֻבִּיּוֹת שֶׁהַמַּכְפֵּלָה שֶׁלָּהֶן מַגִּיעָה לַיַּעַד" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
