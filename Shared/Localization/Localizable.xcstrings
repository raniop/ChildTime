    },
    "חֲשׁוֹב עַל הַמָּקוֹם — אֵיפֹה הוּא וּמָה יֵשׁ לְיָדוֹ.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Think about the place — where it is and what's near it."
