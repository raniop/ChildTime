    },
    "כְּדֵי לְאַפְשֵׁר מְחִיקַת אַפְּלִיקַצְיוֹת — הַזִּינוּ קוֹד הוֹרֶה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To allow deleting apps, enter the parent code"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы разрешить удаление приложений — введите родительский код"
          }
        }
      }
    },
    "כְּדֵי לִנְעַל אֶת הַטֶּלֶפוֹן בְּמַצַּב יֶלֶד צָרִיךְ לְאַשֵּׁר Screen Time בִּשְׁבִיל טוֹפִי.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locking the phone in kid mode needs Screen Time permission for Tofy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы заблокировать телефон в детском режиме, нужно разрешить Tofy доступ к Screen Time."
          }
        }
      }
    },
    "כְּדֵי לִנְעוֹל אֶת הַטֶּלֶפוֹן בְּמַצַּב יֶלֶד צָרִיךְ לְאַשֵּׁר Screen Time בִּשְׁבִיל טוֹפִי.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To lock the phone in Kid Mode, allow Screen Time for Tofy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы заблокировать телефон в детском режиме, нужно разрешить Tofy доступ к Экранному времени."
          }
        }
      }
    },
    "כְּדֵי לִפְתּוֹחַ אֶת הַמִּנּוּי לַמִּשְׁפָּחָה — הַזִּינוּ אֶת הַקּוֹד": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To start the family subscription, enter the code"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы открыть подписку для семьи — введите код"
          }
        }
      }
    },
    "כְּדֵי לִקְנוֹת יַהֲלוֹמִים — בַּקְּשׁוּ מֵהוֹרֶה לְהַזִּין אֶת הַקּוֹד": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To buy diamonds, ask a parent to enter the code"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы купить алмазы — попросите родителя ввести код"
          }
        }
      }
    },
    "כְּדֵי לִרְכֹּשׁ אֶת הַשְּׁאֵלוֹן — הַזִּינוּ אֶת הַקּוֹד": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To buy this question pack, enter the code"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы купить набор вопросов — введите код"
          }
        }
      }
    },
    "כְּדַאי לִכְלֹל אֶת טוֹפִי עַצְמָהּ, כְּדֵי שֶׁהַיֶּלֶד תָּמִיד יוּכַל לַחֲזֹר אֵלֶיהָ.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include Tofy itself, so your child can always get back to it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стоит включить и саму Tofy, чтобы ребёнок всегда мог вернуться к ней."
          }
        }
      }
    },
    "כְּדַאי לִכְלֹל טֶלֶפוֹן, הוֹדָעוֹת וּמַצְלֵמָה — וְאֶת טוֹפִי עַצְמָהּ.": {
