    "10" : {

    },
    "10 דַּקּוֹת שֶׁל %@ בְּיַחַד, פַּעַם־פַּעֲמַיִם בַּשָּׁבוּעַ. %@ כְּבָר %@ בְּ%@ — יֵשׁ עַל מָה לִבְנוֹת." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10 دقائق من %@ معًا، مرة أو مرتين في الأسبوع. %@ بالفعل %@ في %@ — هناك ما يمكن البناء عليه."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10 minutes of %@ together, once or twice a week. %@ is already %@ in %@ — there's something to build on."
