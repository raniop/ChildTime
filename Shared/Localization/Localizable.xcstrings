        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Семья без названия"
          }
        }
      }
    },
    "משפחה, ילד, מכשיר ונעילה — עם פס התקדמות למעלה, ובטלפון של הילד אישור זמן מסך כבר בהתחלה" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العائلة، الطفل، الجهاز والقفل — مع شريط تقدّم في الأعلى، والموافقة على مدة استخدام الجهاز في هاتف الطفل منذ البداية"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Family, child, device and lock — with a progress bar on top, and Screen Time approved on the child's phone right at the start"
