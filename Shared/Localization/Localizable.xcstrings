    },
    "בשלו יחד מתכון פשוט ותנו ל%@ למדוד ולהכפיל כמויות." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطبخوا معًا وصفة بسيطة ودعوا %@ يقيس الكمّيات ويضاعفها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cook a simple recipe together and let %@ measure and double the amounts."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приготовьте вместе простое блюдо и дайте %@ отмерять и удваивать количества."
          }
        }
      }
    },
    "בשליטה שלכם" : {
      "localizations" : {
        "ar" : {
