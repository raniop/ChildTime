          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لحظة! ✨"
          }
        }
      }
    },
    "רֶגַע, אֵין כָּרֶגַע דַּקּוֹת מַתָּנָה לִפְתֹּחַ 💝": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hmm, there are no gift minutes to unlock right now 💝"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ой, сейчас нет подарочных минут, которые можно открыть 💝"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لحظة، لا توجد الآن دقائق هديّة لفتحها 💝"
          }
        }
      }
    },
    "רֶגַע, הָאִינְטֶרְנֶט קְצָת אִטִּי — נְנַסֶּה שׁוּב? 😊": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oops, the internet is a little slow — let's try again? 😊"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ой, интернет немного медленный — попробуем ещё раз? 😊"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لحظة، الإنترنت بطيء قليلًا — نحاول مرّة أخرى؟ 😊"
          }
        }
      }
    },
    "רֶגַע, לֹא הִצְלַחְנוּ לִפְתֹּחַ עַכְשָׁיו — נְנַסֶּה שׁוּב 😊": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hmm, it didn't open just now — let's try again 😊"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ой, сейчас не получилось открыть — попробуем ещё раз 😊"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لحظة، لم ننجح في الفتح الآن — نحاول مرّة أخرى 😊"
          }
        }
      }
    },
    "רֶמֶז": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hint"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсказка"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلميح"
          }
        }
      }
    },
    "רַמְזוֹר וּבְטִיחוּת בַּדֶּרֶךְ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traffic lights and road safety"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Светофор и безопасность на дороге"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إشارة المرور والسلامة على الطريق"
          }
        }
      }
    },
    "רַעֲנֵן נְתוּנִים בְּכָל הַמַּכְשִׁירִים": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh data on all devices"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновить данные на всех устройствах"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديث البيانات في كلّ الأجهزة"
          }
        }
      }
    },
    "רַק אַפְּלִיקַצְיָה אַחַת אוֹ כַּמָּה (לְמָשָׁל יוּטְיוּבּ). הַשְּׁאָר נְעוּלוֹת.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just one app or a few (for example, YouTube). Everything else stays locked."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только одно приложение или несколько (например, YouTube). Остальные закрыты."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيق واحد فقط أو بضعة تطبيقات (مثلًا يوتيوب). والباقي مقفل."
          }
        }
      }
    },
    "רַק הָעוֹלָם הַזֶּה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just this world"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только этот мир"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا العالم فقط"
          }
        }
      }
    },
    "רַק טוֹפִי — הַקִּישׁוּ לִבְחוֹר עוֹד": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only Tofy — tap to choose more"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только Tofy — нажмите, чтобы выбрать ещё"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Tofy فقط — اضغطوا لاختيار المزيد"
          }
        }
      }
    },
    "רַק מִי שֶׁיּוֹדֵעַ אֶת הַקּוֹד יָכוֹל לִפְתּוֹחַ אֶת דַּקּוֹת הַמִּשְׂחָק שֶׁלְּךָ.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only someone who knows the code can unlock your play minutes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только тот, кто знает код, может открыть твои игровые минуты."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من يعرف الرمز وحده يستطيع فتح دقائق اللعب الخاصّة بك."
          }
        }
      }
    },
    "רַק מָה שֶׁתִּבְחֲרוּ יִשָּׁאֵר פָּתוּחַ בַּמַּכְשִׁיר שֶׁלָּכֶם. כָּל הַשְּׁאָר נִנְעָל.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only what you choose stays open on your device. Everything else is locked."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытым на вашем устройстве останется только то, что вы выберете. Всё остальное закроется."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيبقى مفتوحًا على جهازكم ما تختارونه فقط. وكلّ الباقي يُقفل."
          }
        }
      }
    },
    "רַק שְׁאֵלָה אַחַת כְּדֵי שֶׁנֵּדַע לְאָן לְהַמְשִׁיךְ:": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just one question so we know where to go next:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всего один вопрос, чтобы понять, куда двигаться дальше:"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سؤال واحد فقط لنعرف إلى أين نتابع:"
          }
        }
      }
    },
    "רַק שְׁאֵלוֹת עֲנָק — קָשׁוֹת בִּמְיוּחָד, מִכָּל הַנּוֹשְׂאִים!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only giant questions — extra hard, from every topic!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только гигантские вопросы — самые сложные, из всех тем!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسئلة عملاقة فقط — صعبة بشكل خاصّ، من كلّ المواضيع!"
          }
        }
      }
    },
