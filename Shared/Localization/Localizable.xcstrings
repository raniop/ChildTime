        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تختاروا بعد تطبيقات لحظرها. بدون اختيار لن يحدث شيء عندما يفتح الطفل جهاز iPad."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
