    "כּוֹסוֹת, כַּפּוֹת, גְּרָמִים וְלִיטְרִים" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أكواب وملاعق وغرامات ولترات"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cups, spoons, grams, and liters"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стаканы, ложки, граммы и литры"
          }
        }
      }
    },
    "כאן יופיע כל מה שקורה אצל הילדים: כל התראה ששלחנו לכם, סבב שהסתיים ודקות שהורווחו, מטלה שמחכה לאישור שלכם, דקות מתנה ונעילה מרחוק, הישגים כמו רצף ועליית רמה, מכשיר שהצטרף למשפחה, ותשובה מצוות טופי." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيظهر هنا كل ما يحدث مع أطفالكم: كل إشعار أرسلناه لكم، جولة انتهت والدقائق التي رُبحت فيها، مهمة تنتظر موافقتكم، دقائق هدية وقفل عن بُعد، إنجازات مثل سلسلة إجابات وارتفاع مستوى، جهاز انضم إلى العائلة، وردّ من فريق Tofy."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything happening with your children will show up here: every notification we sent you, a round that ended and the minutes it earned, a chore waiting for your approval, gift minutes and a remote lock, milestones like a streak or a level up, a device that joined the family, and a reply from the Tofy team."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь появится всё, что происходит у детей: каждое отправленное вам уведомление, завершённый раунд и заработанные минуты, дело, которое ждёт вашего подтверждения, подаренные минуты и блокировка на расстоянии, достижения — серия верных ответов и новый уровень, присоединившееся устройство и ответ команды Tofy."
          }
        }
      }
    },
    "כבוי" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مطفأ"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключено"
          }
        }
      }
    },
    "כבוי. הילד לא יאבד זמן גם אם יטעה הרבה." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مطفأ. لن يخسر الطفل وقتًا حتى لو أخطأ كثيرًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off. Your child won't lose time, even after lots of mistakes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключено. Ребёнок не потеряет время, даже если ошибётся много раз."
          }
        }
      }
    },
    "כבויה" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوقف"
          }
