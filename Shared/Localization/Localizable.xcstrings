    "העולם מחכה במסך הראשי של כל ילד, עם סימון \"חדש\"." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العالم بانتظار كل طفل في شاشته الرئيسية، مع علامة «جديد»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The world is waiting on each child's home screen, marked \"New\"."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мир ждёт на главном экране каждого ребёнка, с пометкой «Новое»."
          }
        }
      }
    },
    "העיפרון ליד שם הילד פותח ישר את השם, התמונה והכיתה" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القلم بجانب اسم الطفل يفتح مباشرة الاسم والصورة والصف"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pencil by the child's name opens their name, photo and grade"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карандаш рядом с именем ребёнка сразу открывает имя, фото и класс"
          }
        }
      }
    },
    "הפחתת מאמץ העיניים" : {
