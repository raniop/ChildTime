    "גררו את הידיות כדי לקבוע את הסדר בלוח. הסדר נשמר לכל ההורים במשפחה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the handles to set the order on the board. The order is saved for all parents in the family."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте ручки, чтобы задать порядок на доске. Порядок сохраняется для всех родителей в семье."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحبوا المقابض لتحديد الترتيب في اللوحة. يُحفظ الترتيب لجميع الوالدين في العائلة."
          }
        }
      }
    },
