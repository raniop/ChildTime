          }
        }
      }
    },
    "כָּל הַיַּהֲלוֹמִים שֶׁתִּצְבְּרוּ הַיּוֹם — כְּפוּלִים! 💎×2\nזֶה הַזְּמַן הֲכִי טוֹב לֶאֱסֹף הַרְבֵּה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All the diamonds you earn today are doubled! 💎×2\nIt's the best time to collect lots."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все алмазы, которые ты соберёшь сегодня, — двойные! 💎×2\nСамое время собрать побольше."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل الألماسات التي تجمعها اليوم — مضاعفة! 💎×2\nهذا أفضل وقت لجمع الكثير."
          }
        }
      }
    },
    "כָּל הַכָּבוֹד! נִפְגָּשִׁים מָחָר 🌙": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Great job! See you tomorrow 🌙"
