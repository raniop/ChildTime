          }
        }
      }
    },
    "אֶת הַמִּשְׁפָּחָה בְּטוֹפִי פּוֹתְחִים מֵהַטֶּלֶפוֹן שֶׁל אַבָּא אוֹ אִמָּא — וּמִשָּׁם מְחַבְּרִים גַּם אֶת הַמַּכְשִׁיר הַזֶּה, וּמַתְחִילִים לְשַׂחֵק וּלְהַרְוִיחַ דַּקּוֹת!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
