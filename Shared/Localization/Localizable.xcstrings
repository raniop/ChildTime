            "value" : "Я согласен(на) и подтверждаю как родитель"
          }
        }
      }
    },
    "אעשה את זה אחר כך" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سأفعل ذلك لاحقًا"
