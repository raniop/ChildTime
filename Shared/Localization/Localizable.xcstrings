        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шаг за шагом, с рисунками экранов iPhone: как задать код «Экранного времени» и как удалить Tofy"
          }
        }
      }
    },
    "הסדר של הכרטיסים במסך הבית" : {
