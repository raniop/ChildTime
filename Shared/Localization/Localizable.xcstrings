    "אין משתמש מחובר — סנכרון לא פעיל": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No user signed in — sync is off"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет вошедшего пользователя — синхронизация выключена"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا مستخدم مسجّل الدخول — المزامنة متوقفة"
          }
        }
      }
    },
    "איסוף נתונים מינימלי": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimal data collection"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минимальный сбор данных"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جمع بيانات في حدّه الأدنى"
          }
        }
      }
    },
    "איפה הילד חזק, איפה צריך עזרה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where your child shines, and where they need help"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где ребёнок силён, а где нужна помощь"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أين يتفوّق الطفل، وأين يحتاج إلى مساعدة"
          }
        }
      }
    },
    "אם נפתח חלון בלי רשת, ברגע שהחיבור חוזר האפליקציה מסדרת הכול לבד — ובלי לקחת מהילד דקות שהרוויח": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a window opens without a connection, the app sorts everything out on its own once it's back online — without taking away minutes your child earned"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если окно открылось без сети, то как только связь вернётся, приложение всё исправит само — и не отнимет у ребёнка заработанные минуты"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا فُتحت نافذة بلا شبكة، فما إن يعود الاتصال حتى يرتّب التطبيق كل شيء بنفسه — ودون أن يأخذ من الطفل دقائق ربحها"
          }
        }
      }
    },
    "אמת קוד": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm code"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердить код"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكيد الرمز"
          }
        }
      }
    },
    "אנא הזינו כתובת אימייל תקינה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter a valid email address"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите корректный адрес эл. почты"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرجاء إدخال عنوان بريد إلكتروني صالح"
          }
        }
      }
    },
    "אנחנו אוספים רק את מה שדרוש כדי להציג התקדמות למידה — בלי פרסום מבוסס פרופיל ובלי מכירת נתונים.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We collect only what's needed to show learning progress — no profile-based ads and no selling data."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы собираем только то, что нужно для показа учебного прогресса — без рекламы по профилю и без продажи данных."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نجمع فقط ما يلزم لعرض تقدّم التعلّم — بلا إعلانات مبنية على الملف الشخصي وبلا بيع بيانات."
          }
        }
      }
    },
    "אני מסכים/ה ומאשר/ת כהורה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I agree and consent as a parent"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я согласен(на) и подтверждаю как родитель"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوافق وأُصادق بصفتي والدًا/والدة"
          }
        }
      }
    },
    "אף אחד לא משחק כרגע": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No one is playing right now"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас никто не играет"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا أحد يلعب الآن"
          }
        }
      }
    },
    "אפל לא אישרה את ההרשאה (%@).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple didn't approve the permission (%@)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple не подтвердила разрешение (%@)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تمنح Apple الإذن (%@)."
          }
        }
      }
    },
    "אפליקציה אחרת במכשיר כבר משתמשת ב-Screen Time (אפל מאפשרת אחת בלבד). הסירו אותה מ״הגדרות ← זמן מסך ← אפליקציות עם גישה״, ונסו שוב.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app on this device is already using Screen Time (Apple allows only one). Remove it in Settings → Screen Time → Apps with Access, then try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другое приложение на устройстве уже использует Screen Time (Apple разрешает только одно). Удалите его в «Настройки → Экранное время → Приложения с доступом» и попробуйте снова."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيق آخر على الجهاز يستخدم Screen Time بالفعل (تسمح Apple بواحد فقط). أزيلوه من «الإعدادات ← وقت الشاشة ← التطبيقات ذات الوصول»، ثم حاولوا مرّة أخرى."
          }
        }
      }
    },
    "אפליקציות לחסום": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps to block"
