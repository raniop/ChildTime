          }
        }
      }
    },
    "ב\"טופי טיים\" המערכת בונה לכל ילד פיד אישי: 80%% מהנושאים שהוא אוהב ו-20%% תחומים חדשים לגילוי. הפיד משתפר אחרי כל שאלה. כל %lld שאלות הילד מרוויח סיבוב חינם בגלגל המזל.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In \"Tofy Time\", the app builds a personal feed for each child: 80%% topics they love and 20%% new areas to discover. The feed gets better after every question. Every %lld questions, your child earns a free spin on the lucky wheel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Tofy Time» система строит каждому ребёнку личную ленту: 80%% тем, которые он любит, и 20%% новых областей для открытий. Лента улучшается после каждого вопроса. За каждые %lld вопросов ребёнок получает бесплатное вращение колеса удачи."
          }
        }
      }
    },
    "ב%@ המערכת הורידה מעט את הקושי כדי לבנות ביטחון והצלחה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@, the system eased the difficulty a bit to build confidence and success."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В %@ система немного снизила сложность, чтобы дать уверенность и успех."
          }
        }
      }
    },
    "בְּאֵיזֶה גַּן?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which kindergarten?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В каком детском саду?"
          }
        }
      }
    },
    "בְּאֵיזוֹ כִּתָּה %@?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What grade are %@ in?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В каком классе %@?"
          }
        }
      }
    },
    "בְּאֵיזוֹ כִּתָּה?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which grade?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В каком классе?"
          }
        }
      }
    },
    "בְּדֶרֶךְ כְּלָל מַתְמִיד; לִפְעָמִים מְדַלֵּג עַל שְׁאֵלָה קָשָׁה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usually sticks with it; sometimes skips a hard question."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычно доводит до конца; иногда пропускает трудный вопрос."
          }
        }
      }
    },
    "בְּדוֹק מָה חוֹזֵר אוֹ מִשְׁתַּנֶּה כָּל פַּעַם, וְהַמְשֵׁךְ אֶת הַסֵּדֶר.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check what repeats or changes each time, and continue the pattern."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотри, что повторяется или меняется каждый раз, и продолжи последовательность."
          }
        }
      }
    },
    "בְּחִירַת אַפְּלִיקַצְיוֹת": {
