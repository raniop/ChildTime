            "state": "translated",
            "value": "he learned"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "он выучил"
          }
        }
      }
    },
    "הוא ענה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "he answered"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "он ответил"
          }
        }
      }
    },
    "הוסיפו מטלה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add chore"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить задание"
          }
        }
      }
    },
    "הזזת השעון במכשיר לא מוסיפה דקות, לא פותחת מחדש פרסים יומיים ולא משאירה אפליקציות פתוחות": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving the device clock doesn't add minutes, reopen daily rewards, or leave apps unlocked"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод часов на устройстве не добавляет минут, не открывает заново ежедневные призы и не оставляет приложения открытыми"
          }
        }
      }
    },
    "החודש": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This month"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот месяц"
          }
        }
      }
    },
    "החזירו": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить"
          }
        }
      }
    },
    "החשבון במכשיר לא מאפשר את זה. ודאו שמחוברים עם Apple ID של הורה (לא של ילד).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account on this device doesn't allow this. Make sure you're signed in with a parent's Apple ID (not a child's)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аккаунт на устройстве этого не разрешает. Убедитесь, что вы вошли с Apple ID родителя (не ребёнка)."
          }
        }
      }
    },
    "החשבון הזה הושבת — פנו אלינו לתמיכה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account has been disabled — contact our support"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот аккаунт отключён — обратитесь в нашу поддержку"
          }
        }
      }
    },
    "היא למדה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "she learned"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "она выучила"
          }
        }
      }
    },
    "היא ענתה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "she answered"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "она ответила"
          }
        }
      }
    },
    "היא תפתח": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "she'll open"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "она откроет"
          }
        }
      }
    },
    "היום": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сегодня"
          }
        }
      }
    },
    "היי! אני טופי 💫": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi! I'm Tofy 💫"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привет! Я Tofy 💫"
          }
        }
      }
    },
    "היכנסו כדי להתחיל": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to get started"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите, чтобы начать"
          }
        }
      }
    },
    "הילד": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your child"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ребёнок"
          }
        }
      }
    },
    "הילד מזין אותו כדי לפתוח את הדקות שצבר": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your child enters it to unlock the minutes they've earned"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ребёнок вводит его, чтобы открыть накопленные минуты"
          }
        }
      }
    },
    "הילד מרוויח %lld דקות משחק על כל %lld תשובות נכונות. אפשר לשנות את שני המספרים. ברירת המחדל: 10 תשובות = 4 דקות.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your child earns %lld play minutes for every %lld correct answers. You can change both numbers. Default: 10 answers = 4 minutes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ребёнок получает %lld минут игры за каждые %lld правильных ответов. Оба числа можно изменить. По умолчанию: 10 ответов = 4 минуты."
          }
        }
      }
    },
    "הילד שלי": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My child"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мой ребёнок"
          }
        }
      }
    },
    "הילד/ה והנתונים שלו יימחקו מהמשפחה לצמיתות. תוכלו ליצור אותו מחדש בכל עת. מכשיר שמחובר לילד הזה יתנתק.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This child and their data will be permanently deleted from the family. You can create them again anytime. Any device linked to this child will be disconnected."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ребёнок и его данные будут навсегда удалены из семьи. Вы сможете создать его заново в любой момент. Устройство, привязанное к этому ребёнку, отключится."
          }
        }
      }
    },
    "הכי בוער 🔥": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On fire 🔥"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ударе 🔥"
          }
        }
      }
    },
    "הכינו יחד את שולחן החג ותנו ל%@ להסביר מה מסמל כל מאכל.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the holiday table together and let %@ explain what each food stands for."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Накройте вместе праздничный стол и дайте %@ объяснить, что символизирует каждое блюдо."
          }
        }
      }
    },
    "המון שיפורים שקטים לשמירה על ההתקדמות, הפרטיות והפרסים של הילדים בכל המכשירים": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lots of behind-the-scenes improvements that protect kids' progress, privacy, and rewards on every device"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Множество тихих улучшений, которые берегут прогресс, приватность и призы детей на всех устройствах"
          }
        }
      }
    },
    "המחיקה לא נשלחה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removal wasn't sent"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление не отправлено"
          }
        }
      }
    },
    "המטלות של %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'s chores"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задания %@"
          }
        }
      }
    },
    "המכשיר אישר את הנעילה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device confirmed the lock."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство подтвердило блокировку."
          }
        }
      }
    },
    "המכשיר יחזור למצב התחלתי לגמרי — בלי חשבון, בלי קוד הורה, בלי נתונים מקומיים (כאילו הותקן מחדש). המשפחה וההתקדמות בענן נשמרות — התחברות מחדש תשחזר אותן.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device will go back to a completely fresh state — no account, no parent code, no local data (as if reinstalled). Your family and progress in the cloud are kept — signing in again restores them."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство вернётся в полностью исходное состояние — без аккаунта, без родительского кода, без локальных данных (как после переустановки). Семья и прогресс в облаке сохраняются — повторный вход их восстановит."
          }
        }
      }
    },
    "המכשיר יחזור למצב התחלתי: מנותק, בלי קוד הורה, בלי נתונים מקומיים. המשפחה וההתקדמות בענן יישמרו — אפשר להתחבר מחדש בכל עת.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device will return to its initial state: signed out, no parent code, no local data. Your family and progress in the cloud are kept — you can sign in again anytime."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство вернётся в исходное состояние: отключено, без родительского кода, без локальных данных. Семья и прогресс в облаке сохранятся — войти снова можно в любой момент."
          }
        }
      }
    },
    "המכשיר יתנתק אוטומטית מהילד ויחזור למצב התחלתי (כאילו הותקן מחדש). ההתקדמות בענן נשמרת — כדי לחבר אותו שוב (או לילד אחר), סרקו בו מחדש את ה-QR של הילד הנכון.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device will automatically disconnect from the child and return to its initial state (as if reinstalled). Progress in the cloud is saved — to connect it again (or to another child), scan the right child's QR code on it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство автоматически отвяжется от ребёнка и вернётся в исходное состояние (как после переустановки). Прогресс в облаке сохраняется — чтобы привязать его снова (или к другому ребёнку), отсканируйте на нём QR-код нужного ребёнка."
          }
        }
      }
    },
    "המכשיר מוגבל (זמן מסך / ניהול ארגוני). בטלו את ההגבלה ונסו שוב.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is restricted (Screen Time / organization management). Remove the restriction and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство ограничено (Экранное время / корпоративное управление). Снимите ограничение и попробуйте снова."
          }
        }
      }
    },
    "המכשיר של %@ אישר את המחיקה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'s device confirmed the removal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство %@ подтвердило удаление."
          }
        }
      }
    },
    "המכשיר של %@ לא מחובר כרגע": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'s device isn't connected right now"
          }
        },
        "ru": {
          "stringUnit": {
