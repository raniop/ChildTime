    "%lld%% מֵהַתְּשׁוּבוֹת שֶׁל %@ נִתְּנוּ אַחֲרֵי שֶׁהַדַּקּוֹת שֶׁל הַיּוֹם כְּבָר נִגְמְרוּ — כְּלוֹמַר סְתָם כִּי %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld%% من إجابات %@ جاءت بعد أن انتهت دقائق اليوم — أي لمجرد أن %@."
          }
        },
        "en" : {
          "stringUnit" : {
