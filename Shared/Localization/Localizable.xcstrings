    "כפתור 'עשיתי!' בצבע של הילד/ה, כתר וברכת 'אלוף/אלופה', וקטגוריה נפרדת של 'בוצעו היום'. הפרס תמיד דקות משחק" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زر «فعلتها!» بلون الطفل/ة، وتاج وتهنئة «بطل/بطلة»، وفئة منفصلة باسم «أُنجزت اليوم». والمكافأة دائمًا دقائق لعب"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An 'I did it!' button in your child's color, a crown and a 'Champion!' cheer, and a separate 'Done today' section. The reward is always play minutes"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка «Я сделал!» в цвете ребёнка, корона и поздравление «Чемпион!», а также отдельная категория «Сделано сегодня». Награда — всегда минуты игры"
          }
        }
      }
    },
    "כְּרִישִׁים, לִוְיְתָנִים וְדוֹלְפִינִים" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أسماك القرش والحيتان والدلافين"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharks, whales, and dolphins"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Акулы, киты и дельфины"
          }
        }
      }
    },
    "כְּרִישִׁים, לִוְיְתָנִים, שׁוּנִיּוֹת וּמִי חַי אֵיפֹה" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أسماك القرش والحيتان والشعاب ومن يعيش أين"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharks, whales, reefs, and who lives where"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Акулы, киты, рифы и кто где живёт"
          }
        }
      }
    },
    "כְּרִישִׁים, לִוְיְתָנִים, שׁוּנִיּוֹת וּמִי חַי אֵיפֹה — בְּשָׁלוֹשׁ רָמוֹת שֶׁמִּתְאִימוֹת אֶת עַצְמָן לַיֶּלֶד, וְעַל כָּל תְּשׁוּבָה נְכוֹנָה מַרְוִיחִים דַּקּוֹת מִשְׂחָק, בְּדִיּוּק כְּמוֹ בְּכָל עוֹלָם." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أسماك القرش والحيتان والشِّعاب ومَن يعيش أين — بثلاثة مستويات تتكيّف مع الطفل، وكل إجابة صحيحة تكسب دقائق لعب، تمامًا كما في كل عالم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharks, whales, reefs and who lives where — at three levels that adapt themselves to your child, and every right answer earns play minutes, exactly like every other world."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Акулы, киты, рифы и кто где живёт — три уровня, которые подстраиваются под ребёнка, и за каждый верный ответ начисляются игровые минуты, как и в любом другом мире."
          }
        }
      }
    },
    "כְּרִישִׁים, לִוְיְתָנִים, שׁוּנִיּוֹת, וּמִי חַי אֵיפֹה — בְּשָׁלוֹשׁ רָמוֹת שֶׁמִּתְאִימוֹת אֶת עַצְמָן לַיֶּלֶד, וְעַל כָּל תְּשׁוּבָה נְכוֹנָה מַרְוִיחִים דַּקּוֹת מִשְׂחָק, בְּדִיּוּק כְּמוֹ בְּכָל עוֹלָם." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أسماك القرش، والحيتان، والشِّعاب، ومَن يعيش أين — بثلاثة مستويات تتكيّف مع الطفل، وكل إجابة صحيحة تكسب دقائق لعب، تمامًا كما في كل عالم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharks, whales, reefs, and who lives where — in three levels that adapt to your child, and every correct answer earns play minutes, just like in every world."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Акулы, киты, рифы и кто где живёт — в трёх уровнях, которые подстраиваются под ребёнка, и за каждый правильный ответ начисляются игровые минуты, как и в любом мире."
          }
        }
      }
    },
    "כשהילד פותח דקות באייפון, האייפד מראה שהחלון פתוח שם ומציע להעביר אותו לכאן. אותן דקות לא נפתחות פעמיים, והמגבלה היומית נספרת פעם אחת לכל הילד" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يفتح الطفل دقائق في الآيفون، يُظهر الآيباد أن النافذة مفتوحة هناك ويقترح نقلها إلى هنا. والدقائق نفسها لا تُفتح مرتين، والحد اليومي يُحسب مرة واحدة لكل طفل"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When your child opens minutes on the iPhone, the iPad shows the window is open there and offers to move it over. The same minutes can't be opened twice, and the daily limit counts once per child"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда ребёнок открывает минуты на iPhone, iPad показывает, что окно открыто там, и предлагает перенести его сюда. Одни и те же минуты не открываются дважды, а дневной лимит считается один раз на ребёнка"
          }
        }
      }
    },
    "כְּשֶׁמִּישֶׁהוּ יְבַקֵּשׁ לִהְיוֹת חָבֵר שֶׁלְּךָ — זֶה יוֹפִיעַ כָּאן." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يطلب أحدهم أن يكون صديقك — سيظهر ذلك هنا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When someone asks to be your friend, it'll show up here."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда кто-то захочет добавить тебя в друзья — это появится здесь."
          }
        }
      }
    },
    "כתבו יחד כמה מילים ותרגלו איות נכון." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتبوا معًا بضع كلمات وتدرّبوا على الإملاء الصحيح."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write a few words together and practice spelling them correctly."
