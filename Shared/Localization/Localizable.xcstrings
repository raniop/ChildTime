      }
    },
    "יֵשׁ לְךָ %lld דַּקּוֹת. פּוֹתְחִים זְמַן מִשְׂחָק מִ-%lld דַּקּוֹת — עֲנוּ עַל עוֹד שְׁאֵלוֹת! 😊": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have %lld minutes. Play time opens at %lld minutes — answer a few more questions! 😊"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У тебя %#@count@. Игровое время открывается с %2$lld мин. — ответь ещё на несколько вопросов! 😊"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg минута"
                    }
                  },
                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg минуты"
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg минут"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg минуты"
                    }
                  }
                }
              }
            }
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لديك %lld دقائق. يفتح وقت اللعب من %lld دقائق — أجب عن أسئلة إضافيّة! 😊"
          }
        }
      }
    },
