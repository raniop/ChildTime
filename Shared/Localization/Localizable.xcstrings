    "קוד נוכחי" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرمز الحالي"
          }
        },
        "en" : {
          "stringUnit" : {
