          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключены"
          }
        }
      }
    },
    "כבר ביצירת ילד בוחרים כמה זמן מסך הוא יכול להרוויח ביום — חצי שעה, שעה, שעתיים, בלי הגבלה, או כל מספר דקות שתרצו. ואפשר לשנות בכל רגע בהגדרות של הילד" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند إنشاء الطفل تختارون كم وقت شاشة يمكنه أن يربح يوميًا — نصف ساعة أو ساعة أو ساعتين أو بلا حدود أو أي عدد دقائق تريدونه. ويمكن التغيير في أي وقت من إعدادات الطفل"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right when you create a child, choose how much screen time they can earn per day — half an hour, an hour, two hours, no limit, or any number of minutes you like. You can change it anytime in the child's settings"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже при создании ребёнка выбираете, сколько экранного времени он может заработать за день — полчаса, час, два часа, без ограничений или любое число минут. Изменить можно в любой момент в настройках ребёнка"
          }
        }
      }
    },
    "כבר יש לך את הפריט הזה" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
