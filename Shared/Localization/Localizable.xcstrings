    "רֹאשׁ הַשָּׁנָה, יוֹם כִּפּוּר, סֻכּוֹת וְשִׂמְחַת תּוֹרָה" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رأس السنة العبرية، يوم الغفران، عيد العُرش وسِمحات توراة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rosh Hashanah, Yom Kippur, Sukkot, and Simchat Torah"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рош ха-Шана, Йом Кипур, Суккот и Симхат Тора"
          }
        }
      }
    },
    "רֹב הַמִּשְׁפָּחוֹת מְנַהֲלוֹת אֶת טוֹפִי מֵהַטֶּלֶפוֹן שֶׁל הַהוֹרֶה, וּמְחַבְּרוֹת אֶת הַטַּאבְּלֶט כְּמַכְשִׁיר שֶׁל הַיֶּלֶד." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معظم العائلات تدير توفي من هاتف أحد الوالدين، وتربط الجهاز اللوحي كجهاز للطفل."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most families run Tofy from a parent's phone and connect the tablet as the child's device."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Большинство семей управляют Тофи с телефона родителя, а планшет подключают как устройство ребёнка."
          }
        }
      }
    },
    "רֹב הַמִּשְׁפָּחוֹת מְנַהֲלוֹת אֶת טוֹפִי מֵהָאַיְפוֹן שֶׁל הַהוֹרֶה, וּמְחַבְּרוֹת אֶת הָאַיְפֵּד כְּמַכְשִׁיר שֶׁל הַיֶּלֶד." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معظم العائلات تدير Tofy من iPhone الوالد، وتربط الـ iPad كجهاز الطفل."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most families manage Tofy from the parent's iPhone and connect the iPad as the child's device."
