    "ביקשתם %lld — זה המקסימום שנשאר להיום, עד חצות.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You asked for %lld — that's the most left for today, until midnight."
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Вы запросили %lld — это максимум, что осталось на сегодня, до полуночи."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Вы запросили %lld — это максимум, что осталось на сегодня, до полуночи."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Вы запросили %lld — это максимум, что осталось на сегодня, до полуночи."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Вы запросили %lld — это максимум, что осталось на сегодня, до полуночи."
                }
              }
            }
          }
        },
        "ar": {
          "variations": {
            "plural": {
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "طلبتم %lld — وهذا أقصى ما تبقّى لليوم، حتى منتصف الليل."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "طلبتم %lld — وهذا أقصى ما تبقّى لليوم، حتى منتصف الليل."
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "طلبتم %lld — وهذا أقصى ما تبقّى لليوم، حتى منتصف الليل."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "طلبتم %lld — وهذا أقصى ما تبقّى لليوم، حتى منتصف الليل."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "طلبتم %lld — وهذا أقصى ما تبقّى لليوم، حتى منتصف الليل."
                }
              },
              "other": {
                "stringUnit": {
