      }
    },
    "הָרְכִישָׁה לֹא הֻשְׁלְמָה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase not completed"
          }
        }
      }
    },
    "הָרְצִיפוּת שָׁוָה יוֹתֵר מֵהַכַּמּוּת — גַּם 10 דַּקּוֹת בְּיוֹם שׁוֹמְרוֹת עָלֶיהָ.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consistency matters more than volume — even 10 minutes a day keeps it going."
