    "א׳–ה׳ · 08:00–13:30" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأحد–الخميس · 08:00–13:30"
          }
        },
        "en" : {
