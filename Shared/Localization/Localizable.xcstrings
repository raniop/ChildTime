          }
        }
      }
    },
    "נעולות רק האפליקציות שתבחרו. כל השאר נשארות פתוחות, וגם אפליקציה חדשה שהילד מתקין." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُقفل فقط التطبيقات التي تختارونها. كل ما تبقّى يبقى مفتوحًا، بما في ذلك تطبيق جديد يُنزّله طفلكم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the apps you choose are locked. Everything else stays open, including a new app your child installs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заблокированы только выбранные приложения. Всё остальное остаётся открытым, включая новое приложение, установленное ребёнком."
          }
        }
      }
    },
