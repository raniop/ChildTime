    "%@ יֵצֵא מִלּוּחַ הַחֲבֵרִים שֶׁלְּךָ. תָּמִיד אֶפְשָׁר לְהוֹסִיף שׁוּב." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ سيخرج من لوحة أصدقائك. يمكنك إضافته من جديد في أي وقت."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will leave your friends board. You can always add them back."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ исчезнет с твоей доски друзей. Всегда можно добавить снова."
          }
        }
      }
    },
    "%@ כְּבָר מְחַכֶּה בַּמָּסָךְ הָרָאשִׁי שֶׁל הַיֶּלֶד, עִם סִימוּן \"חָדָשׁ\". בַּפְּתִיחָה הַבָּאָה הוּא יְקַבֵּל הַפְתָּעָה קְטַנָּה 🎁" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ينتظر الطفل على الشاشة الرئيسية، مع علامة «جديد». وفي المرة القادمة التي يفتح فيها التطبيق ستصله مفاجأة صغيرة 🎁"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is already waiting on your child's home screen, marked \"New\". Next time they open Tofy, a little surprise awaits 🎁"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ уже ждёт на главном экране ребёнка с пометкой «Новое». При следующем открытии его ждёт маленький сюрприз 🎁"
          }
        }
      }
    },
    "%@ כְּבָר מְקַבֵּל אֶת הַשְּׁאֵלוֹת הֲכִי מְאַתְגְּרוֹת בְּ%@." : {
