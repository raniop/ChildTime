          }
        }
      }
    },
    "שנה קוד הורה" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيير رمز الوالد"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change parent code"
