    "%@ וְכָל הָעוֹלָמוֹת נִפְתָּחִים עִם טוֹפִי+ לְכָל הַמִּשְׁפָּחָה — וְאַבָּא אוֹ אִמָּא פּוֹתְחִים אֶת זֶה מֵהַטֶּלֶפוֹן שֶׁלָּהֶם.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ and every world open up with Tofy+ for the whole family — Mom or Dad unlocks it from their phone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ и все миры открываются с Tofy+ для всей семьи — а папа или мама открывают это со своего телефона."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ وكل العوالم تُفتح مع Tofy+ لكل العائلة — والأب أو الأم يفتحها من هاتفه."
          }
        }
      }
    },
    "%@ יֵצֵא מִלּוּחַ הַחֲבֵרִים שֶׁלְּךָ. תָּמִיד אֶפְשָׁר לְהוֹסִיף שׁוּב.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will leave your friends board. You can always add them back."
