    "כּוֹכְבֵי לֶכֶת, יָרֵחַ, אַסְטְרוֹנָאוּטִים וְשֶׁמֶשׁ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Planets, the Moon, astronauts, and the Sun"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Планеты, Луна, астронавты и Солнце"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكواكب والقمر ورُوّاد الفضاء والشمس"
          }
        }
      }
    },
    "כּוֹכְבֵי לֶכֶת, יָרֵחַ, אַסְטְרוֹנָאוּטִים וְשֶׁמֶשׁ — בְּשָׁלוֹשׁ רָמוֹת שֶׁמִּתְאִימוֹת אֶת עַצְמָן לַיֶּלֶד, וְעַל כָּל תְּשׁוּבָה נְכוֹנָה מַרְוִיחִים דַּקּוֹת מִשְׂחָק, בְּדִיּוּק כְּמוֹ בְּכָל עוֹלָם.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Planets, the Moon, astronauts, and the Sun — in three levels that adapt to your child, and every correct answer earns play minutes, just like in every world."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Планеты, Луна, астронавты и Солнце — на трёх уровнях, которые сами подстраиваются под ребёнка, и за каждый правильный ответ начисляются минуты игры, как и в любом мире."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكواكب والقمر ورُوّاد الفضاء والشمس — بثلاثة مستويات تتكيّف مع الطفل، وكل إجابة صحيحة تكسب دقائق لعب، تمامًا كما في كل عالم."
          }
        }
      }
    },
    "כּוֹכָבִים": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stars"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звёзды"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نجوم"
          }
        }
      }
    },
    "כּוֹסוֹת, כַּפּוֹת, גְּרָמִים וְלִיטְרִים": {
      "localizations": {
        "en": {
