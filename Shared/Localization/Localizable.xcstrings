    "מֵאֲחוֹרֵי קוֹד הוֹרֶה · Apple ID · הַשְּׁאֵלוֹן נִכְנָס לַיֶּלֶד מִיָּד": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Behind the parent code · Apple ID · the question pack reaches your child right away"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За родительским кодом · Apple ID · набор вопросов попадает к ребёнку сразу"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خلف رمز الوالد · Apple ID · تصل حزمة الأسئلة إلى الطفل فورًا"
          }
        }
      }
    },
    "מֵאֲחוֹרֵי קוֹד הוֹרֶה · Apple ID · הָעוֹלָם נִפְתָּח לַיֶּלֶד מִיָּד · בְּלִי חִדּוּשׁ אוֹטוֹמָטִי": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Behind the parent code · Apple ID · the world unlocks for your child right away · no auto-renewal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За родительским кодом · Apple ID · мир открывается ребёнку сразу · без автопродления"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خلف رمز الوالد · Apple ID · يُفتح العالم للطفل فورًا · بلا تجديد تلقائي"
          }
        }
      }
    },
    "מֵאֲחוֹרֵי קוֹד הוֹרֶה · Apple ID · נִפְתָּח לְכָל הַיְלָדִים בְּכָל הַמַּכְשִׁירִים": {
      "localizations": {
        "en": {
          "stringUnit": {
