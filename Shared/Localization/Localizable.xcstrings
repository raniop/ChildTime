          }
        }
      }
    },
    "הזזת השעון במכשיר לא מוסיפה דקות, לא פותחת מחדש פרסים יומיים ולא משאירה אפליקציות פתוחות": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving the device clock doesn't add minutes, reopen daily rewards, or leave apps unlocked"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод часов на устройстве не добавляет минут, не открывает заново ежедневные призы и не оставляет приложения открытыми"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيير ساعة الجهاز لا يضيف دقائق، ولا يعيد فتح الجوائز اليومية، ولا يترك التطبيقات مفتوحة"
          }
        }
      }
    },
    "החודש": {
      "localizations": {
