    "כָּל הַשְּׁאָר נִשְׁאָר נָעוּל. בְּתֹם הַזְּמַן הֵן נִנְעָלוֹת בַּחֲזָרָה לְבַד." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وكل ما تبقّى يظل مقفلًا. وعند انتهاء الوقت تُقفل من جديد وحدها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything else stays locked. When time's up, they lock again automatically."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё остальное останется закрытым. Когда время выйдет, приложения закроются сами."
          }
        }
      }
    },
    "כָּל הַשְּׁאָר נָעוּל עַד שֶׁמַּרְוִיחִים זְמַן — גַּם אַפְּלִיקַצְיָה שֶׁתֻּתְקַן מָחָר." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل ما تبقّى مقفل حتى يُكتسب الوقت — بما في ذلك تطبيق يُنزّل غدًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
