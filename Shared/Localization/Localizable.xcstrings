    "הָאַיְפֵּד יִתְנַתֵּק מֵחֶשְׁבּוֹן הַהוֹרֶה וְיִתְחַבֵּר כְּמַכְשִׁיר הַמִּשְׂחָק שֶׁל הַיֶּלֶד שֶׁתִּבְחֲרוּ. הַמִּשְׁפָּחָה, הַיְּלָדִים וְהַהִתְקַדְּמוּת נִשְׁמָרִים בֶּעָנָן." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُسجَّل خروج الـ iPad من حساب الوالد ويتصل كجهاز اللعب للطفل الذي تختارونه. العائلة والأطفال وتقدّمهم محفوظة في السحابة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The iPad will sign out of the parent account and connect as the play device of the child you choose. The family, the children and their progress stay saved in the cloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad выйдет из аккаунта родителя и подключится как игровое устройство выбранного ребёнка. Семья, дети и их прогресс сохраняются в облаке."
          }
        }
      }
