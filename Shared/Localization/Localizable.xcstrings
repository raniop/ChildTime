    },
    "קֻבִּיּוֹת שֶׁמַּגִּיעוֹת בְּדִיּוּק לַיַּעַד" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مكعبات تصل إلى الهدف بالضبط"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocks that hit the target exactly"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
